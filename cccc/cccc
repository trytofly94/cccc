#!/bin/bash

# Claude Code Control Center (cccc)
# Interactive dashboard for tmux + Claude Code sessions

# Non-interactive SSH exec (this script's primary transport for `cc new`/`cc kill`/
# `cc json`, per an SSH-only remote-client architecture) gets a minimal PATH that omits
# Homebrew and per-user bin dirs — tmux/claude then silently fail to be found, and
# callers that check `2>/dev/null` (or `if ! tmux ...`) misreport it as a logic
# failure (e.g. `cc new` claims "session already exists" when tmux was actually
# just not on PATH). Make tool resolution independent of the invoking shell's PATH.
for _cc_bindir in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
    [[ ":$PATH:" != *":$_cc_bindir:"* ]] && [ -d "$_cc_bindir" ] && PATH="$PATH:$_cc_bindir"
done
export PATH
unset _cc_bindir

VERSION="4.0.2"
# CONFIG_DIR: the single root every config path derives from (projects.conf,
# settings.conf, session-names/, plugins/, browser-mcp.json — and the webui,
# which cmd_webui launches with --config/--settings built from these). Honors
# the CC_CONFIG_DIR env override so a DEV/test invocation (`cccc-dev`) can be
# pinned to an isolated sandbox and CANNOT touch the real ~/.config/claude-control.
# This is the enforced half of the dev/live split (see ~/.local/share/cccc-live
# frozen copy + cccc-dev wrapper). Default stays the real dir for the live tool.
CONFIG_DIR="${CC_CONFIG_DIR:-$HOME/.config/claude-control}"
# CC_SCRIPT_DIR: resolves to the directory of the REAL (symlink-followed)
# `cccc` script, not just wherever it was invoked from — plain
# `dirname "${BASH_SOURCE[0]}"` does NOT follow symlinks, so a PATH-symlink
# install (`~/.local/bin/cccc -> <repo>/cccc/cccc`, the setup this repo's own dev
# machine uses) would otherwise resolve to ~/.local/bin instead of this
# repo's cccc/ directory. `readlink -f` follows the symlink first; the `||`
# fallback covers `readlink` builds without `-f` support. Exported so
# sourced plugins (e.g. the private GSD companion plugin) can locate
# repo-relative sibling files of their own. NOTE: this only
# resolves correctly for a symlink (or literal in-repo) install — a
# `cp cccc/cccc ~/.local/bin/cccc` copy install (per docs/SETUP.md) has no repo
# to resolve back to, so plugins needing repo-relative sibling files must
# be installed via the symlink method. cmd_webui resolves cc-webui.py the
# same way: only relative to this script, no other fallback.
CC_SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
export CC_SCRIPT_DIR
PROJECTS_FILE="$CONFIG_DIR/projects.conf"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"
# Optional per-category color overrides (groupname|colorname). A SEPARATE file
# so the safety-critical projects.conf format is never touched. Absent = every
# category auto-assigned a hue by order. Edited by the Web UI's color picker.
GROUP_COLORS_FILE="$CONFIG_DIR/group-colors.conf"
CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"
# IDLE_WATCHDOG_PLIST: where sync_idle_watchdog() (see its own section further
# down) looks to decide whether the idle-watchdog daemon is even installed.
# Honors CC_LAUNCH_AGENTS_DIR the same way CONFIG_DIR honors CC_CONFIG_DIR —
# a test sandbox points this at a temp dir so gate 2 (plist must already
# exist) is fully test-controlled, never the real ~/Library/LaunchAgents.
IDLE_WATCHDOG_LABEL="com.user.claude-idle-watchdog"
IDLE_WATCHDOG_PLIST="${CC_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}/${IDLE_WATCHDOG_LABEL}.plist"

# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
NEON='\033[1;33m'
PINK='\033[1;35m'
BOLD='\033[1m'
NC='\033[0m'

# Icons
ICON_WATCHING="🔍"

# ── Design palette (BRAND-05) ────────────────────────────────────────────────
# Truecolor tokens matching the "cccc Final" design (Claude Design project
# 098d2edd). Dark, mono, cyan chips, yellow reserved for "needs attention".
# These are ADDITIVE — the legacy 16-color vars above (RED/GREEN/…) are left
# untouched so every other command's output is byte-stable; only render_logo()
# and the dashboard renderer use the DC_* palette.
#
# 24-bit escapes render the exact hexes on truecolor terminals (Ghostty,
# iTerm2, modern tmux). On terminals that don't advertise truecolor via
# $COLORTERM we fall back to the nearest legacy 16-color code so the dashboard
# still renders sensibly (never raw-bytes / never monochrome-broken).
if [[ "${COLORTERM:-}" =~ ^(truecolor|24bit)$ ]]; then
    DC_TEXT='\033[38;2;230;237;243m'    # #e6edf3 primary text
    DC_MUTE='\033[38;2;125;136;150m'    # #7d8896 secondary / labels / tree
    DC_DIM='\033[38;2;90;100;114m'      # #5a6472 faint / hints
    DC_CYAN='\033[38;2;86;212;221m'     # #56d4dd accent / working
    DC_YELLOW='\033[38;2;255;204;102m'  # #ffcc66 waiting / attention
    DC_GREEN='\033[38;2;86;211;100m'    # #56d364 settings glyph
    DC_BLUE='\033[38;2;88;166;255m'     # #58a6ff links / (C)
    DC_DETACH='\033[38;2;182;194;207m'  # #b6c2cf detached rows
    DC_CHIP='\033[48;2;86;212;221m\033[38;2;14;17;22m'    # cyan chip, dark ink
    DC_BADGE='\033[48;2;255;204;102m\033[38;2;14;17;22m'  # yellow badge, dark ink
else
    DC_TEXT="$WHITE"
    DC_MUTE="$GRAY"
    DC_DIM="$GRAY"
    DC_CYAN="$CYAN"
    DC_YELLOW="$YELLOW"
    DC_GREEN="$GREEN"
    DC_BLUE="$BLUE"
    DC_DETACH="$GRAY"
    DC_CHIP='\033[7;36m'   # reverse cyan
    DC_BADGE='\033[7;33m'  # reverse yellow
fi

# ── Per-category color palette (BRAND-06) ────────────────────────────────────
# Each CATEGORY ([Group] header) gets one hue, shared by every project under it
# on BOTH the letter chip and the title (and the divider name), so categories
# are visually distinct while projects within a category read as one block.
# Session names stay neutral. Hues auto-assign by category order and are
# overridable per category from the Web UI (group-colors.conf). Yellow
# (=attention) and red (=error) are deliberately excluded so a chip can never be
# mistaken for a status signal. PROJ_COLOR_NAMES is the Web-UI-facing name list;
# PROJ_FG (title/name foreground) and PROJ_CHIP (reverse-video chip) are
# parallel arrays indexed the same way.
PROJ_COLOR_NAMES=(cyan green blue pink purple orange teal indigo)
if [[ "${COLORTERM:-}" =~ ^(truecolor|24bit)$ ]]; then
    PROJ_FG=(
        '\033[38;2;86;212;221m' '\033[38;2;86;211;100m' '\033[38;2;88;166;255m' '\033[38;2;255;155;206m'
        '\033[38;2;188;140;255m' '\033[38;2;255;159;86m' '\033[38;2;90;209;176m' '\033[38;2;139;156;255m'
    )
    PROJ_CHIP=(
        '\033[48;2;86;212;221m\033[38;2;14;17;22m' '\033[48;2;86;211;100m\033[38;2;14;17;22m'
        '\033[48;2;88;166;255m\033[38;2;14;17;22m' '\033[48;2;255;155;206m\033[38;2;14;17;22m'
        '\033[48;2;188;140;255m\033[38;2;14;17;22m' '\033[48;2;255;159;86m\033[38;2;14;17;22m'
        '\033[48;2;90;209;176m\033[38;2;14;17;22m' '\033[48;2;139;156;255m\033[38;2;14;17;22m'
    )
else
    PROJ_FG=( "$CYAN" "$GREEN" "$BLUE" "$PINK" "$PINK" "$YELLOW" "$CYAN" "$BLUE" )
    PROJ_CHIP=( '\033[7;36m' '\033[7;32m' '\033[7;34m' '\033[7;35m' '\033[7;35m' '\033[7;33m' '\033[7;36m' '\033[7;34m' )
fi

# ============================================================================
# BRANDING (BRAND-02/03/04)
# ============================================================================

# Statically-embedded ANSI-Shadow "CCCC" logo, copied verbatim from
# .planning/cccc-public-release-brief.md's Nachtrag section — no figlet
# dependency (D-03). Embedded as a quoted heredoc (delimiter 'LOGO', matching
# the existing HELP-banner heredoc convention below) so the raw box-drawing
# bytes are never subject to shell expansion.
#
# render_logo() is a best-effort, print-only helper modeled on
# get_trust_dialog_marker()'s "guard first, silent on suppression, never
# error" shape. It has exactly TWO call sites in this file
# (first_start_wizard() and cmd_about()) — never show_dashboard() or
# interactive_mode()'s render loop — so the logo structurally can never leak
# into the normal dashboard render (D-06).
#
# Suppression (checked BEFORE any print, silent return 0 on any match — D-07):
#   - stdout is not a TTY (`-t 1`, distinct from first_start_wizard()'s own
#     `-t 0` stdin guard — protects scripted/automated callers, e.g. the cccc
#     skill, n8n-cc-ssh, spawn-cc-worker, from raw ANSI escape bytes)
#   - CC_NO_LOGO=1 (set by main()'s top-level --no-logo pre-scan)
#   - CC_SET_SHOW_LOGO=false (persistent settings.conf key)
render_logo() {
    [[ -t 1 ]] || return 0
    [[ "${CC_NO_LOGO:-0}" == "1" ]] && return 0
    [[ "${CC_SET_SHOW_LOGO:-true}" == "false" ]] && return 0

    printf '%b' "$DC_CYAN"
    cat << 'LOGO'
   ______  ______  ______  ______
  / ____/ / ____/ / ____/ / ____/
 / /     / /     / /     / /
/ /___  / /___  / /___  / /___
\____/  \____/  \____/  \____/
LOGO
    printf '%b' "$NC"
    echo
    echo -e "${DC_MUTE}   Claude Code Control Center${NC}"
}

# ============================================================================
# GSD INTEGRATION MODULE
# ============================================================================

# GSD_AVAILABLE default init — Core sets this BEFORE load_plugins() runs so a
# public Core without an optional GSD orchestration plugin (PLUG-06) has a
# well-defined false value. Such a plugin flips this true when it successfully
# loads its GSD module internally; the `ag` GSD-mode guard below (in the
# dashboard command dispatcher) keeps reading it, unchanged.
GSD_AVAILABLE=false

# ============================================================================
# PLUGIN LOADER
# ============================================================================

# IDEMPOTENCY CONTRACT: plugin top-level code runs UP TO TWICE per cc startup
# (a pre-flight safety probe, then the real load) and MUST therefore be
# idempotent — plugins must only DEFINE functions/variables at top level and
# must NOT perform side effects there (no mkdir, no background spawn, no
# trap, no network call, no counter increment). Side-effecting work belongs
# lazily inside hook functions, which run at most once per cc startup.
#
# load_plugins() sources every $PLUGINS_DIR/*.sh file deterministically
# (alphabetical glob order) into THIS shell, fail-safe: a broken,
# non-parseable, or runtime-exit-calling plugin (exit of ANY status,
# including exit 0) must NEVER crash cc startup nor block remaining plugins.
#
# Mechanism, per file, two steps:
#   1. A throwaway subshell PRE-FLIGHT PROBE sources the file and, only if
#      that succeeds, prints an end-of-file CANARY marker. The `&&` joiner
#      (never `;`) between `source` and the marker `printf` means a failed
#      `source` (syntax error, set -e abort) short-circuits BEFORE the
#      marker — leaving both an absent marker and a non-zero probe rc. A
#      top-level `exit N` of ANY status (0 included) kills the SUBSHELL
#      before the marker line is ever reached, so the marker is absent
#      regardless of exit status — this is what catches "exit 0" style
#      guard clauses that a bare rc check would otherwise wave through.
#   2. Only when the probe rc is 0 AND the canary marker is present does the
#      file get real-sourced into this (the current) shell, wrapped in the
#      same set -o save/restore idiom used for the private GSD companion
#      plugin's internal module source call above,
#      applied PER FILE so one plugin's set -e/-u/-o can never leak into
#      sourcing the next plugin or into cc's own shell state.
load_plugins() {
    local _cc_plugins_dir="${CC_PLUGINS_DIR:-$CONFIG_DIR/plugins}"
    [[ -d "$_cc_plugins_dir" ]] || return 0

    local _cc_plugin_file _cc_probe_out _cc_probe_rc _cc_probe_marker
    local _cc_preserved_shellopts _cc_preserved_shopts _cc_preserved_traps
    for _cc_plugin_file in "$_cc_plugins_dir"/*.sh; do
        [[ -f "$_cc_plugin_file" ]] || continue

        # STEP 1 — pre-flight probe in a throwaway subshell. The canary
        # marker is written ONLY if `source` itself completes successfully.
        # stdin is redirected from /dev/null so a plugin whose top-level code
        # contains a blocking read can never hang cc startup.
        _cc_probe_out="$(mktemp)"
        # shellcheck disable=SC1090  # genuinely dynamic plugin path — resolved at runtime, no static location to point to
        ( source "$_cc_plugin_file" </dev/null && printf '%s' '__CC_PROBE_REACHED_END__' ) >"$_cc_probe_out" 2>/dev/null
        _cc_probe_rc=$?
        _cc_probe_marker="$(cat "$_cc_probe_out" 2>/dev/null)"

        # STEP 2 — real-source ONLY when both gates pass.
        if [[ "$_cc_probe_rc" -ne 0 || "$_cc_probe_marker" != *__CC_PROBE_REACHED_END__* ]]; then
            echo "cccc: warning: failed to load plugin '$_cc_plugin_file' (skipped)" >&2
            rm -f "$_cc_probe_out"
            unset _cc_probe_rc _cc_probe_marker _cc_probe_out
            continue
        fi

        rm -f "$_cc_probe_out"
        # Save/restore set -o options, shopt options, and EXIT/ERR/DEBUG/RETURN
        # traps around the real-source so a plugin that flips a shopt
        # (e.g. nullglob) or installs a top-level trap can never permanently
        # alter cc's own shell state. stdin is redirected from /dev/null for
        # the same blocking-read protection as the probe above.
        _cc_preserved_shellopts="$(set +o)"
        _cc_preserved_shopts="$(shopt -p)"
        _cc_preserved_traps="$(trap -p EXIT ERR DEBUG RETURN)"
        trap - EXIT ERR DEBUG RETURN
        # shellcheck disable=SC1090  # genuinely dynamic plugin path — resolved at runtime, no static location to point to
        source "$_cc_plugin_file" </dev/null
        eval "$_cc_preserved_shellopts"
        eval "$_cc_preserved_shopts"
        trap - EXIT ERR DEBUG RETURN
        eval "$_cc_preserved_traps"
        unset _cc_preserved_shellopts _cc_preserved_shopts _cc_preserved_traps _cc_probe_rc _cc_probe_marker _cc_probe_out
    done
    unset _cc_plugin_file
}

load_plugins

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

# Create config directory if needed
ensure_config_dir() {
    if [ ! -d "$CONFIG_DIR" ]; then
        mkdir -p "$CONFIG_DIR"
    fi
    if [ ! -f "$PROJECTS_FILE" ]; then
        touch "$PROJECTS_FILE"
    fi
}

# Load user settings from $SETTINGS_FILE, applying documented defaults for any
# missing/invalid key. SECURITY (T-07-02-01): this NEVER `source`s, `eval`s, or
# dot-includes the file — it is parsed strictly line-by-line, so a value like
# `EXTRA_FLAGS=; rm -rf ~` is stored as an inert literal string and is never
# executed DURING PARSING.
# SCOPE (WR-03, 07-REVIEW.md): the above claim covers parsing only. The parsed
# CC_SET_CLAUDE_BIN / CC_SET_EXTRA_FLAGS values are later spliced, unescaped,
# into a shell command-line string sent to a tmux pane via
# `send-keys ... C-m` (start_claude_session, cmd_continue) — that IS executed,
# functionally equivalent to the string being typed and Enter-pressed in an
# interactive shell. Anything with write access to $SETTINGS_FILE (a
# compromised dotfiles sync, a misconfigured automation, a shared machine)
# can therefore run arbitrary commands on the NEXT `cc` launch, not just when
# the user is actively in config_menu. Treat write access to this file as
# equivalent to shell access for this user. write_setting() rejects shell
# metacharacters in CLAUDE_BIN as a partial mitigation (it is meant to be a
# path/command name, not an interpretable command line); EXTRA_FLAGS remains
# unrestricted free text by design (07-04-SUMMARY.md).
# Sets globals: CC_SET_PERMISSION_MODE, CC_SET_PERMISSION_MODE_FALLBACK,
#               CC_SET_MODEL, CC_SET_MEMORY_LIMIT_MB,
#               CC_SET_CLAUDE_BIN, CC_SET_EXTRA_FLAGS, CC_SET_LIMIT_WATCHER,
#               CC_SET_AUTO_TRUST, CC_SET_SHOW_LOGO, CC_SET_IDLE_WATCHDOG
# NOTE: CC_SET_LIMIT_WATCHER is consumed by maybe_start_limit_watcher() (Phase 9,
# Limit-Watcher Core) and CC_SET_AUTO_TRUST is consumed by cmd_add()'s on-add
# prompt and start_claude_session()'s always-mode hook (Phase 10, Cleanup &
# Pre-Trust) — both are now wired, not just parsed/stored. CC_SET_IDLE_WATCHDOG
# (final v4.0 feature step, opt-in idle-watchdog) is consumed by
# sync_idle_watchdog() — see its own comment for the full opt-in/default-off
# contract; this setting is DECLARATIVE ONLY here (cccc never auto-loads the
# daemon on its own — sync_idle_watchdog() only ever reconciles an ALREADY
# installed launchd job with this value, from the terminal config_menu or once
# at interactive dashboard startup, never from `cccc list`/`cccc json`/etc).
load_settings() {
    # Documented defaults — applied first so a missing file, or a missing/invalid
    # key within a present file, always falls back to a known-safe value.
    # PERMISSION_MODE now defaults to auto (Phase 14, BRAND-05/D-08) — auto
    # requires an entitled Opus/Sonnet >=4.6 account, but this default is safe
    # on ANY machine/account with no settings.conf present because
    # auto_mode_supported() (see cc_permission_flag(), ~line 1023) proactively
    # checks the resolved model at launch-command build time and silently
    # degrades to PERMISSION_MODE_FALLBACK (see below) plus a one-time warning
    # when the model isn't entitled — so an unentitled machine still launches
    # safely with zero configuration.
    CC_SET_PERMISSION_MODE="auto"
    # PERMISSION_MODE_FALLBACK (Phase 14, BRAND-05 doc/code reconciliation) is
    # the mode `auto` degrades to when it can't actually run auto (unsupported
    # model, or a backend session where auto isn't a meaningful concept — see
    # cc_permission_flag() WHY comment). This is intentionally NOT `auto`
    # itself — it is one of the other four --permission-mode values. Default
    # is the safest public choice, `default` (permission-prompting): a public
    # user who hits this path still gets prompted, never silently unattended.
    # A user who wants unattended fallback (e.g. for their own backend
    # sessions) opts in explicitly via `cccc config` or settings.conf —
    # `bypassPermissions` is byte-equivalent to the legacy
    # --dangerously-skip-permissions flag it replaces.
    CC_SET_PERMISSION_MODE_FALLBACK="default"
    CC_SET_MODEL=""
    CC_SET_MEMORY_LIMIT_MB="6144"
    CC_SET_CLAUDE_BIN="claude"
    CC_SET_EXTRA_FLAGS=""
    CC_SET_LIMIT_WATCHER="auto"
    CC_SET_AUTO_TRUST="on-add"
    # SHOW_LOGO (BRAND-02/03/04, D-07) defaults to true — the first-run wizard
    # and `cccc about` are the only two call sites that ever print the logo
    # (see render_logo()), so a default-on setting cannot leak it into the
    # dashboard; a user who dislikes the ANSI art can turn it off here or pass
    # --no-logo per invocation.
    CC_SET_SHOW_LOGO="true"
    # IDLE_WATCHDOG (opt-in idle-session RAM reclaim daemon, v4.0 final feature
    # step, decision 2026-07-14 in .planning/cccc-public-release-brief.md #8):
    # defaults to "off". A fresh install — or any machine where settings.conf
    # is absent/doesn't mention this key — NEVER reclaims idle sessions. The
    # daemon (system/bin/claude-idle-watchdog, macOS-only) independently
    # re-checks this same key on every poll pass and self-gates to a no-op
    # when off, so this default is safe even if something loads the launchd
    # job outside of sync_idle_watchdog()'s control.
    CC_SET_IDLE_WATCHDOG="off"

    [ -f "$SETTINGS_FILE" ] || return 0

    local line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip empty lines and comments — same convention as projects.conf parsing.
        [ -z "$line" ] && continue
        [[ "$line" =~ ^# ]] && continue
        [[ "$line" == *=* ]] || continue

        # Split on the FIRST '=' only so free-text values (e.g. EXTRA_FLAGS) may
        # contain embedded '=' characters.
        key="${line%%=*}"
        value="${line#*=}"

        # Trim surrounding whitespace from the key only.
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"

        # Strip one optional layer of matching single or double quotes from value.
        if [[ "${#value}" -ge 2 && "$value" == \"*\" && "$value" == *\" ]]; then
            value="${value:1:${#value}-2}"
        elif [[ "${#value}" -ge 2 && "$value" == \'*\' && "$value" == *\' ]]; then
            value="${value:1:${#value}-2}"
        fi

        # Normalize a single trailing CR FIRST (16-CONTEXT.md D-01, CONCERN-1-
        # pass2). This mirrors Python's own universal-newline text-mode read
        # (cc-webui.py's parse_settings_conf() already sees \r\n translated to
        # \n before it ever runs), so a CRLF-terminated settings.conf parses
        # identically via the bash CLI path as it does via the HTTP path.
        # bash's `read -r` does NOT treat \r as a line delimiter, so on a
        # CRLF file the trailing \r stays attached to EVERY parsed value;
        # without this strip, the control-char guard below would fire on
        # every line and silently revert the ENTIRE settings.conf to
        # hardcoded defaults on each launch. `%` removes only the shortest
        # matching suffix, so this touches nothing but a single trailing CR.
        value="${value%$'\r'}"

        # SEC-02 (16-CONTEXT.md D-01): defensive, belt-and-suspenders check —
        # skip (fall back to the documented default) any value that STILL
        # contains an EMBEDDED \n or \r after the trailing-CR strip above.
        # By construction `read -r` cannot deliver an embedded literal
        # newline within one parsed value (the newline would already have
        # split the line before we ever got here), so this guards against
        # some OTHER future write path that bypasses write_setting()'s own
        # preventive guard, not against an injection that already succeeded.
        #
        # Match ONLY \n and \r — same character set as write_setting()'s
        # guard. Do NOT add a *$'\0'* (or *$'\x00'*) branch: $'\0' is an
        # EMPTY string in bash, so *$'\0'* == ** matches EVERY value, which
        # would make this guard `continue` past every parsed line and
        # silently revert settings.conf to hardcoded defaults on every
        # launch — the BLOCKER-1 tautology bug, at its highest-impact
        # failure mode here. NUL is unrepresentable in a bash string, so
        # there is nothing to test at runtime; it is rejected on the Python
        # side (Plan 01) for defense-in-depth symmetry only.
        if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
            continue
        fi

        case "$key" in
            PERMISSION_MODE)
                case "$value" in
                    default|acceptEdits|plan|auto|bypassPermissions)
                        CC_SET_PERMISSION_MODE="$value" ;;
                esac
                ;;
            PERMISSION_MODE_FALLBACK)
                case "$value" in
                    default|acceptEdits|plan|bypassPermissions)
                        CC_SET_PERMISSION_MODE_FALLBACK="$value" ;;
                esac
                ;;
            MODEL)
                CC_SET_MODEL="$value"
                ;;
            MEMORY_LIMIT_MB)
                [[ "$value" =~ ^[0-9]+$ ]] && CC_SET_MEMORY_LIMIT_MB="$value"
                ;;
            CLAUDE_BIN)
                CC_SET_CLAUDE_BIN="$value"
                ;;
            EXTRA_FLAGS)
                CC_SET_EXTRA_FLAGS="$value"
                ;;
            LIMIT_WATCHER)
                case "$value" in
                    auto|manual|off)
                        CC_SET_LIMIT_WATCHER="$value" ;;
                esac
                ;;
            AUTO_TRUST)
                case "$value" in
                    on-add|always|off)
                        CC_SET_AUTO_TRUST="$value" ;;
                esac
                ;;
            SHOW_LOGO)
                case "$value" in
                    true|false)
                        CC_SET_SHOW_LOGO="$value" ;;
                esac
                ;;
            IDLE_WATCHDOG)
                case "$value" in
                    off|on)
                        CC_SET_IDLE_WATCHDOG="$value" ;;
                esac
                ;;
            *)
                : # unknown key — ignored
                ;;
        esac
    done < "$SETTINGS_FILE"
}

# Validate and atomically upsert a single KEY=value pair into SETTINGS_FILE.
# Round-trips with load_settings' first-'=' split / whitelist-validate parse
# contract: the raw value is written verbatim after "KEY=" with no quoting.
# Args: <key> <value>
# Returns:
#   0 - success, value written
#   1 - VALIDATION failure (out-of-whitelist enum, non-numeric MEMORY_LIMIT_MB,
#       unknown key, or a value containing an embedded newline/CR — SEC-02)
#       — SETTINGS_FILE is left untouched
#   2 - I/O failure (CONFIG_DIR unwritable, temp-file create or mv failed) —
#       distinct from validation so callers do not conflate the two
write_setting() {
    local key="$1" value="$2"

    # SEC-01/SEC-02 (16-CONTEXT.md D-01/D-02): reject any value containing a
    # literal newline or carriage return before it is ever written —
    # serialize_settings()'s Python twin and this function's own
    # printf '%s=%s\n' below both treat embedded \n as a line break, which
    # would splice an extra KEY=value line into settings.conf and bypass
    # every enum whitelist below. Applies uniformly to EVERY key (not just
    # CLAUDE_BIN) — the injection mechanism does not care which key carries
    # the payload.
    #
    # Match ONLY \n and \r. Do NOT add a *$'\0'* (or *$'\x00'*) branch:
    # $'\0' evaluates to an EMPTY string in bash (verified on 3.2.57 and
    # 5.3.3), so *$'\0'* == ** matches EVERY value and would reject every
    # legitimate write (the BLOCKER-1 tautology). A bash variable structurally
    # cannot hold a NUL byte, so there is nothing to test at runtime. NUL is
    # rejected on the Python side (Plan 01, validate_settings) for
    # defense-in-depth symmetry; on the bash side it is documentation-only.
    if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
        return 1
    fi

    # Re-validate with the SAME whitelists load_settings uses, so an invalid
    # enum/numeric value can never reach settings.conf via this writer.
    case "$key" in
        PERMISSION_MODE)
            case "$value" in
                default|acceptEdits|plan|auto|bypassPermissions) : ;;
                *) return 1 ;;
            esac
            ;;
        PERMISSION_MODE_FALLBACK)
            case "$value" in
                default|acceptEdits|plan|bypassPermissions) : ;;
                *) return 1 ;;
            esac
            ;;
        LIMIT_WATCHER)
            case "$value" in
                auto|manual|off) : ;;
                *) return 1 ;;
            esac
            ;;
        AUTO_TRUST)
            case "$value" in
                on-add|always|off) : ;;
                *) return 1 ;;
            esac
            ;;
        SHOW_LOGO)
            case "$value" in
                true|false) : ;;
                *) return 1 ;;
            esac
            ;;
        IDLE_WATCHDOG)
            case "$value" in
                off|on) : ;;
                *) return 1 ;;
            esac
            ;;
        MEMORY_LIMIT_MB)
            [[ "$value" =~ ^[0-9]+$ ]] || return 1
            ;;
        CLAUDE_BIN)
            # WR-03 (07-REVIEW.md): CLAUDE_BIN is supposed to be a path or
            # command name, not an interpretable command line — it is spliced
            # unescaped into a shell string later sent to tmux send-keys, so
            # reject shell metacharacters that would let it smuggle extra
            # commands (e.g. "claude; rm -rf ~" or "claude | sh").
            [[ "$value" =~ [\;\|\&\$\`] ]] && return 1
            ;;
        MODEL|EXTRA_FLAGS)
            : # free text — including empty, no validation beyond the key whitelist
            ;;
        *)
            return 1 # unknown key — validation failure, not written
            ;;
    esac

    # Ensure CONFIG_DIR exists before attempting to write (I/O failure path).
    if [ ! -d "$CONFIG_DIR" ]; then
        mkdir -p "$CONFIG_DIR" 2>/dev/null || return 2
    fi
    [ -w "$CONFIG_DIR" ] || return 2

    # Edit via temp file + mv (never in-place sed -i) — mirrors the
    # remove_project_from_conf/add_project_to_group temp-file+mv convention,
    # avoiding metacharacter breakage and partial writes on crash.
    local tmp
    tmp=$(mktemp "${SETTINGS_FILE}.XXXXXX" 2>/dev/null) || return 2

    local found=0
    if [ -f "$SETTINGS_FILE" ]; then
        local line line_key
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ -n "$line" ]] && [[ "$line" != \#* ]] && [[ "$line" == *=* ]]; then
                line_key="${line%%=*}"
                line_key="${line_key#"${line_key%%[![:space:]]*}"}"
                line_key="${line_key%"${line_key##*[![:space:]]}"}"
                if [ "$line_key" = "$key" ]; then
                    printf '%s=%s\n' "$key" "$value" >> "$tmp"
                    found=1
                    continue
                fi
            fi
            printf '%s\n' "$line" >> "$tmp"
        done < "$SETTINGS_FILE"
    fi

    if [ "$found" -eq 0 ]; then
        printf '%s=%s\n' "$key" "$value" >> "$tmp"
    fi

    if ! mv -f "$tmp" "$SETTINGS_FILE" 2>/dev/null; then
        rm -f "$tmp"
        return 2
    fi

    return 0
}

# Defensively pre-trust a project path in Claude Code's own ~/.claude.json
# (TRUST-04). Called from the on-add consent prompt (cmd_add) and the
# always-mode pre-spawn hook (start_claude_session). Contract: validate-first,
# backup-before-write, missing-key-only (never downgrade an explicit user
# choice), atomic mktemp+mv, and ALWAYS return 0 so a helper failure never
# aborts the caller's tmux/claude spawn.
# Args: <target_dir> (absolute project path)
trust_path_defensively() {
    local target_dir="$1"
    local claude_json="$HOME/.claude.json"

    [[ -f "$claude_json" ]] || return 0
    # The parse-validate (jq empty) and full-file backup deliberately run
    # BEFORE the missing-key check below — a known, accepted tradeoff for
    # simplicity/correctness (it avoids a second read of the file), and it is
    # cheap relative to the tmux/claude spawn this call precedes. Side effect:
    # the .bak is overwritten on every call including no-op ones (key already
    # set), so it rarely reflects a genuinely pre-write state.
    jq empty "$claude_json" 2>/dev/null || return 0   # invalid JSON — bail clean
    cp "$claude_json" "${claude_json}.bak" 2>/dev/null || return 0

    # Only write if the key is MISSING (never overwrite an existing true/false).
    # NOTE: deliberately NOT using jq's `//` alternative operator here — `//`
    # treats `false` the same as `null` (both are "falsy" in jq), so
    # `.hasTrustDialogAccepted // "missing"` would incorrectly report an
    # explicit `false` as "missing" and let it be upgraded to true, exactly
    # the downgrade this helper must never perform. An explicit `== null`
    # check distinguishes "key absent" from "key present and false".
    local already_set
    already_set=$(jq -r --arg dir "$target_dir" \
        'if (.projects[$dir].hasTrustDialogAccepted == null) then "missing" else (.projects[$dir].hasTrustDialogAccepted | tostring) end' \
        "$claude_json" 2>/dev/null)
    [[ "$already_set" == "missing" ]] || return 0

    # Known, accepted, self-healing read-modify-write race: two concurrent `cc`
    # processes trusting different never-before-seen paths in the same narrow
    # window can race here. Worst case one of the two writes is lost and that
    # project's user sees the normal trust dialog once more — NEVER file
    # corruption (the atomic mktemp+mv below still guarantees no partial
    # writes). No lock is added on purpose — by design, scoped to mktemp
    # alone.
    local tmpfile
    tmpfile=$(mktemp "${claude_json}.XXXXXX") || return 0
    if jq --arg dir "$target_dir" \
        '.projects[$dir] = (.projects[$dir] // {}) + {hasTrustDialogAccepted: true}' \
        "$claude_json" > "$tmpfile" 2>/dev/null; then
        mv "$tmpfile" "$claude_json" 2>/dev/null || rm -f "$tmpfile"
    else
        rm -f "$tmpfile"
    fi
    return 0   # ALWAYS clean exit — never abort the caller's spawn flow
}

# Get backend badge for a session (raw ANSI string, empty if none)
get_backend_badge() {
    local sess_name="$1"
    local backend
    backend=$(tmux showenv -t "$sess_name" CC_BACKEND 2>/dev/null | cut -d= -f2)
    if [[ -n "$backend" ]]; then
        printf "${PINK} [=%s]${NC}" "$backend"
    fi
}

# TRUST-05: best-effort OR-of-both-phrasings regex for Claude Code's
# folder-trust dialog. Per 10-RESEARCH.md Pitfall 2 / Open Question 1, neither
# phrasing was confirmed live in this environment (4 reproduction attempts
# failed) — both are sourced from GitHub issue text at MEDIUM/LOW confidence.
# Kept in ONE named variable so the maintainer can correct it in a single
# place after the checkpoint:human-verify gate (Task 2 of 10-05-PLAN.md)
# confirms/corrects it against a real dialog.
TRUST_DIALOG_PATTERN="trust the files in this folder|is this a project you created or one you trust"

# Detect a session stuck at Claude Code's folder-trust dialog (TRUST-05).
# Best-effort: OR of both known dialog-text variants (RESEARCH.md Pitfall 2 —
# neither confirmed live in this environment). Silent (empty output, return 0)
# on no match — NEVER treated as an error, and independent of
# CC_SET_AUTO_TRUST (fires even when AUTO_TRUST=off). Single capture-pane per
# session, same cost class as get_backend_badge() above — no extra pane
# capture is added to the render loop.
get_trust_dialog_marker() {
    local sess_name="$1"
    local pane_text
    pane_text=$(tmux capture-pane -t "=$sess_name" -p 2>/dev/null) || return 0
    if echo "$pane_text" | grep -qiE "$TRUST_DIALOG_PATTERN"; then
        printf "${YELLOW}⚠ waiting for trust — attach to confirm${NC}"
    fi
    return 0
}

# Convert path to Claude projects directory name
path_to_claude_dir() {
    local path="$1"
    echo "$path" | sed 's|^/||' | tr '/' '-'
}

# Check if a path is a Claude project
is_claude_project() {
    local path="$1"
    local claude_dir_name
    claude_dir_name=$(path_to_claude_dir "$path")
    [ -d "$CLAUDE_PROJECTS_DIR/$claude_dir_name" ]
}

# Resolve the sessions-index.json path for a given project path.
# Uses the correct Claude Code path-hash formula (leading '-', spaces converted).
# Falls back to a projectPath scan for non-ASCII paths (e.g. Café-Bäckerei) where tr
# cannot produce the right hash. Returns empty string if not found — never exits
# non-zero. Relies on $CLAUDE_PROJECTS_DIR being set (global, line 9).
resolve_sessions_index() {
    local path="$1"
    local hash idx

    # Stage 1: direct hash — handles ASCII paths including paths with spaces.
    # Leading '-' is mandatory (all Claude project dirs start with '-').
    # Both '/' and ' ' are in the tr character set (Pitfall 1 + 2 in RESEARCH).
    hash="-$(printf '%s' "${path#/}" | tr '/ ' '--')"
    idx="$CLAUDE_PROJECTS_DIR/${hash}/sessions-index.json"
    if [[ -f "$idx" ]]; then
        echo "$idx"
        return 0
    fi

    # Stage 2: projectPath scan fallback — for non-ASCII paths (e.g. Café-Bäckerei)
    # where tr cannot produce the correct hash (RESEARCH Pitfall 4).
    # Read .entries[0].projectPath from each sessions-index.json and compare.
    local f
    for f in "$CLAUDE_PROJECTS_DIR"/*/sessions-index.json; do
        [[ -e "$f" ]] || continue
        local pp
        pp=$(jq -r '.entries[0].projectPath // empty' "$f" 2>/dev/null)
        if [[ "$pp" == "$path" ]]; then
            echo "$f"
            return 0
        fi
    done

    # Not found — return empty string, exit 0 (callers expect empty-on-miss).
    echo ""
    return 0
}

# Parse a sessions-index.json and emit surviving entries as TSV.
# Usage: parse_sessions_index <idx>
# Prints zero or more lines: sessionId<TAB>summary<TAB>fileMtime_ms<TAB>fullPath
# Filters: isSidechain != true (DATA-04), fullPath file must exist (DATA-03 GC filter).
# fileMtime is already epoch milliseconds from sessions-index — emitted unchanged.
# Returns 0 with no output on empty/missing/malformed input.
parse_sessions_index() {
    local idx="$1"

    # Normal case for ~80% of projects — no index, not an error.
    [[ -z "$idx" ]] && return 0
    [[ ! -f "$idx" ]] && return 0

    # ONE jq call: filter isSidechain != true (keeps absent/false/null, drops only true),
    # require non-empty fullPath, emit all four fields as TSV, sort newest fileMtime first.
    # select(.isSidechain != true) — NOT == false: null != true is true in jq, so entries
    # that omit isSidechain (null) are KEPT. This is the DATA-04 requirement.
    local tsv
    tsv=$(jq -r '
        .entries[]
        | select(.isSidechain != true)
        | select((.fullPath // "") != "")
        | [.sessionId, (.summary // .firstPrompt // "(no summary)"), (.fileMtime | tostring), .fullPath]
        | @tsv
    ' "$idx" 2>/dev/null | sort -t$'\t' -k3,3nr) || true

    # DATA-03 GC filter: bash [[ -f fullPath ]] — jq cannot do filesystem stats.
    # Emit only entries whose .jsonl file still exists on disk.
    local sid summary mtime fpath
    while IFS=$'\t' read -r sid summary mtime fpath; do
        [[ -z "$sid" ]] && continue
        [[ ! -f "$fpath" ]] && continue
        printf '%s\t%s\t%s\t%s\n' "$sid" "$summary" "$mtime" "$fpath"
    done <<< "$tsv"

    return 0
}

# Extract first meaningful user text from a .jsonl session file as a summary.
# Skips system/tool messages and bracketed meta-strings like "[Request interrupted]".
# Returns "(no summary)" if nothing useful found.
extract_jsonl_summary() {
    local fpath="$1"
    local sid summary

    # Prefer persisted cc session name (saved by _save_session_name_before_kill).
    sid=$(basename "$fpath" .jsonl)
    local name_file="$CONFIG_DIR/session-names/$sid"
    if [[ -f "$name_file" ]]; then
        summary=$(cat "$name_file" 2>/dev/null)
        [[ -n "$summary" ]] && printf '%s' "$summary" && return 0
    fi

    summary=$(jq -Rr '
        fromjson? |
        select(.type == "user") |
        .message.content |
        if type == "array" then
            (.[] | select(.type == "text") | .text)
        elif type == "string" then .
        else empty end
    ' "$fpath" 2>/dev/null \
        | grep -v '^\[' \
        | grep -v '^$' \
        | head -1)
    printf '%s' "${summary:-(no summary)}"
}

# DATA-02 fallback: return ALL .jsonl files for a project without sessions-index.
# Usage: get_data02_session <path>
# Prints N lines (one per session): sessionId<TAB>summary<TAB>fileMtime_ms<TAB>fullPath
# where fileMtime_ms = epoch seconds * 1000 (uniform with parse_sessions_index output).
# Prints nothing and returns 0 if the project dir has no .jsonl files.
# This is the DOMINANT code path (~80% of projects lack sessions-index.json).
get_data02_session() {
    local path="$1"

    # Compute project dir via the same leading-dash hash as resolve_sessions_index Stage 1.
    local hash
    hash="-$(printf '%s' "${path#/}" | tr '/ ' '--')"
    local proj_dir="$CLAUDE_PROJECTS_DIR/${hash}"
    [[ -d "$proj_dir" ]] || return 0

    # Iterate ALL .jsonl files sorted newest-first (ls -t = sort by mtime descending).
    local fpath
    while IFS= read -r fpath; do
        [[ -f "$fpath" ]] || continue
        # Skip subagent files (nested paths contain a slash after the UUID).
        [[ "$fpath" == */subagents/* ]] && continue

        local session_id mtime summary
        session_id=$(basename "$fpath" .jsonl)
        mtime=$(stat -f "%m" "$fpath" 2>/dev/null || stat -c "%Y" "$fpath" 2>/dev/null || echo 0)
        summary=$(extract_jsonl_summary "$fpath")

        printf '%s\t%s\t%s\t%s\n' "$session_id" "$summary" "$(( mtime * 1000 ))" "$fpath"
    done < <(ls -t "$proj_dir"/*.jsonl 2>/dev/null)

    return 0
}

# Called ON DEMAND from the Phase 6 recover handler (REC-01) only — never from the render loop
# (O(38×jq) runs once per explicit invocation, not per keypress).
load_recoverable_sessions() {
    # Six global output arrays — reset on each call.
    recoverable_session_ids=()
    recoverable_project_paths=()
    recoverable_project_names=()
    recoverable_summaries=()
    recoverable_mtimes=()
    recoverable_fpaths=()

    # Working arrays that hold ALL collected entries before sort+cap.
    local _all_ids=()
    local _all_paths=()
    local _all_names=()
    local _all_summaries=()
    local _all_mtimes=()
    local _all_fpaths=()

    # Guard: no projects file → nothing to do.
    [ -f "$PROJECTS_FILE" ] || return 0

    # Iterate projects.conf using the SAME parse contract as show_dashboard.
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip empty lines.
        [ -z "$line" ] && continue
        # Skip comments.
        [[ "$line" =~ ^# ]] && continue
        # Skip group headers ([GroupName]).
        [[ "$line" =~ ^\[(.+)\]$ ]] && continue

        # Parse project line.
        local title path
        IFS='|' read -r title path <<< "$line"
        [ -z "$title" ] || [ -z "$path" ] && continue

        # Dispatch: prefer sessions-index if it exists; fall back to DATA-02.
        local idx
        idx=$(resolve_sessions_index "$path")

        local _entries
        if [[ -n "$idx" ]]; then
            _entries=$(parse_sessions_index "$idx")
        else
            _entries=$(get_data02_session "$path")
        fi

        # Append each entry to working arrays (fpath is 4th TSV field).
        while IFS=$'\t' read -r sid summary mtime fpath_entry; do
            [[ -z "$sid" ]] && continue
            _all_ids+=("$sid")
            _all_summaries+=("$summary")
            _all_mtimes+=("$mtime")
            _all_paths+=("$path")
            _all_names+=("$title")
            _all_fpaths+=("$fpath_entry")
        done <<< "$_entries"

    done < "$PROJECTS_FILE"

    # Guard: nothing collected — export empty strings and return.
    if [[ ${#_all_ids[@]} -eq 0 ]]; then
        export CC_RECOVERABLE_IDS=""
        export CC_RECOVERABLE_PATHS=""
        export CC_RECOVERABLE_NAMES=""
        export CC_RECOVERABLE_SUMMARIES=""
        export CC_RECOVERABLE_MTIMES=""
        export CC_RECOVERABLE_FPATHS=""
        return 0
    fi

    # HIST-01: sort by fileMtime descending, cap at 30.
    # Build a sortable "mtime|original_index" list, sort numeric descending,
    # then pick the original-index values up to 30.
    local _sort_input=""
    local _i
    for _i in "${!_all_ids[@]}"; do
        _sort_input="${_sort_input}${_all_mtimes[$_i]}|${_i}"$'\n'
    done

    local _count=0
    while IFS='|' read -r _mtime _orig_idx; do
        [[ -z "$_orig_idx" ]] && continue
        recoverable_session_ids+=("${_all_ids[$_orig_idx]}")
        recoverable_project_paths+=("${_all_paths[$_orig_idx]}")
        recoverable_project_names+=("${_all_names[$_orig_idx]}")
        recoverable_summaries+=("${_all_summaries[$_orig_idx]}")
        recoverable_mtimes+=("${_all_mtimes[$_orig_idx]}")
        recoverable_fpaths+=("${_all_fpaths[$_orig_idx]}")
        _count=$(( _count + 1 ))
        [[ $_count -ge 30 ]] && break
    done <<< "$(printf '%s' "$_sort_input" | sort -t'|' -k1,1nr)"

    # Export (mirroring the CC_SESSION_* pattern from show_dashboard).
    if [[ ${#recoverable_session_ids[@]} -gt 0 ]]; then
        local _cc_recoverable_ids _cc_recoverable_paths _cc_recoverable_names _cc_recoverable_summaries _cc_recoverable_mtimes _cc_recoverable_fpaths
        _cc_recoverable_ids="$(printf '%s\n' "${recoverable_session_ids[@]}")"
        _cc_recoverable_paths="$(printf '%s\n' "${recoverable_project_paths[@]}")"
        _cc_recoverable_names="$(printf '%s\n' "${recoverable_project_names[@]}")"
        _cc_recoverable_summaries="$(printf '%s\n' "${recoverable_summaries[@]}")"
        _cc_recoverable_mtimes="$(printf '%s\n' "${recoverable_mtimes[@]}")"
        _cc_recoverable_fpaths="$(printf '%s\n' "${recoverable_fpaths[@]}")"
        export CC_RECOVERABLE_IDS="$_cc_recoverable_ids"
        export CC_RECOVERABLE_PATHS="$_cc_recoverable_paths"
        export CC_RECOVERABLE_NAMES="$_cc_recoverable_names"
        export CC_RECOVERABLE_SUMMARIES="$_cc_recoverable_summaries"
        export CC_RECOVERABLE_MTIMES="$_cc_recoverable_mtimes"
        export CC_RECOVERABLE_FPATHS="$_cc_recoverable_fpaths"
    else
        export CC_RECOVERABLE_IDS=""
        export CC_RECOVERABLE_PATHS=""
        export CC_RECOVERABLE_NAMES=""
        export CC_RECOVERABLE_SUMMARIES=""
        export CC_RECOVERABLE_MTIMES=""
        export CC_RECOVERABLE_FPATHS=""
    fi
}

# Get project title from projects.conf or use directory name
get_project_title() {
    local path="$1"

    # Search in projects.conf
    if [ -f "$PROJECTS_FILE" ]; then
        local title
        title=$(grep "|${path}$" "$PROJECTS_FILE" | cut -d'|' -f1)
        if [ -n "$title" ]; then
            echo "$title"
            return
        fi
    fi

    # Fallback: use last path component
    basename "$path"
}

# Shorten path to last N components
shorten_path() {
    local path="$1"
    local max_depth="${2:-2}"

    # Replace $HOME with ~
    path="${path/#$HOME/\~}"

    # Count components, excluding leading ~ so ~/X/Y counts as 2 not 3
    local stripped="${path/#\~\//}"
    [[ "$stripped" == "~" ]] && stripped=""
    local dir_count
    dir_count=$(echo "$stripped" | tr '/' '\n' | grep -v '^$' | wc -l | tr -d ' ')

    if [ "$dir_count" -le "$max_depth" ]; then
        echo "$path"
    else
        # Take last N directories
        echo "$path" | rev | cut -d'/' -f1-${max_depth} | rev | sed 's|^|~/…/|'
    fi
}

# Format epoch-milliseconds mtime as human-readable relative time.
# Usage: format_time_ago <mtime_ms>
# Input is epoch MILLISECONDS (as stored in CC_RECOVERABLE_MTIMES — see cc/cc:146, cc/cc:209).
# Outputs: Xm ago / Xh ago / X days ago
format_time_ago() {
    local mtime_ms="$1"
    # WR-01: guard against missing/zero mtime (stat failure fallback → mtime_ms=0
    # would produce "19675 days ago"; negative delta from clock skew would print "-Xm ago").
    [[ -z "$mtime_ms" || "$mtime_ms" == "0" ]] && { printf 'unknown'; return; }
    local mtime=$(( mtime_ms / 1000 ))
    local now
    now=$(date +%s)
    local delta=$(( now - mtime ))
    # Clamp negative delta (clock skew) to 0 so output reads "0m ago" not "-Xm ago".
    (( delta < 0 )) && delta=0
    if (( delta < 3600 )); then
        printf '%dm ago' "$(( delta / 60 ))"
    elif (( delta < 86400 )); then
        printf '%dh ago' "$(( delta / 3600 ))"
    else
        printf '%d days ago' "$(( delta / 86400 ))"
    fi
}

# Reserved single letters (used as global commands):
#   h=help  n=new-free-session  q=quit  r=refresh
# These are skipped in project letter assignment so projects never shadow them.
_CC_RESERVED="hnqr"
# TAIL-reserved letters: forbidden as the LAST character of a MULTI-char project
# code (z<x> / zz<x>). A double code "z<x>" is 2 chars, so the kill/gsd/new
# dispatch regexes ^(z[a-z]|[a-z])<cmd>$ can parse it as project "z" + command
# <cmd> when <x> is a command-suffix letter — e.g. "zk" (kill-all in z) or "zg"
# (GSD in z), shadowing the project whose code is "zk"/"zg". Excluding the whole
# suffix set (help/new/quit/refresh/kill/gsd) from the tail makes a multi-char
# code end in a command letter impossible, so no code can ever collide.
_CC_RESERVED_TAIL="hnqrkg"

# Convert number to letter, skipping reserved letters.
# Singles: a-z minus h,n,q,r (22 letters)
# Doubles: z<x> where x ∈ a-z minus h,n,q,r,k,g (20 codes)
# Triples: zz<x> where x ∈ a-z minus h,n,q,r,k,g (20 codes)
num_to_letter() {
    local target=$1
    local count=0 code char

    for (( code=1; code<=26; code++ )); do
        char=$(printf "\\$(printf '%03o' $((96 + code)))")
        [[ "$_CC_RESERVED" == *"$char"* ]] && continue
        (( count++ ))
        (( count == target )) && { printf '%s' "$char"; return; }
    done
    for (( code=1; code<=26; code++ )); do
        char=$(printf "\\$(printf '%03o' $((96 + code)))")
        [[ "$_CC_RESERVED_TAIL" == *"$char"* ]] && continue
        (( count++ ))
        (( count == target )) && { printf 'z%s' "$char"; return; }
    done
    for (( code=1; code<=26; code++ )); do
        char=$(printf "\\$(printf '%03o' $((96 + code)))")
        [[ "$_CC_RESERVED_TAIL" == *"$char"* ]] && continue
        (( count++ ))
        (( count == target )) && { printf 'zz%s' "$char"; return; }
    done
}

# ============================================================================
# PROJECTS.CONF HELPERS (atomic + group-aware)
# ============================================================================

# Check if a project name exists (exact match on first | field, ignores group headers)
project_exists() {
    local name="$1"
    [ -f "$PROJECTS_FILE" ] || return 1
    awk -F'|' -v n="$name" '$1 == n {found=1; exit} END {exit !found}' "$PROJECTS_FILE"
}

# Atomically remove a project line from projects.conf
remove_project_from_conf() {
    local name="$1"
    [ -f "$PROJECTS_FILE" ] || return 1
    local tmp
    tmp=$(mktemp "${PROJECTS_FILE}.XXXXXX") || return 1
    if awk -F'|' -v n="$name" '$1 != n' "$PROJECTS_FILE" > "$tmp"; then
        mv -f "$tmp" "$PROJECTS_FILE"
    else
        rm -f "$tmp"
        return 1
    fi
}

# Insert a project under a [Group] header. Creates the group if missing.
# If group is empty, appends at the end.
add_project_to_group() {
    local name="$1" path="$2" group="$3"
    [ -f "$PROJECTS_FILE" ] || touch "$PROJECTS_FILE"

    if [ -z "$group" ]; then
        echo "${name}|${path}" >> "$PROJECTS_FILE"
        return 0
    fi

    # If group doesn't exist, append a new section at end
    if ! grep -qxF "[$group]" "$PROJECTS_FILE" 2>/dev/null; then
        # Add blank line separator if file doesn't end in one
        if [ -s "$PROJECTS_FILE" ] && [ "$(tail -c1 "$PROJECTS_FILE" 2>/dev/null)" != "" ]; then
            echo "" >> "$PROJECTS_FILE"
        fi
        echo "[$group]" >> "$PROJECTS_FILE"
        echo "${name}|${path}" >> "$PROJECTS_FILE"
        return 0
    fi

    # Group exists -> insert after last project line of the group, before any
    # trailing blank lines and the next [Group] header.
    local tmp
    tmp=$(mktemp "${PROJECTS_FILE}.XXXXXX") || return 1
    awk -v target="[$group]" -v entry="${name}|${path}" '
        BEGIN { in_target = 0; inserted = 0; blank_buf = "" }
        function flush_blanks() {
            if (blank_buf != "") { printf "%s", blank_buf; blank_buf = "" }
        }
        {
            if ($0 == target) {
                flush_blanks()
                print
                in_target = 1
                next
            }
            if (/^\[.+\]$/) {
                if (in_target && !inserted) {
                    print entry
                    inserted = 1
                    in_target = 0
                }
                flush_blanks()
                print
                next
            }
            if (in_target && /^[[:space:]]*$/) {
                blank_buf = blank_buf $0 "\n"
                next
            }
            flush_blanks()
            print
        }
        END {
            if (in_target && !inserted) { print entry }
            flush_blanks()
        }
    ' "$PROJECTS_FILE" > "$tmp" && mv -f "$tmp" "$PROJECTS_FILE"
}

# ============================================================================
# DASHBOARD HELPERS
# ============================================================================

# Find index in project_letters array. Echoes index, returns 1 if not found.
find_project_index_by_letter() {
    local letter="$1"
    local i
    for i in "${!project_letters[@]}"; do
        if [ "${project_letters[$i]}" = "$letter" ]; then
            echo "$i"
            return 0
        fi
    done
    return 1
}

# Reset terminal title (used after detach)
reset_terminal_title() {
    echo -ne "\033]0;\007"
}

# Prompt for session name and start a new Claude session in a project.
# Args: <letter> <flags> <label-suffix> [inline-name] [auto_watcher] [backend]
# Returns 1 if invalid letter or aborted.
prompt_new_session_for_project() {
    local letter="$1"
    local flags="$2"
    local label="$3"
    local inline_name="${4:-}"
    local _auto_watcher="${5:-}"  # reserved positional slot, not yet consumed by this function
    local backend="${6:-}"

    local project_index
    if ! project_index=$(find_project_index_by_letter "$letter"); then
        echo -e "${RED}✗ Invalid project: $letter${NC}"
        sleep 2
        return 1
    fi

    local proj_path="${project_paths[$project_index]}"
    local proj_title="${project_titles[$project_index]}"

    clear
    if [ -n "$label" ]; then
        echo -e "${CYAN}New session in project '${proj_title}' ${label}${NC}"
    else
        echo -e "${CYAN}New session in project '${proj_title}'${NC}"
    fi
    echo ""

    local new_name
    if [ -n "$inline_name" ]; then
        new_name="$inline_name"
        echo -e "${GRAY}Session name: ${new_name}${NC}"
    else
        read -p "Session name: " new_name
    fi

    if [ -z "$new_name" ]; then
        echo -e "${RED}✗ Name required${NC}"
        sleep 2
        return 1
    fi

    local full_session_name
    full_session_name="cc-$(sanitize_session_name "${proj_title}")-$(sanitize_session_name "${new_name}")"
    start_claude_session "$full_session_name" "$proj_path" "$flags" "$backend" || return 1
    maybe_start_limit_watcher "$full_session_name"
    sleep 1
    attach_session "$full_session_name"
    return 0
}

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================

# Get all tmux sessions with details
get_tmux_sessions() {
    tmux list-sessions -F "#{session_name}|#{session_path}|#{session_attached}|#{session_windows}" 2>/dev/null
}

# Same as get_tmux_sessions but with two extra fields — the active pane's pid
# and foreground command — used ONLY by the dashboard to tell a live claude
# session apart from a dormant one (tmux pane alive but claude reclaimed/quit).
# Kept separate so get_tmux_sessions' 4-field contract stays stable for every
# other caller.
get_tmux_sessions_meta() {
    tmux list-sessions -F "#{session_name}|#{session_path}|#{session_attached}|#{session_windows}|#{pane_pid}|#{pane_current_command}" 2>/dev/null
}

# Create terminal title in format "/folder:session-name"
format_terminal_title() {
    local session_name="$1"
    local session_path="$2"

    # Remove "cc-" prefix
    local clean_name="$session_name"
    if [[ "$session_name" =~ ^cc- ]]; then
        clean_name="${session_name#cc-}"
    fi

    # Get last folder name
    local folder
    folder=$(basename "$session_path")

    echo "/${folder}:${clean_name}"
}

# Sanitize session name: lowercase, spaces to hyphens
sanitize_session_name() {
    # Convert to lowercase, spaces to dashes, then keep only ASCII alnum/underscore/dot/dash
    echo "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | LC_ALL=C tr -cd '[:alnum:]_.-'
}

# Proactive auto-mode entitlement check (BRAND-05, D-09/D-10). There is no
# documented, reliable startup signal for "auto mode unavailable" (see D-09's
# researched correction — the only named failure strings are transient
# per-action runtime classifier failures, not a startup rejection), so
# reactive pane-polling is not buildable. Instead, this pure function
# resolves the configured/resolved model string BEFORE launch and matches it
# against the D-09 entitled-model whitelist: Anthropic API Opus/Sonnet
# >=4.6, plus the Bedrock/Vertex/Foundry/gateway-only subset (Sonnet 5,
# Opus 4.7, Opus 4.8 — already covered by the >=4.6 rule below since 4.7/4.8
# are >=4.6 and Sonnet 5 is a higher major version). Returns 0 (entitled) or
# 1 (not entitled) by exit code, matching the is_claude_project() boolean-
# by-exit-code convention (cc/cc:~462).
#
# KNOWN LIMITATION (D-10): the Team/Enterprise admin-toggle /
# `permissions.disableAutoMode` case (case C in the docs) cannot be detected
# from the model string alone — it degrades safely to `default`/manual mode
# at runtime (permission prompts, never an unsafe mode), and such users can
# opt into `bypassPermissions` explicitly via `cccc config`. This function
# does not attempt to detect that case.
auto_mode_supported() {
    local model="${1:-}"
    # Empty CC_SET_MODEL means Claude's own default model is used — that
    # default is an entitled tier, so treat empty as entitled (D-09).
    [ -z "$model" ] && return 0
    case "$model" in
        opus|sonnet)
            # Bare tier alias — resolves to the latest entitled model at
            # launch time.
            return 0
            ;;
        *opus*4-[6-9]*|*opus*4.[6-9]*|*opus*4-1[0-9]*|*opus-5*|*opus*5.[0-9]*)
            return 0
            ;;
        *sonnet*4-[6-9]*|*sonnet*4.[6-9]*|*sonnet*4-1[0-9]*|*sonnet-5*|*sonnet*5.[0-9]*)
            return 0
            ;;
        *)
            # Pre-4.6 versioned models (e.g. claude-3-5-haiku, claude-3-*)
            # and any unlisted/unrecognized model string are NOT entitled.
            return 1
            ;;
    esac
}

# One-time process-scoped warning when auto mode silently falls back to a
# different permission mode, so a user isn't repeatedly spammed across
# multiple cc_permission_flag() calls within the same cccc invocation. Every
# real call site invokes cc_permission_flag via command substitution
# ($(cc_permission_flag ...)), which forks a bash subshell — a plain
# in-memory global (e.g. CC_AUTO_FALLBACK_WARNED=1) set inside that subshell
# would NOT survive back to the parent process, so "process-scoped" state
# here needs a PID-keyed sentinel FILE instead (same $$-scoped tmpfile
# convention already used elsewhere in this script, e.g. cmd_json's
# /tmp/.cc-json-err.$$). `$$` (unlike $BASHPID) always reports the
# top-level shell's PID even from inside a command-substitution subshell,
# so this correctly de-dupes across calls within one cccc invocation.
#
# Args: $1 reason (human-readable — "model 'x'" or "backend session 'y'"),
# $2 target — the permission mode actually being fallen back to. The two
# real call sites below fall back to DIFFERENT targets (see cc_permission_flag
# WHY comment): an unsupported model degrades to the safe `default`
# (permission-prompting) mode, while a backend session degrades to
# `bypassPermissions` — so the warning must name the actual target, not a
# hardcoded one, or it would misreport which mode is now in effect.
_cc_warn_auto_fallback() {
    local sentinel="${TMPDIR:-/tmp}/.cccc-auto-fallback-warned.$$"
    [ -e "$sentinel" ] && return 0
    : > "$sentinel" 2>/dev/null
    echo -e "${YELLOW}warning: auto permission mode unavailable for $1 — falling back to $2${NC}" >&2
}

# Map CC_SET_PERMISSION_MODE (already whitelist-validated by load_settings —
# default|acceptEdits|plan|auto|bypassPermissions) to the claude CLI
# --permission-mode flag. `bypassPermissions` is byte-identical in effect to
# the legacy `--dangerously-skip-permissions` flag it replaces. Defaults to
# `--permission-mode auto` if CC_SET_PERMISSION_MODE is unexpectedly empty
# (e.g. load_settings not yet called) rather than emitting a bare flag.
#
# Args: $1 (optional) is_backend — the resolved backend name (e.g. "mybackend")
# for a `=backend` session, or empty for a normal session. ONLY consulted
# when CC_SET_PERMISSION_MODE=auto.
#
# WHY (Phase 14, BRAND-05 doc/code reconciliation): both the backend-session
# case and the unsupported-model case degrade to the SAME configurable target,
# CC_SET_PERMISSION_MODE_FALLBACK (whitelist-validated by load_settings —
# default|acceptEdits|plan|bypassPermissions; deliberately excludes `auto`
# itself). This replaces an earlier hardcoded-bypassPermissions design: a
# public user's shipped default (PERMISSION_MODE_FALLBACK=default) now means
# BOTH fallback paths degrade to permission-prompting, never silently
# unattended, while a user who explicitly wants unattended fallback (e.g. the
# maintainer, for backend sessions) opts in via
# `cccc config` / PERMISSION_MODE_FALLBACK=bypassPermissions in settings.conf.
cc_permission_flag() {
    local is_backend="${1:-}"
    local mode="${CC_SET_PERMISSION_MODE:-auto}"
    [ -z "$mode" ] && mode="auto"
    local fallback="${CC_SET_PERMISSION_MODE_FALLBACK:-default}"

    if [ "$mode" = "auto" ]; then
        if [ -n "$is_backend" ]; then
            # WHY (T-14-05): cccc_hook_resolve_backend() (start_claude_session,
            # ~line 1120) overrides the actually-served model (e.g. an
            # alternative OpenRouter model) via model_flag/env_prefix WITHOUT ever
            # updating CC_SET_MODEL — so CC_SET_MODEL still reads the
            # Anthropic-tier default (e.g. "sonnet") and
            # auto_mode_supported "$CC_SET_MODEL" would evaluate entitlement
            # against the WRONG (unserved) model. Auto mode against a
            # backend-routed, non-Anthropic model isn't a meaningful concept,
            # so backend sessions always skip the entitlement check entirely
            # and degrade straight to PERMISSION_MODE_FALLBACK — a future
            # Phase 17 contributor should not "simplify" this back to calling
            # auto_mode_supported here.
            _cc_warn_auto_fallback "backend session '$is_backend'" "$fallback"
            mode="$fallback"
        elif ! auto_mode_supported "${CC_SET_MODEL:-}"; then
            _cc_warn_auto_fallback "model '${CC_SET_MODEL:-<default>}'" "$fallback"
            mode="$fallback"
        fi
    fi

    echo "--permission-mode ${mode}"
}

# Compute --model flag from CC_SET_MODEL (SET-03). Empty CC_SET_MODEL means no
# flag (Claude default); a non-empty value becomes --model <value>. Extracted
# so start_claude_session and cmd_continue share one implementation instead of
# two hand-copied blocks (WR-01, 07-REVIEW.md). start_claude_session may still
# override the returned value afterward for the backend case (forces
# --model sonnet regardless of CC_SET_MODEL).
cc_model_flag() {
    [[ -n "$CC_SET_MODEL" ]] && echo "--model ${CC_SET_MODEL}"
}

# Compute the NODE_OPTIONS prefix from CC_SET_MEMORY_LIMIT_MB (SET-04).
# CC_SET_MEMORY_LIMIT_MB=0 intentionally removes the cap (no NODE_OPTIONS
# prefix); any other value sets --max-old-space-size. Uses a NUMERIC compare
# (-ne, not string !=) so non-canonical zero spellings like "00"/"000" —
# which pass write_setting()'s `^[0-9]+$` validation — are also treated as
# "disable the cap", matching the documented `0` behavior instead of silently
# emitting --max-old-space-size=00 (WR-04, 07-REVIEW.md). Extracted so
# start_claude_session and cmd_continue share one implementation (WR-01).
cc_node_opts() {
    if [[ "${CC_SET_MEMORY_LIMIT_MB:-6144}" -ne 0 ]]; then
        echo "NODE_OPTIONS='--max-old-space-size=${CC_SET_MEMORY_LIMIT_MB:-6144}'"
    fi
}

# Build the claude launch command string (pure function — no side effects, no
# tmux call). Every field is self-contained via the ${field:+...} idiom — an
# empty field contributes nothing, a non-empty field always gets exactly one
# separating space, regardless of what the caller passes. Fields 1-2 add
# their separator on the TRAILING side (${field:+${field} }); fields 3-7 add
# it on the LEADING side (${field:+ ${field}}) since they follow claude_bin.
# No caller is required to embed its own trailing/leading space (WR-02,
# 07-REVIEW.md) — a future caller (e.g. a Phase 8 plugin-provided env_prefix)
# cannot silently produce a mashed-together command by forgetting a space.
# Positional params:
#   1 env_prefix       backend env vars, e.g. "ANTHROPIC_API_KEY='' ..."; NO
#                       trailing space needed — the builder adds exactly one
#   2 node_opts        NODE_OPTIONS=...; NO trailing space needed, same as above
#   3 permission_flag  e.g. --dangerously-skip-permissions
#   4 model_flag       e.g. --model sonnet
#   5 session_id_flag  e.g. --session-id <uuid>
#   6 browser_flags    e.g. --mcp-config <path>
#   7 extra_flags      e.g. -c, --resume <id>
#   8 claude_bin       OPTIONAL — defaults to "claude"; reads NO globals
build_claude_launch_cmd() {
    local env_prefix="$1"
    local node_opts="$2"
    local permission_flag="$3"
    local model_flag="$4"
    local session_id_flag="$5"
    local browser_flags="$6"
    local extra_flags="$7"
    local claude_bin="${8:-claude}"

    local cmd="${env_prefix:+${env_prefix} }${node_opts:+${node_opts} }${claude_bin}"
    cmd+="${permission_flag:+ ${permission_flag}}"
    cmd+="${model_flag:+ ${model_flag}}"
    cmd+="${session_id_flag:+ ${session_id_flag}}"
    cmd+="${browser_flags:+ ${browser_flags}}"
    cmd+="${extra_flags:+ ${extra_flags}}"

    # Defensive final step: strip any trailing whitespace before echoing, so the
    # output is byte-clean even if a caller passes a field with its own trailing
    # space.
    printf '%s' "$cmd" | sed -E 's/[[:space:]]+$//'
}

# Start Claude in path (optionally with extra flags like -c)
start_claude_session() {
    local session_name="$1"
    local path="$2"
    local extra_flags="${3:-}"
    local backend="${4:-}"

    # Sanitize: lowercase, no spaces (prevents conflicts like cc-MyApp vs cc-myapp)
    session_name=$(sanitize_session_name "$session_name")

    # Resolve backend config via the cccc_hook_resolve_backend hook point (PLUG-02).
    # MODEL (SET-03): empty CC_SET_MODEL means no --model flag (Claude default);
    # a non-empty value becomes --model <value>. cc_model_flag() (WR-01,
    # 07-REVIEW.md) shares this computation with cmd_continue.
    local model_flag
    model_flag=$(cc_model_flag)
    local env_prefix=""
    local backend_label=""
    if [[ -n "$backend" ]]; then
        # declare -f gate (PLUG-02/PLUG-05): with no backends plugin present,
        # =backend is silently ignored and the session launches plain — the
        # clean public-core degrade. When the plugin IS present, it assigns
        # WITHOUT `local` into model_flag/env_prefix/extra_flags/backend_label
        # above (bash dynamic scope) and returns 1 on an unknown backend name,
        # which aborts this launch exactly as the pre-extraction inline check did.
        if declare -f cccc_hook_resolve_backend >/dev/null 2>&1; then
            cccc_hook_resolve_backend "$backend" || return 1
        fi
    fi

    # Create tmux session and start Claude with flags
    if ! tmux new-session -d -s "$session_name" -c "$path" 2>/dev/null; then
        echo -e "${RED}✗ Session '$session_name' already exists${NC}"
        sleep 2
        return 1
    fi

    # Tag session with backend name and display label for dashboard + recover.
    # Gated behind the SAME declare -f check as the resolution call above (PLUG-08
    # fix, 08-04 checkpoint): without this gate, CC_BACKEND (and therefore the
    # dashboard's [=name] badge, cc/cc:342-345) got set from the raw "=name" string
    # even when no backends plugin was loaded to resolve it — the session silently
    # launched plain (correct) but the badge lied about which backend was active.
    if [[ -n "$backend" ]] && declare -f cccc_hook_resolve_backend >/dev/null 2>&1; then
        tmux set-environment -t "$session_name" CC_BACKEND "$backend"
    fi
    tmux set-environment -t "$session_name" CC_SESSION_LABEL "$session_name"

    # Set terminal title in format "/folder:session-name"
    local terminal_title
    terminal_title=$(format_terminal_title "$session_name" "$path")
    # Strip single quotes — the title is spliced into a single-quoted string sent
    # to the pane shell; an apostrophe (e.g. folder "Client's Work") would
    # unbalance the quote and swallow the following claude launch command.
    terminal_title="${terminal_title//\'/}"
    tmux send-keys -t "$session_name" "echo -ne '\\033]0;${terminal_title}\\007'" C-m
    # Persist the name↔session-id mapping AT CREATION so `recover` can restore the
    # real name after a crash. Previously the mapping was written only on explicit
    # kill (_save_session_name_before_kill), so hard-crashed sessions (e.g. an OOM
    # crash) left NO mapping and came back with generic names. For a genuinely NEW
    # session we mint the UUID ourselves and pass it via `--session-id`; for
    # --continue/--resume/--fork the id already exists, so we only (re)record the
    # name when an explicit `--resume <id>` is present.
    local session_id_flag=""
    mkdir -p "$CONFIG_DIR/session-names"
    if [[ "$extra_flags" =~ (^|[[:space:]])-c($|[[:space:]]) ]] \
       || [[ "$extra_flags" =~ (^|[[:space:]])-r($|[[:space:]]) ]] \
       || [[ "$extra_flags" == *"--continue"* ]] \
       || [[ "$extra_flags" == *"--resume"* ]] \
       || [[ "$extra_flags" == *"--fork-session"* ]]; then
        if [[ "$extra_flags" =~ --resume[[:space:]]+([0-9a-fA-F-]+) ]]; then
            printf '%s' "$session_name" > "$CONFIG_DIR/session-names/${BASH_REMATCH[1]}"
        fi
    else
        local new_sid
        new_sid=$(uuidgen 2>/dev/null | tr 'A-Z' 'a-z')
        if [[ "$new_sid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
            session_id_flag="--session-id ${new_sid}"
            printf '%s' "$session_name" > "$CONFIG_DIR/session-names/${new_sid}"
        fi
    fi

    # Browser capability (Chrome integration + playwright/chrome-devtools MCPs)
    # is OPT-IN, not default. It costs a Chrome renderer (~0.3 GB) plus the two
    # browser MCP stdio children (~0.5 GB) per session, and almost every session
    # never browses. A caller opts in by putting --chrome in extra_flags (dashboard
    # suffix -b, or an external orchestration workflow for browser-testing workers); we then also
    # load the browser MCP servers via --mcp-config. They were removed from
    # user-scope ~/.claude.json, so a DEFAULT session now spawns zero browser
    # processes and connects only to the shared HTTP gateways.
    local browser_flags=""
    if [[ "$extra_flags" == *"--chrome"* ]]; then
        local _browser_mcp="$CONFIG_DIR/browser-mcp.json"
        [[ -f "$_browser_mcp" ]] && browser_flags="--mcp-config ${_browser_mcp}"
    fi

    # Cap V8 old-space per session so a single runaway session aborts instead of
    # dragging the whole Mac into swap (a memory-exhaustion incident).
    # MEMORY_LIMIT_MB (SET-04): CC_SET_MEMORY_LIMIT_MB=0 intentionally removes
    # the cap (no NODE_OPTIONS prefix); any other value sets --max-old-space-size.
    # cc_node_opts() (WR-01/WR-04, 07-REVIEW.md) shares this computation with
    # cmd_continue and uses a numeric compare so "00"/"000" also disable the cap.
    local node_opts
    node_opts=$(cc_node_opts)

    # Start Claude session (with optional alternative backend env vars).
    # EXTRA_FLAGS (SET-05) is combined into a FRESH local here, strictly AFTER
    # the session-id-minting block and the browser-detection block above have
    # already read and finalized the original per-call extra_flags — appending
    # any earlier would let a global CC_SET_EXTRA_FLAGS value containing -c or
    # --chrome silently alter session-id minting or browser-MCP loading. The
    # per-call extra_flags (and BACKEND_EXTRA_FLAGS already merged into it
    # above) are preserved; CC_SET_EXTRA_FLAGS is appended on top.
    local _combined_extra="$extra_flags"
    if [[ -n "$CC_SET_EXTRA_FLAGS" ]]; then
        _combined_extra="${_combined_extra}${_combined_extra:+ }${CC_SET_EXTRA_FLAGS}"
    fi
    # AUTO_TRUST always-mode (TRUST-02): silently pre-trust this path before
    # every spawn. CC_SET_AUTO_TRUST is already a global set once by
    # load_settings() at script start — no extra load_settings call needed
    # here. No TTY guard: "always" is intentionally silent/non-interactive
    # by design, unlike on-add's consent prompt above.
    if [[ "$CC_SET_AUTO_TRUST" == "always" ]]; then
        trust_path_defensively "$path"
    fi

    # CLAUDE_BIN (SET-05) is passed as the builder's 8th positional argument —
    # the builder reads no globals for it, staying a pure function of its inputs.
    local launch_cmd
    launch_cmd=$(build_claude_launch_cmd "$env_prefix" "$node_opts" "$(cc_permission_flag "$backend")" "$model_flag" "$session_id_flag" "$browser_flags" "$_combined_extra" "$CC_SET_CLAUDE_BIN")
    tmux send-keys -t "$session_name" "$launch_cmd" C-m

    if [ -n "$extra_flags" ]; then
        echo "✓ Session '$session_name' started (${extra_flags})${backend_label}"
    else
        echo "✓ Session '$session_name' started${backend_label}"
    fi
}

# Persist session name → UUID mapping before killing, so recover can show names.
# Reads CC_SESSION_LABEL from tmux env, finds the most-recently-touched .jsonl
# in the session's project dir, and writes ~/.config/claude-control/session-names/<uuid>.
_save_session_name_before_kill() {
    local session_name="$1"
    local label proj_path hash proj_dir newest_jsonl uuid

    label=$(tmux showenv -t "$session_name" CC_SESSION_LABEL 2>/dev/null | cut -d= -f2)
    [[ -z "$label" ]] && return 0

    proj_path=$(tmux display-message -p -F "#{session_path}" -t "$session_name" 2>/dev/null)
    [[ -z "$proj_path" ]] && return 0

    hash="-$(printf '%s' "${proj_path#/}" | tr '/ ' '--')"
    proj_dir="$CLAUDE_PROJECTS_DIR/${hash}"
    [[ -d "$proj_dir" ]] || return 0

    # shellcheck disable=SC2010  # `ls -t` mtime-sort has no glob equivalent; filenames here are Claude-generated UUID.jsonl (safe charset)
    newest_jsonl=$(ls -t "$proj_dir"/*.jsonl 2>/dev/null | grep -v '/subagents/' | head -1)
    [[ -z "$newest_jsonl" ]] && return 0

    uuid=$(basename "$newest_jsonl" .jsonl)
    mkdir -p "$CONFIG_DIR/session-names"
    printf '%s' "$label" > "$CONFIG_DIR/session-names/$uuid"
}

# Kill session and any associated conductor/limit-watcher sessions
kill_session() {
    local session_name="$1"
    # CR-01/T-10-02: empty-target guard — an empty -t target kills the current
    # default-socket session ("empty-target kill footgun"), never the intended one.
    [[ -z "$session_name" ]] && return 0
    _save_session_name_before_kill "$session_name"
    # Exact-match ('=' prefix, cc/cc:3701 convention) — an unprefixed target
    # prefix-matches, so kill_session("cc-foo") could kill a live "cc-foo-2".
    tmux kill-session -t "=$session_name" 2>/dev/null
    # GSD companion kill (pattern: cc-PROJ-gsd) routes through cccc_hook_on_kill_session
    # (PLUG-04) — a declare -f gate so this degrades to a clean no-op when the
    # private GSD companion plugin is absent.
    if declare -f cccc_hook_on_kill_session >/dev/null 2>&1; then
        cccc_hook_on_kill_session "$session_name"
    fi
    # limit-watcher kill stays in Core (Phase 9 owns limit-watcher).
    tmux kill-session -t "=limit-watcher-${session_name}" 2>/dev/null
}

# Active-processing indicators — Claude Code shows these ONLY while a tool/agent runs.
# Copied VERBATIM from heartbeat.sh (source of truth for status detection) so `cc json`
# classifies sessions identically to an external orchestration workflow's own busy detection.
# CRITICAL: an empty ❯ prompt is NOT sufficient for "idle" on its own — it is also
# rendered WHILE tools run in the background. See detect_session_status() Layer 3.
IDLE_BUSY_PATTERN='esc to interrupt|to run in background|[0-9]+ tool uses|↓ [0-9.]+k tokens|\([0-9]+m [0-9]+s'

# Point-in-time 3-layer session status classifier: hook-observer -> busy-pattern -> idle-check.
# Args: <session_name>
# Echoes exactly one of: working | waiting | idle
# Layer ordering MUST NOT change — see 00-CONTEXT.md / heartbeat.sh footgun notes.
# Core "asleep" test given a pane's pid + foreground command. A session is
# asleep when its tmux pane is alive but no claude process runs in it — the
# idle-watchdog reclaimed it (SIGTERM'd claude after idle days) or it was quit
# manually; the pane/cwd/scrollback survive and it resumes via
# `claude --resume <id>`. Mirrors claude-idle-watchdog's claude_pid_for(). No
# tmux fork here (only the pgrep for shell-foreground panes) so it is cheap
# enough for the dashboard's per-row batch data AND factored as the single
# source of truth for the shell list, shared with session_is_asleep() below.
_pane_data_is_asleep() {
    local ppid="$1" pcmd="$2"
    case "$pcmd" in
        zsh|-zsh|bash|-bash|sh|-sh|fish|login|tcsh) ;;
        *) return 1 ;;
    esac
    [ -n "$ppid" ] && ! pgrep -P "$ppid" -f '(^|/)claude( |$)' >/dev/null 2>&1
}

# Per-session asleep check (one tmux query for the pane pid + foreground
# command, then the shared _pane_data_is_asleep test). Used by
# detect_session_status (→ cc json and any direct caller); the dashboard uses
# _pane_data_is_asleep directly with its batch pane data to avoid this fork.
session_is_asleep() {
    local sess="$1" info
    [ -z "$sess" ] && return 1
    # list-panes (not display-message) because it honors the '=' exact-match
    # prefix — display-message treats "=name" as a literal target and returns
    # empty. Pick the ACTIVE pane's pid + foreground command.
    info=$(tmux list-panes -t "=$sess" -F '#{pane_active}|#{pane_pid}|#{pane_current_command}' 2>/dev/null \
           | awk -F'|' '$1==1{print $2"|"$3; exit}')
    [ -z "$info" ] && return 1
    _pane_data_is_asleep "${info%%|*}" "${info#*|}"
}

detect_session_status() {
    local session_name="$1"

    # ─── Layer 0: asleep (pane alive, no claude process) ──────────────────
    # Highest priority and authoritative: a session with no claude process
    # cannot be working or waiting. Returning here also SKIPS the expensive
    # Layer-2 capture-pane below, so classifying an asleep session is cheaper,
    # not costlier. Runs only when the caller passes NO mode hint (cc json /
    # direct callers). The dashboard passes "awake" — it already ruled asleep
    # out from batch pane data — so this per-session fork is skipped on the hot
    # render path.
    if [ -z "${2:-}" ] && session_is_asleep "$session_name"; then
        echo "asleep"
        return 0
    fi

    # ─── Layer 1: hook-observer file (highest priority) ───────────────────
    # Derive KEY matching gsd-worker-state.sh out_key / heartbeat.sh exactly:
    #   strip :window suffix, then tr non-alnum/._- to '_'.
    local stripped key statedir notify_file event
    stripped="${session_name%%:*}"
    key=$(printf '%s' "$stripped" | tr -c 'A-Za-z0-9._-' '_' 2>/dev/null || true)
    statedir="${GSD_WORKER_STATE_DIR:-$HOME/.claude/gsd-worker/worker-state}"
    notify_file="$statedir/$key.notify.json"
    event=$(jq -r '.event // empty' "$notify_file" 2>/dev/null)

    case "$event" in
        permission_prompt|elicitation_dialog)
            echo "waiting"
            return 0
            ;;
        idle_prompt)
            : # Do not resolve here — fall through to Layer 3 to confirm genuine idle.
            ;;
    esac

    # Fast path (DASH-05): callers that only need Layer-1 attention detection
    # pass "cheap" as $2 to skip the Layer-2 capture-pane entirely. Used by the
    # dashboard for DETACHED sessions — genuine "waiting on the user" for those
    # is owned by Layer 1 (hook events) anyway, and anything not resolved as
    # "waiting" above is reported "idle", which the renderer remaps to
    # "detached". This keeps a full dashboard redraw from paying one extra
    # capture-pane per detached session on every keystroke.
    if [ "${2:-}" = "cheap" ]; then
        echo "idle"
        return 0
    fi

    # ─── Layer 2: busy-pattern (pane content) ──────────────────────────────
    local output
    output=$(tmux capture-pane -t "$session_name" -p -S -80 2>/dev/null)

    if echo "$output" | grep -qE "$IDLE_BUSY_PATTERN"; then
        echo "working"
        return 0
    fi

    # A visible selection/menu dialog (multiple option lines led by "❯" that is NOT the
    # empty-prompt form) means the session is waiting on the user, not idle.
    # Deviation (Rule 1 — bug found during verification): restrict this check to the LAST
    # few rendered lines only, not the whole -80 capture window. A live menu is always the
    # most recent thing on screen; scanning the full window instead matched unrelated
    # "❯ <old prompt text>" lines from EARLIER turns still in scrollback, producing false
    # "waiting" results for any multi-turn session with 2+ prior non-empty prompts.
    if [[ "$(echo "$output" | tail -10 | grep -cE '^❯ ')" -ge 2 ]]; then
        echo "waiting"
        return 0
    fi

    # ─── Layer 3: idle (default) ─────────────────────────────────────────────
    # USER-FACING POLICY: for external clients consuming `cc json`, the `status`
    # field is a "needs YOUR attention" signal. The user only wants YELLOW
    # ("waiting") when Claude is actually asking a question — a permission
    # prompt, an elicitation/AskUserQuestion dialog (both caught by Layer 1),
    # or a visible on-screen selection menu (Layer 2). Everything that merely
    # stands still — a finished turn, an oracle at rest, a session whose input
    # box isn't a byte-perfect empty "❯" line — must read as IDLE (neutral),
    # NOT yellow.
    #
    # This deliberately REVERSES an earlier "ambiguous -> waiting" bias: that
    # over-flagging was a safe default for gating an autonomous orchestration
    # workflow, but as a user-facing dashboard color it is exactly the noise
    # the user complained about (every standing-still session showing
    # yellow). So anything reaching Layer 3 is now IDLE by definition —
    # genuine "waiting on the user" is owned ENTIRELY by Layer 1 (hook
    # events) and Layer 2 (visible menu) above.
    #
    # SCOPE: this is the `cc json` copy only. An external heartbeat/busy
    # detector reading this same status (source of truth for autonomous
    # worker decisions) is intentionally NOT touched here — its conservative
    # "not empty -> not idle" bias stays the safe default for that use case.
    # The two copies deliberately diverge here.
    echo "idle"
}


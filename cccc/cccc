# RATE LIMIT HANDLING
# ============================================================================

# Check if a limit-watcher daemon is running for a session.
# Returns 0 (true) if "limit-watcher-<session_name>" tmux session exists, else 1.
# Pure — no output.
is_watcher_active() {
    local session_name="$1"
    # CR-01/T-10-02: empty-target guard — never issue a tmux call with an empty target.
    [[ -z "$session_name" ]] && return 1
    # Exact-match ('=' prefix, cc/cc:3701 convention).
    tmux has-session -t "=limit-watcher-${session_name}" 2>/dev/null
}

# Start a background limit-watcher daemon for a session.
start_limit_watcher() {
    local session_name="$1"
    # CR-01/T-10-02: empty-target guard.
    [[ -z "$session_name" ]] && return 1
    if is_watcher_active "$session_name"; then
        echo -e "${YELLOW}⚠ already watching ${session_name}${NC}"
        return 0
    fi
    if tmux new-session -d -s "limit-watcher-${session_name}" \
        -- bash "$CC_SCRIPT_DIR/limit-watcher.sh" "${session_name}"; then
        echo -e "${GREEN}${ICON_WATCHING} watcher started for ${session_name}${NC}"
    else
        echo -e "${RED}✗ failed to start watcher for ${session_name}${NC}"
        return 1
    fi
}

# Gate automatic (non-interactive) watcher startup behind CC_SET_LIMIT_WATCHER.
# Only called from automatic session-spawn call sites; the cccc limit panel and the
# watch<number> quick-command call start_limit_watcher() directly and stay ungated.
# Always returns 0 so a caller's control flow is never aborted by this gate.
maybe_start_limit_watcher() {
    [ "${CC_SET_LIMIT_WATCHER:-auto}" = "auto" ] && start_limit_watcher "$1"
    return 0
}

# Stop a running limit-watcher daemon for a session.
stop_limit_watcher() {
    local session_name="$1"
    # CR-01/T-10-02: empty-target guard.
    [[ -z "$session_name" ]] && return 0
    if ! is_watcher_active "$session_name"; then
        echo -e "${GRAY}no watcher running for ${session_name}${NC}"
        return 0
    fi
    # Exact-match ('=' prefix, cc/cc:3701 convention).
    tmux kill-session -t "=limit-watcher-${session_name}" 2>/dev/null
    echo -e "${GREEN}✓ watcher stopped for ${session_name}${NC}"
}

# CLEANUP-03/04: in-process replacement for the retired scripts/watcher-cleanup.sh
# launchd daemon. Ported near-verbatim from its exact-match sweep loop (git history:
# scripts/watcher-cleanup.sh lines 47-69) — see 10-PATTERNS.md "sweep_orphaned_watchers()".
# Kills any limit-watcher-* tmux session whose target session no longer exists.
#
# Dropped vs. the daemon version (all launchd-specific scaffolding):
#   - No LOCKDIR mkdir-lock: unnecessary here — show_dashboard() has only one
#     in-flight caller (interactive_mode()'s render loop), and the sweep itself
#     is idempotent/self-healing (a kill on an already-gone session is a
#     harmless no-op via `2>/dev/null`) per 10-RESEARCH.md Pitfall 4.
#   - No log rotation / dedicated log file — launchd-only concern.
#   - No explicit PATH export — cc/cc already resolves tmux interactively.
# Kept: `unset TMUX` — per 10-RESEARCH.md ("TMUX env beats TMUX_TMPDIR" when tmux
# resolves "current session"), scoped to a subshell so it never leaks into the
# rest of the interactive dashboard process.
sweep_orphaned_watchers() {
    (
        unset TMUX
        local watcher target
        while IFS= read -r watcher; do
            # Malformed-name guard (e.g. a bare "limit-watcher-" session) — never
            # act on an empty target.
            target="${watcher#limit-watcher-}"
            [[ -z "$watcher" || -z "$target" ]] && continue

            # Exact-match existence check ('=' prefix, cc/cc:3701 convention) — a
            # limit-watcher-a orphan must never be affected by limit-watcher-ab's
            # target existing.
            if tmux has-session -t "=$target" 2>/dev/null; then
                : # target still alive — keep the watcher
            else
                tmux kill-session -t "=$watcher" 2>/dev/null
            fi
        done < <(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^limit-watcher-" || true)
    )
}

# Scan a session for rate limit and extract reset time
# Returns: "HH:MM|TIMEZONE" or empty if no limit
scan_session_rate_limit() {
    local session_name="$1"
    local output

    # Capture last 50 lines of output
    output=$(tmux capture-pane -t "$session_name" -p -S -50 2>/dev/null)

    if [[ -z "$output" ]]; then
        echo ""
        return 1
    fi

    # Check for specific Claude rate limit messages
    # Pattern 1: "resets 12am (Europe/Berlin)" - with timezone
    # Pattern 2: "resets 12am" - without timezone (uses system default)
    local reset_line time_part tz_part

    # Try with timezone first
    reset_line=$(echo "$output" | grep -oE 'resets [0-9]{1,2}(:[0-9]{2})?(am|pm) \([^)]+\)' | tail -1)

    if [[ -n "$reset_line" ]]; then
        time_part=$(echo "$reset_line" | sed -E 's/resets ([0-9]{1,2}(:[0-9]{2})?(am|pm)) .*/\1/')
        tz_part=$(echo "$reset_line" | sed -E 's/.*\(([^)]+)\)/\1/')
        echo "${time_part}|${tz_part}"
        return 0
    fi

    # Try without timezone
    reset_line=$(echo "$output" | grep -oE 'resets [0-9]{1,2}(:[0-9]{2})?(am|pm)' | tail -1)

    if [[ -n "$reset_line" ]]; then
        time_part=$(echo "$reset_line" | sed -E 's/resets ([0-9]{1,2}(:[0-9]{2})?(am|pm))/\1/')
        echo "${time_part}|"
        return 0
    fi

    # Check for definitive rate limit indicators (must be in UI context, not command output)
    # Looking for specific Claude messages like "out of extra usage" or "/rate-limit-options"
    if echo "$output" | grep -qE '(out of extra usage|/rate-limit-options)'; then
        echo "UNKNOWN|"
        return 0
    fi

    echo ""
    return 1
}

# Convert 12-hour time to epoch seconds for today/tomorrow
# Args: time (e.g., "12am", "1:30pm"), timezone (e.g., "Europe/Berlin")
# Returns: epoch seconds
parse_reset_time() {
    local time_str="$1"
    local tz="$2"

    # Default timezone if not specified
    tz="${tz:-Europe/Berlin}"

    # Parse hour and minute
    local hour minute ampm
    if [[ "$time_str" =~ ^([0-9]{1,2}):([0-9]{2})(am|pm)$ ]]; then
        hour="${BASH_REMATCH[1]}"
        minute="${BASH_REMATCH[2]}"
        ampm="${BASH_REMATCH[3]}"
    elif [[ "$time_str" =~ ^([0-9]{1,2})(am|pm)$ ]]; then
        hour="${BASH_REMATCH[1]}"
        minute="00"
        ampm="${BASH_REMATCH[2]}"
    else
        echo "0"
        return 1
    fi

    # Convert to 24-hour format
    hour=$((10#$hour))  # Force base 10
    if [[ "$ampm" == "am" ]]; then
        [[ $hour -eq 12 ]] && hour=0
    else
        [[ $hour -ne 12 ]] && hour=$((hour + 12))
    fi

    # Get current date parts in target timezone
    local now_epoch today_date
    now_epoch=$(date +%s)
    today_date=$(TZ="$tz" date +"%Y-%m-%d")

    # Build target datetime string
    local target_time_str
    target_time_str=$(printf "%s %02d:%s:00" "$today_date" "$hour" "$minute")

    # Convert to epoch (macOS)
    local target_epoch
    target_epoch=$(TZ="$tz" date -j -f "%Y-%m-%d %H:%M:%S" "$target_time_str" +%s 2>/dev/null)

    if [[ -z "$target_epoch" ]] || [[ "$target_epoch" == "0" ]]; then
        # Fallback for Linux
        target_epoch=$(TZ="$tz" date -d "$target_time_str" +%s 2>/dev/null)
    fi

    if [[ -z "$target_epoch" ]]; then
        echo "0"
        return 1
    fi

    # If target time is in the past, it means tomorrow
    if (( target_epoch <= now_epoch )); then
        target_epoch=$((target_epoch + 86400))
    fi

    echo "$target_epoch"
}

# Send continue command to a session
# Sequence: Enter (confirm dialog) -> wait -> "continue" -> wait -> Enter
send_continue_command() {
    local session_name="$1"

    # Step 1: Press Enter to confirm "stop and wait" dialog
    tmux send-keys -t "$session_name" C-m
    sleep 1

    # Step 2: Type "continue"
    tmux send-keys -t "$session_name" "continue"
    sleep 1

    # Step 3: Dismiss autocomplete dropdown before submitting
    # "continue" triggers autocomplete in Claude Code's input field;
    # without Escape, C-m selects the suggestion instead of submitting
    tmux send-keys -t "$session_name" Escape
    sleep 0.2

    # Step 4: Press Enter to submit
    tmux send-keys -t "$session_name" C-m
}

# Limit Watcher Manager — interactive control panel for background rate-limit watchers.
# Lists all cc-* sessions, shows per-session watcher/rate-limit status, lets the
# user start/stop daemons without blocking.
cmd_rate_limit() {
    while true; do
        echo ""
        echo -e "${CYAN}${ICON_WATCHING} LIMIT WATCHER MANAGER${NC}"
        echo -e "${GRAY}────────────────────────────────────────────────────────${NC}"

        # Collect all watchable sessions: all tmux sessions except limit-watcher-* and conductor-* daemons.
        # Includes both cc sessions (cc-*) and GSD worker sessions (e.g. autobooks-worker).
        declare -a m_names m_attached m_display_nums
        m_names=()
        m_attached=()
        m_display_nums=()

        # Collect current tmux state for attached-status lookup (bash 3.2 compat, no assoc arrays)
        declare -a _all_snames _all_sattached
        _all_snames=()
        _all_sattached=()
        while IFS='|' read -r _sn _sp _sa _sw; do
            [[ -z "$_sn" ]] && continue
            _all_snames+=("$_sn")
            _all_sattached+=("$_sa")
        done < <(get_tmux_sessions)

        if [[ -n "${CC_SESSION_NAMES:-}" ]]; then
            # Use dashboard order + numbers (set by show_dashboard) so limit manager matches main view
            local _sess_names=() _sess_nums=()
            while IFS= read -r _l; do [ -n "$_l" ] && _sess_names+=("$_l"); done <<< "$CC_SESSION_NAMES"
            while IFS= read -r _l; do [ -n "$_l" ] && _sess_nums+=("$_l"); done <<< "$CC_SESSION_NUMBERS"
            local _j
            for _j in "${!_sess_names[@]}"; do
                local _sn="${_sess_names[$_j]}"
                [[ "$_sn" =~ ^limit-watcher- ]] && continue
                [[ "$_sn" =~ ^conductor- ]] && continue
                local _sa="0" _k
                for _k in "${!_all_snames[@]}"; do
                    if [[ "${_all_snames[$_k]}" == "$_sn" ]]; then
                        _sa="${_all_sattached[$_k]}"; break
                    fi
                done
                m_names+=("$_sn")
                m_attached+=("$_sa")
                m_display_nums+=("${_sess_nums[$_j]}")
            done
        else
            # Fallback when called directly via 'cc limit' (no dashboard context): alphabetical
            local _fallback_i=1 _j
            for _j in "${!_all_snames[@]}"; do
                local _sn="${_all_snames[$_j]}"
                [[ "$_sn" =~ ^limit-watcher- ]] && continue
                [[ "$_sn" =~ ^conductor- ]] && continue
                m_names+=("$_sn")
                m_attached+=("${_all_sattached[$_j]}")
                m_display_nums+=("$_fallback_i")
                ((_fallback_i++))
            done
        fi

        local count="${#m_names[@]}"

        if [[ "$count" -eq 0 ]]; then
            echo -e "${GRAY}  No sessions found.${NC}"
        else
            for (( i=0; i<count; i++ )); do
                local sess="${m_names[$i]}"
                local attached="${m_attached[$i]}"
                local status_icon=" "
                local status_label

                if is_watcher_active "$sess"; then
                    status_icon="${ICON_WATCHING}"
                    status_label="watching"
                else
                    local info
                    info=$(scan_session_rate_limit "$sess")
                    if [[ -n "$info" ]]; then
                        local time_part tz_part
                        time_part=$(echo "$info" | cut -d'|' -f1)
                        tz_part=$(echo "$info" | cut -d'|' -f2)
                        if [[ "$time_part" == "UNKNOWN" ]]; then
                            status_label="⏸ rate-limited (reset time unknown)"
                        else
                            local epoch wait_mins
                            epoch=$(parse_reset_time "$time_part" "$tz_part")
                            wait_mins=$(( (epoch - $(date +%s) + 59) / 60 ))
                            status_label="⏸ rate-limited  resets ${time_part} (${tz_part:-local}) in ${wait_mins} min"
                        fi
                    elif [[ "$attached" == "1" ]]; then
                        status_label="active"
                    else
                        status_label="detached"
                    fi
                fi

                printf "  ${CYAN}%2d${NC}  %s %-40s %s\n" \
                    "${m_display_nums[$i]}" "$status_icon" "$sess" "$status_label"
            done
        fi

        echo -e "${GRAY}────────────────────────────────────────────────────────${NC}"
        echo -e "${GRAY}Commands:  watch N[,M,...] | w N[,M,...] | watch a   start watcher(s)${NC}"
        echo -e "${GRAY}           k N[,M,...]                              stop watcher(s)${NC}"
        echo -e "${GRAY}           q / <Enter>                              quit${NC}"
        read -e -r line

        # Trim leading/trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        # Empty or q → exit manager
        if [[ -z "$line" ]] || [[ "$line" == "q" ]] || [[ "$line" == "Q" ]]; then
            break
        fi

        # Parse: first token is command, rest is arg
        local cmd arg
        cmd="${line%% *}"
        cmd=$(echo "$cmd" | tr '[:upper:]' '[:lower:]')
        arg="${line#* }"
        [[ "$arg" == "$line" ]] && arg=""  # no space → no arg
        arg="${arg#"${arg%%[![:space:]]*}"}"  # trim leading whitespace from arg

        if [[ "$cmd" != "watch" ]] && [[ "$cmd" != "w" ]] && [[ "$cmd" != "k" ]]; then
            echo -e "${RED}✗ unknown command: '${cmd}'${NC}"
            sleep 1
            continue
        fi

        if [[ "$count" -eq 0 ]]; then
            echo -e "${RED}✗ no sessions to act on${NC}"
            sleep 1
            continue
        fi

        # Build selected index list
        local -a selected_indices
        selected_indices=()
        if [[ "$arg" == "a" ]] || [[ "$arg" == "A" ]]; then
            for (( i=0; i<count; i++ )); do selected_indices+=("$i"); done
        else
            local invalid=false
            IFS=',' read -ra tokens <<< "$arg"
            for tok in "${tokens[@]}"; do
                tok="${tok#"${tok%%[![:space:]]*}"}"
                tok="${tok%"${tok##*[![:space:]]}"}"
                if ! [[ "$tok" =~ ^[0-9]+$ ]]; then
                    echo -e "${RED}✗ invalid selection: '${tok}'${NC}"
                    invalid=true
                    break
                fi
                local _found_idx=-1 _k
                for _k in "${!m_display_nums[@]}"; do
                    if [[ "${m_display_nums[$_k]}" == "$tok" ]]; then
                        _found_idx="$_k"; break
                    fi
                done
                if (( _found_idx == -1 )); then
                    echo -e "${RED}✗ invalid selection: '${tok}'${NC}"
                    invalid=true
                    break
                fi
                selected_indices+=("$_found_idx")
            done
            $invalid && { sleep 1; continue; }
        fi

        if [[ "${#selected_indices[@]}" -eq 0 ]]; then
            echo -e "${RED}✗ no selection provided${NC}"
            sleep 1
            continue
        fi

        local action
        if [[ "$cmd" == "watch" ]] || [[ "$cmd" == "w" ]]; then
            action="start_limit_watcher"
        else
            action="stop_limit_watcher"
        fi

        for idx in "${selected_indices[@]}"; do
            "$action" "${m_names[$idx]}"
        done
        # Small pause so output is readable before re-render
        sleep 0.5
    done
}

# Kill all sessions in a project path
kill_project_sessions() {
    local path="$1"
    local killed=0

    while IFS='|' read -r sess_name sess_path sess_attached sess_windows; do
        if [ "$sess_path" = "$path" ]; then
            kill_session "$sess_name"
            ((killed++))
        fi
    done < <(get_tmux_sessions)

    echo "✓ $killed session(s) terminated"
}

# Attach to session
attach_session() {
    local session_name="$1"

    # Get session_path from tmux
    local session_path
    session_path=$(tmux display-message -p -t "$session_name" '#{session_path}' 2>/dev/null)

    # Set terminal title in format "/folder:session-name"
    local terminal_title
    terminal_title=$(format_terminal_title "$session_name" "$session_path")
    echo -ne "\033]0;${terminal_title}\007"

    # Attach and set title in tmux
    tmux attach-session -t "$session_name"

    # On detach, reset terminal title so cc dashboard doesn't keep stale title
    reset_terminal_title
}


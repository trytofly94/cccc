            local proj_path="${project_paths[$project_index]}"
            local proj_title="${project_titles[$project_index]}"

            # Check if project has .planning/ROADMAP.md
            if [[ ! -f "$proj_path/.planning/ROADMAP.md" ]]; then
                echo -e "${RED}✗ Project '${proj_title}' has no .planning/ROADMAP.md${NC}"

        # === LETTER COMMANDS (Projects) ===

        # New session in project: "an[modifiers][name]"
        # Modifiers (order-independent, name always last):
        #   -cf / -c / -r / -p / -v   Claude flags
        #   limit                     auto-start limit-watcher
        #   =<backend>                use alternative backend (provided by a local plugin)
        # Examples: an  anlimit  an-c  an=myBackend  an-c=myBackend  anlimit-cNAME  an=myBackendNAME
        if [[ "$choice" =~ ^(zz[a-z]|z[a-z]|[a-z])n(.*)$ ]]; then
            local _letter="${BASH_REMATCH[1]}"
            local _tok="${BASH_REMATCH[2]# }"   # strip one optional leading space
            local _flag="" _flag_label="" _watcher="" _backend="" _browser=""

            # Consume modifiers from the front in any order (loop until stable)
            local _again=true
            while $_again; do
                _again=false
                if [[ "$_tok" == -cf* ]] && [[ -z "$_flag" ]]; then
                    _flag="-c --fork-session"; _flag_label="with --continue --fork-session"
                    _tok="${_tok#-cf}"; _again=true
                elif [[ "$_tok" == -c* ]] && [[ -z "$_flag" ]]; then
                    _flag="-c"; _flag_label="with --continue"
                    _tok="${_tok#-c}"; _again=true
                elif [[ "$_tok" == -r* ]] && [[ -z "$_flag" ]]; then
                    _flag="-r"; _flag_label="with --resume"
                    _tok="${_tok#-r}"; _again=true
                elif [[ "$_tok" == -p* ]] && [[ -z "$_flag" ]]; then
                    _flag="--permission-mode plan"; _flag_label="in plan mode"
                    _tok="${_tok#-p}"; _again=true
                elif [[ "$_tok" == -v* ]] && [[ -z "$_flag" ]]; then
                    _flag="--verbose"; _flag_label="with --verbose"
                    _tok="${_tok#-v}"; _again=true
                elif [[ "$_tok" == -b* ]] && [[ -z "$_browser" ]]; then
                    # Browser opt-in — orthogonal to -c/-r/-p/-v, so its own slot.
                    _browser="--chrome"; _flag_label="${_flag_label:+${_flag_label} }with browser"
                    _tok="${_tok#-b}"; _again=true
                elif [[ "$_tok" == limit* ]] && [[ -z "$_watcher" ]]; then
                    _watcher="watcher"
                    _tok="${_tok#limit}"; _again=true
                elif [[ "$_tok" == =* ]] && [[ -z "$_backend" ]]; then
                    # =backend or =backend=name — at start/middle
                    local _btok="${_tok#=}"
                    if [[ "$_btok" =~ ^([A-Za-z0-9_-]+)=(.*)$ ]]; then
                        # =backend=name  →  backend + remaining name
                        _backend="${BASH_REMATCH[1]}"
                        _tok="${BASH_REMATCH[2]}"
                    elif [[ "$_btok" =~ ^([A-Za-z0-9_-]+)(.*)$ ]]; then
                        # =backend  →  backend, rest is name (may be empty)
                        _backend="${BASH_REMATCH[1]}"
                        _tok="${BASH_REMATCH[2]}"
                    fi
                    _again=true
                fi
            done

            # Also detect name=backend at end (e.g. zsnmyname=myBackend)
            if [[ -z "$_backend" && "$_tok" =~ ^(.+)=([A-Za-z0-9_-]+)$ ]]; then
                _tok="${BASH_REMATCH[1]}"
                _backend="${BASH_REMATCH[2]}"
            fi

            [[ -n "$_backend" ]] && _flag_label="${_flag_label:+${_flag_label} }via =${_backend}"

            # Fold the orthogonal browser opt-in into the claude flag string.
            local _allflags="$_flag"
            [[ -n "$_browser" ]] && _allflags="${_allflags:+${_allflags} }--chrome"
            prompt_new_session_for_project "$_letter" "$_allflags" "$_flag_label" "$_tok" "$_watcher" "$_backend"
            continue
        fi

        # Kill all sessions in project: "ak"
        if [[ "$choice" =~ ^(zz[a-z]|z[a-z]|[a-z])k$ ]]; then
            local letter="${BASH_REMATCH[1]}"

            # Find project
            local project_index=-1
            for i in "${!project_letters[@]}"; do
                if [ "${project_letters[$i]}" = "$letter" ]; then
                    project_index=$i
                    break
                fi
            done

            if [ "$project_index" -eq -1 ]; then
                echo -e "${RED}✗ Invalid project: $letter${NC}"
                sleep 2
                continue
            fi

            local proj_path="${project_paths[$project_index]}"
            local proj_title="${project_titles[$project_index]}"

            # Count how many sessions this would kill, and REQUIRE explicit
            # confirmation — killing every session in a project at once is
            # destructive and must never happen on a single stray keypress.
            local _kn=0 _ksp
            for _ksp in "${session_paths[@]}"; do
                [ "$_ksp" = "$proj_path" ] && _kn=$((_kn + 1))
            done

            echo ""
            if [ "$_kn" -eq 0 ]; then
                echo -e "${GRAY}No sessions to kill in '${proj_title}'.${NC}"
                sleep 1
                continue
            fi
            echo -ne "${RED}Kill ALL ${_kn} session(s) in '${proj_title}'? ${NC}${GRAY}[y/N]${NC} "
            local _kconfirm=""
            read -r _kconfirm
            if [[ "$_kconfirm" =~ ^[yY]$ ]]; then
                echo -e "${YELLOW}Terminating all sessions in '${proj_title}'...${NC}"
                kill_project_sessions "$proj_path"
                sleep 1
            else
                echo -e "${GRAY}Cancelled — nothing killed.${NC}"
                sleep 1
            fi
            continue
        fi

        # Remove project: "aremove"
        if [[ "$choice" =~ ^(zz[a-z]|z[a-z]|[a-z])remove$ ]]; then
            local letter="${BASH_REMATCH[1]}"

            # Find project
            local project_index=-1
            for i in "${!project_letters[@]}"; do
                if [ "${project_letters[$i]}" = "$letter" ]; then
                    project_index=$i
                    break
                fi
            done

            if [ "$project_index" -eq -1 ]; then
                echo -e "${RED}✗ Invalid project: $letter${NC}"
                sleep 2
                continue

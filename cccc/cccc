                else
                    echo -e "${GRAY}Cancelled${NC}"
                    sleep 1
                fi
            else
                sleep 2
            fi
            continue
        fi

        # Kill session: "3k"
        if [[ "$choice" =~ ^([0-9]+)k$ ]]; then
            local session_num="${BASH_REMATCH[1]}"

            # Find session
            local session_index=-1
            for i in "${!session_numbers[@]}"; do
                if [ "${session_numbers[$i]}" = "$session_num" ]; then
                    session_index=$i
                    break
                fi
            done

            if [ "$session_index" -eq -1 ]; then
                echo -e "${RED}✗ Invalid session number: $session_num${NC}"
                sleep 2
                continue
            fi

            local sess_name="${session_names[$session_index]}"
            echo ""
            echo -e "${YELLOW}⚠️  Kill session '${sess_name}'?${NC}"
            read -p "   Press 'k' to confirm: " confirm

            if [[ "$confirm" == "k" ]]; then
                kill_session "$sess_name"
                echo -e "${GREEN}✓ Session terminated${NC}"
                sleep 1
            else
                echo -e "${GRAY}Cancelled${NC}"
                sleep 1
            fi
            continue
        fi

        # Open session: "3"
        if [[ "$choice" =~ ^[0-9]+$ ]]; then
            local session_num="$choice"

            # Find session
            local session_index=-1
            for i in "${!session_numbers[@]}"; do
                if [ "${session_numbers[$i]}" = "$session_num" ]; then
                    session_index=$i
                    break
                fi
            done

            if [ "$session_index" -eq -1 ]; then
                echo -e "${RED}✗ Invalid session number: $session_num${NC}"
                sleep 2
                continue
            fi

            local sess_name="${session_names[$session_index]}"
            clear
            attach_session "$sess_name"
            continue
        fi

        # Quick-watch session by number: "watch3" or "watch 3"
        if [[ "$choice" =~ ^watch[[:space:]]*([0-9]+)$ ]]; then
            local session_num="${BASH_REMATCH[1]}"

            local session_index=-1
            for i in "${!session_numbers[@]}"; do
                if [ "${session_numbers[$i]}" = "$session_num" ]; then
                    session_index=$i
                    break
                fi
            done

            if [ "$session_index" -eq -1 ]; then
                echo -e "${RED}✗ Invalid session number: $session_num${NC}"
                sleep 2
                continue
            fi

            local sess_name="${session_names[$session_index]}"
            start_limit_watcher "$sess_name"
            sleep 1
            continue
        fi

        # Invalid input
        echo -e "${RED}✗ Invalid input: '$choice'${NC}"
        sleep 2
    done
}

# ============================================================================
# PROJECT MANAGEMENT
# ============================================================================

cmd_add() {
    local name="$1"
    local path="$2"
    local group="$3"

    if [ -z "$name" ] || [ -z "$path" ]; then
        echo "Usage: cccc add <name> <path> [group]"
        echo "  group: optional, e.g. 'Web' or 'Development/Web'"
        exit 1
    fi

    # Sanitize/validate name against the same projects.conf parse contract
    # every other add path enforces (wizard_name/proj_name strip '|'; this
    # standalone CLI entry point — callable non-interactively, e.g. over SSH
    # — previously skipped it entirely, matching cc-webui.py's validate()
    # hard-reject rules exactly (name may not contain '|', '[', ']', start
    # with '#', or contain a newline).
    name="${name//|/}"
    name="${name//$'\n'/}"
    if [[ "$name" == \#* ]] || [[ "$name" == *"["* ]] || [[ "$name" == *"]"* ]]; then
        echo -e "${RED}✗ Project name may not start with '#' or contain '[' or ']': $name${NC}"
        exit 1
    fi
    if [ -z "$name" ]; then
        echo -e "${RED}✗ Project name is empty after sanitization${NC}"
        exit 1
    fi

    # Expand path
    path=$(cd "$path" 2>/dev/null && pwd -P || echo "$path")

    if [ ! -d "$path" ]; then
        echo -e "${RED}✗ Path does not exist: $path${NC}"
        exit 1
    fi

    ensure_config_dir

    # Check if project already exists
    if project_exists "$name"; then
        echo -e "${RED}✗ Project '$name' already exists${NC}"
        exit 1
    fi

    if ! add_project_to_group "$name" "$path" "$group"; then
        echo -e "${RED}✗ Failed to add project${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ Project '$name' added${NC}"
    echo -e "  Path: $path"
    [ -n "$group" ] && echo -e "  Group: $group"

    # AUTO_TRUST on-add (TRUST-01): cmd_add is a standalone CLI entry point
    # (not looped through config_menu, which already calls load_settings every
    # iteration), so it must load settings itself before reading CC_SET_AUTO_TRUST.
    load_settings
    if [[ "$CC_SET_AUTO_TRUST" == "on-add" ]]; then
        # TTY guard FIRST, before the prompt: cmd_add can be invoked
        # non-interactively (stdin closed/redirected — SSH, cccc skill,
        # n8n-cc-ssh orchestration, per this ecosystem's own tooling). With no
        # TTY, no consent can actually be given, so an empty/EOF `read` must
        # NEVER be treated as a "yes" default — skip both the prompt and any
        # write and behave exactly as a "no" answer.
        [[ -t 0 ]] || return 0
        local trust_answer
        read -e -r -p "Pre-trust this folder for Claude Code? [Y/n] " trust_answer
        if [[ -z "$trust_answer" || "$trust_answer" =~ ^[Yy] ]]; then
            trust_path_defensively "$path"
        fi
    fi
}

cmd_rm() {
    local name="$1"

    if [ -z "$name" ]; then
        echo "Usage: cccc rm <name>"
        exit 1
    fi

    ensure_config_dir

    if ! project_exists "$name"; then
        echo -e "${RED}✗ Project '$name' not found${NC}"
        exit 1
    fi

    if ! remove_project_from_conf "$name"; then
        echo -e "${RED}✗ Failed to remove project${NC}"
        exit 1
    fi

    echo -e "${GREEN}✓ Project '$name' removed${NC}"
}

cmd_list() {
    ensure_config_dir

    if [ ! -s "$PROJECTS_FILE" ]; then
        echo "No projects configured."
        exit 0
    fi

    echo -e "${BOLD}Configured projects:${NC}"
    echo ""

    while IFS= read -r line || [[ -n "$line" ]]; do
        [ -z "$line" ] && continue
        [[ "$line" =~ ^# ]] && continue

        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            echo -e "${NEON}[${BASH_REMATCH[1]}]${NC}"
            continue
        fi

        local name path
        IFS='|' read -r name path <<< "$line"
        [ -z "$name" ] || [ -z "$path" ] && continue
        printf "  ${CYAN}%-20s${NC} %s\n" "$name" "$path"
    done < "$PROJECTS_FILE"
}

# Start Claude with --continue in current directory
cmd_continue() {
    local current_path
    current_path=$(pwd)
    local folder
    folder=$(sanitize_session_name "$(basename "$current_path")")
    local session_name="cc-${folder}-cont"

    # Check if session already exists (exact match — "=" prevents a prefix-
    # colliding session from being mistaken for this one)
    if tmux has-session -t "=$session_name" 2>/dev/null; then
        echo -e "${YELLOW}Session '$session_name' already exists, attaching...${NC}"
        attach_session "$session_name"
        return
    fi

    # Create new tmux session with Claude --continue
    if ! tmux new-session -d -s "$session_name" -c "$current_path" 2>/dev/null; then
        echo -e "${RED}✗ Failed to create tmux session '$session_name'${NC}"
        return 1
    fi

    # Set terminal title
    local terminal_title
    terminal_title=$(format_terminal_title "$session_name" "$current_path")
    # Strip single quotes — spliced into a single-quoted string sent to the pane
    # shell; an apostrophe would unbalance the quote and eat the launch command.
    terminal_title="${terminal_title//\'/}"
    tmux send-keys -t "$session_name" "echo -ne '\\033]0;${terminal_title}\\007'" C-m
    # Start Claude session with --continue directly.
    # Browser is opt-in (no --chrome by default); per-session V8 heap cap guards
    # against a runaway session freezing the Mac. Consistent with start_claude_session.
    # MODEL (SET-03): empty CC_SET_MODEL means no --model flag. cc_model_flag()
    # (WR-01, 07-REVIEW.md) shares this computation with start_claude_session.
    local model_flag
    model_flag=$(cc_model_flag)
    # MEMORY_LIMIT_MB (SET-04): 0 removes the NODE_OPTIONS prefix entirely.
    # cc_node_opts() (WR-01/WR-04, 07-REVIEW.md) shares this computation with
    # start_claude_session and uses a numeric compare so "00"/"000" also
    # disable the cap.
    local node_opts
    node_opts=$(cc_node_opts)
    # EXTRA_FLAGS (SET-05): cmd_continue has no session-id-minting or browser-
    # detection blocks to protect, but the fresh-local convention is kept for
    # consistency with start_claude_session. CLAUDE_BIN (SET-05) passed as the
    # builder's 8th positional argument.
    local _combined_extra="-c"
    if [[ -n "$CC_SET_EXTRA_FLAGS" ]]; then
        _combined_extra="${_combined_extra} ${CC_SET_EXTRA_FLAGS}"
    fi
    local launch_cmd
    launch_cmd=$(build_claude_launch_cmd "" "$node_opts" "$(cc_permission_flag)" "$model_flag" "" "" "$_combined_extra" "$CC_SET_CLAUDE_BIN")
    tmux send-keys -t "$session_name" "$launch_cmd" C-m

    echo -e "${GREEN}✓ Session '$session_name' started with --continue${NC}"
    sleep 1
    attach_session "$session_name"
}

# Clean up orphaned Claude processes (safe for cccc sessions)
cmd_cleanup() {
    local dry_run=false
    [[ "$1" == "-n" || "$1" == "--dry-run" ]] && dry_run=true

    echo -e "${CYAN}Scanning for orphaned Claude CLI processes...${NC}"
    echo ""

    # Find orphaned claude CLI processes:
    # - PPID=1 (reparented to init = parent died)
    # - TTY=?? (detached from terminal)
    # - comm=claude (the binary, not Chrome helpers/node/bun)
    # This is SAFE because:
    # - cc tmux sessions have real TTY (ttysXXX)
    # - claude-mem workers have PPID != 1
    local orphans
    orphans=$(ps -eo pid,ppid,tty,etime,comm,args 2>/dev/null | \
        awk '$2 == 1 && $3 == "??" && $5 == "claude" && !/Claude\.app/ {print $1, $4}')

    if [[ -z "$orphans" ]]; then
        echo -e "${GREEN}✓ No orphaned Claude CLI processes found${NC}"
        return 0
    fi

    echo -e "${YELLOW}Found orphaned Claude processes:${NC}"
    echo "$orphans" | while read pid etime; do
        local cmdline
        cmdline=$(ps -p "$pid" -o args= 2>/dev/null | head -c 60)
        echo -e "  ${GRAY}PID $pid${NC} (running ${YELLOW}$etime${NC}): ${cmdline}..."
    done

    if $dry_run; then
        echo ""
        echo -e "${GRAY}(Dry run - no processes killed. Run 'cccc cleanup' to kill them)${NC}"
        return 0
    fi

    echo ""
    echo "$orphans" | while read pid etime; do
        if kill -9 "$pid" 2>/dev/null; then
            echo -e "  ${GREEN}✓ Killed PID $pid${NC}"
        fi
    done
    echo ""
    echo -e "${GREEN}✓ Cleaned up orphaned Claude CLI processes${NC}"
}

# Launch the local web UI (Organisation + Einstellungen tabs) that edits
# projects.conf and settings.conf. Shared implementation for two command
# names with different default flag profiles (D-01,
# .planning/phases/15-settings-web-ui/15-CONTEXT.md):
#   `cccc settings` (new primary name) -- local-first bind (127.0.0.1) +
#     browser auto-open by default.
#   `cccc webui` (legacy alias) -- preserves today's exact prior default:
#     network-interface bind (0.0.0.0) + no auto-open.
# Both defaults are overridable via the same two flags from either name:
#   --lan       force a network-interface bind (0.0.0.0)
#   --no-open   suppress browser auto-open
#   --local     deprecated-but-functional synonym for the settings default
#               (127.0.0.1 + auto-open); kept for `cccc webui --local`.
# $1 is always the invocation mode ("settings" or "webui"), set by the
# main() dispatch cases below; the remaining args are the flags above.
cmd_webui() {
    local mode="${1:-webui}"
    shift || true

    # Resolve cc-webui.py relative to this script only. macOS stock bash lacks
    # `readlink -f`, so fall back to the literal BASH_SOURCE path.
    local self="${BASH_SOURCE[0]}"
    local resolved
    resolved="$(readlink -f "$self" 2>/dev/null || echo "$self")"
    local script_dir
    script_dir="$(cd "$(dirname "$resolved")" 2>/dev/null && pwd)"
    local webui_script="$script_dir/cc-webui.py"

    if [ ! -f "$webui_script" ]; then
        echo -e "${RED}✗ cc-webui.py not found.${NC}"
        echo -e "${GRAY}Looked next to cccc ($script_dir/cc-webui.py).${NC}"
        echo -e "${GRAY}Copy it alongside the installed binary:${NC}"
        echo -e "${GRAY}  cp <repo>/cccc/cc-webui.py ~/.local/bin/cc-webui.py${NC}"
        return 1
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        echo -e "${RED}✗ python3 is required for 'cccc $mode'.${NC}"
        return 1
    fi

    # Parse the opt-in flags. Orthogonal to `mode` -- either flag can be
    # combined with either invocation name.
    local want_lan=0 want_no_open=0 want_local=0
    local arg
    for arg in "$@"; do
        case "$arg" in
            --lan) want_lan=1 ;;
            --no-open) want_no_open=1 ;;
            --local) want_local=1 ;;
        esac
    done

    # Default profile per mode (D-01). `webui` with no flags must stay
    # byte-for-byte today's behavior: LAN bind + no auto-open. `settings`
    # with no flags passes no host/browser overrides at all, so cc-webui.py's
    # own defaults (host=127.0.0.1, open_browser=True) apply directly.
    local bind_lan=0 suppress_open=0
    if [ "$mode" = "webui" ]; then
        bind_lan=1
        suppress_open=1
    fi
    # --local (deprecated synonym) forces the local+auto-open profile even
    # from `cccc webui --local`.
    if [ "$want_local" -eq 1 ]; then
        bind_lan=0
        suppress_open=0
    fi
    [ "$want_lan" -eq 1 ] && bind_lan=1
    [ "$want_no_open" -eq 1 ] && suppress_open=1

    local -a py_args=(--config "$PROJECTS_FILE" --settings "$SETTINGS_FILE")
    [ "$bind_lan" -eq 1 ] && py_args+=(--host 0.0.0.0)
    [ "$suppress_open" -eq 1 ] && py_args+=(--no-browser)

    echo -e "${CYAN}Starting cccc Settings (projects + settings editor)...${NC}"
    if [ "$bind_lan" -eq 1 ]; then
        echo -e "${GRAY}Bound to all network interfaces. Press Ctrl-C to stop.${NC}"
    else
        echo -e "${GRAY}Bound to 127.0.0.1 (local only). Press Ctrl-C to stop.${NC}"
    fi
    # Foreground so Ctrl-C cleanly stops it. The Python server prints the
    # reachable URL(s) + a no-auth warning when bound to 0.0.0.0.
    python3 "$webui_script" "${py_args[@]}"
}


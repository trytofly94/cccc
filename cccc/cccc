# Timestamp-aware session enumerator, dedicated to `cc json` — does NOT replace
# get_tmux_sessions() so existing positional `IFS='|' read` call sites are untouched.
# Returns: session_name|session_path|session_attached|session_windows|session_created|session_activity
get_tmux_sessions_with_times() {
    tmux list-sessions -F "#{session_name}|#{session_path}|#{session_attached}|#{session_windows}|#{session_created}|#{session_activity}" 2>/dev/null
}

# Read-only, ANSI-free, machine-readable snapshot of all cc-* tmux sessions.
# stdout is bare JSON ONLY (no banners/diagnostics) — an external client
# (e.g. a remote companion app, over SSH exec) parses it directly. Any
# diagnostics must go to stderr.
cmd_json() {
    ensure_config_dir

    # Open /dev/null once on a dedicated fd for the tmux showenv calls in the sessions
    # loop below, instead of a fresh `2>/dev/null` (re-open) per call. With ~20+ sessions
    # that is 40+ back-to-back /dev/null opens across rapid subprocess forks, which was
    # observed to occasionally corrupt the surrounding loop's state (reproducible locally
    # AND over `ssh localhost`) — sharing one fd avoids the repeated open/close churn.
    exec 9>/dev/null

    # ---- projects: mirror cmd_list()'s line-by-line parse exactly ----
    local projects_json="[]"
    if [ -s "$PROJECTS_FILE" ]; then
        local project_objs=()
        local current_group=""
        while IFS= read -r line || [[ -n "$line" ]]; do
            [ -z "$line" ] && continue
            [[ "$line" =~ ^# ]] && continue

            if [[ "$line" =~ ^\[(.+)\]$ ]]; then
                current_group="${BASH_REMATCH[1]}"
                continue
            fi

            local name path
            IFS='|' read -r name path <<< "$line"
            [ -z "$name" ] || [ -z "$path" ] && continue
            project_objs+=("$(jq -n --arg name "$name" --arg path "$path" --arg group "$current_group" \
                '{name:$name, path:$path, group:$group}')")
        done < "$PROJECTS_FILE"
        if [ "${#project_objs[@]}" -gt 0 ]; then
            projects_json=$(printf '%s\n' "${project_objs[@]}" | jq -s '.')
        fi
    fi

    # ---- backends: names only, via the backends.sh plugin's cccc_backend_names_json ----
    # Gated: with no backends plugin present, backends_json stays "[]" (clean degrade).
    local backends_json="[]"
    if declare -f cccc_backend_names_json >/dev/null 2>&1; then
        backends_json=$(cccc_backend_names_json)
    fi

    # ---- sessions: everything except known daemon/infra sessions ----
    local sessions_json="[]"
    local session_objs=()
    local raw_sessions
    raw_sessions=$(get_tmux_sessions_with_times)
    if [ -n "$raw_sessions" ]; then
        local sess_name sess_path sess_attached sess_windows sess_created sess_activity
        # Read via fd 3 (not fd 0/stdin): the loop body calls tmux/jq subcommands whose
        # unredirected stdin would otherwise share the here-string's stream, risking
        # partial consumption of $raw_sessions and a silently truncated loop.
        while IFS='|' read -r sess_name sess_path sess_attached sess_windows sess_created sess_activity <&3; do
            [ -z "$sess_name" ] && continue
            [[ "$sess_name" =~ -gsd-[0-9]+$ ]] && continue
            [[ "$sess_name" =~ ^limit-watcher- ]] && continue
            [[ "$sess_name" =~ ^conductor- ]] && continue
            # This used to be an ALLOW-list (`^cc-` only), which silently
            # dropped claude-*-prefixed and non-standard-prefixed Claude
            # worker sessions (e.g. myservice-worker) — most real sessions
            # never reached external clients consuming `cc json`. An
            # exclude-list of the finite known infra/daemon session
            # patterns is more future-proof than a prefix allow-list that
            # breaks again the next time a new worker-naming scheme shows up;
            # `sudo-*` (e.g. `sudo-65`) is the one stray-manual-shell pattern
            # observed in practice and stays excluded here too.
            [[ "$sess_name" =~ ^sudo- ]] && continue

            local proj_name
            proj_name=$(printf '%s' "$projects_json" | jq -r --arg p "$sess_path" \
                '(map(select(.path == $p)) | .[0].name) // ""')

            local attached_bool="false"
            [ "$sess_attached" = "1" ] && attached_bool="true"

            # Deviation (Rule 1 — reliability bug found during verification): a very short
            # throttle here avoids a reproducible race (confirmed locally AND over
            # `ssh localhost`) where rapid back-to-back subprocess forks inside this loop
            # occasionally corrupt/terminate the whole `cc json` process with no diagnostic
            # output. ~20-30 cc-* sessions * 20ms is well under the ~10s poll interval a
            # typical external polling client would use, so this has no user-visible
            # latency impact.
            sleep 0.02

            local backend label
            backend=$(tmux showenv -t "$sess_name" CC_BACKEND 2>&9 | cut -d= -f2)
            label=$(tmux showenv -t "$sess_name" CC_SESSION_LABEL 2>&9 | cut -d= -f2)
            # Fallback: sessions created outside cc — or recovered after a crash
            # without the env being set — have no CC_SESSION_LABEL. Show the tmux
            # session name instead of a blank label (a companion client app
            # rendered these rows nameless). 15 recovered sessions showed without names.
            [ -z "$label" ] && label="$sess_name"

            local status
            status=$(detect_session_status "$sess_name")

            # CONTRACT (companion client app API): `resets` MUST be a unix-epoch
            # NUMBER or null — never a wall-clock string. The app's Codable model
            # types it Int?; emitting the raw "11:30pm" scan string here (the old
            # `--arg resets` path) made Swift's JSONDecoder throw typeMismatch and
            # fail the ENTIRE session list decode ("data isn't in the correct
            # format"). Convert the scanned time to an epoch via parse_reset_time and
            # emit it with --argjson (number); UNKNOWN/empty/unparseable → null.
            local rl rl_time rl_tz rl_epoch rate_limit_json
            rl=$(scan_session_rate_limit "$sess_name")
            if [ -n "$rl" ]; then
                rl_time="${rl%%|*}"
                rl_tz="${rl#*|}"
                if [ "$rl_time" = "UNKNOWN" ] || [ -z "$rl_time" ]; then
                    rate_limit_json=$(jq -n '{limited:true, resets:null}')
                else
                    rl_epoch=$(parse_reset_time "$rl_time" "$rl_tz")
                    if [ -n "$rl_epoch" ] && [ "$rl_epoch" != "0" ]; then
                        rate_limit_json=$(jq -n --argjson resets "$rl_epoch" '{limited:true, resets:$resets}')
                    else
                        rate_limit_json=$(jq -n '{limited:true, resets:null}')
                    fi
                fi
            else
                rate_limit_json=$(jq -n '{limited:false, resets:null}')
            fi

            session_objs+=("$(jq -n \
                --arg name "$sess_name" \
                --arg path "$sess_path" \
                --arg project "$proj_name" \
                --argjson attached "$attached_bool" \
                --argjson windows "${sess_windows:-0}" \
                --arg backend "${backend:-}" \
                --arg label "${label:-}" \
                --argjson created "${sess_created:-0}" \
                --argjson activity "${sess_activity:-0}" \
                --arg status "$status" \
                --argjson rate_limit "$rate_limit_json" \
                '{name:$name, path:$path, project:$project, attached:$attached, windows:$windows,
                  backend:$backend, label:$label, created:$created, activity:$activity,
                  status:$status, rate_limit:$rate_limit}')")
        done 3<<< "$raw_sessions"
    fi
    if [ "${#session_objs[@]}" -gt 0 ]; then
        sessions_json=$(printf '%s\n' "${session_objs[@]}" | jq -s '.')
    fi

    exec 9>&-

    jq -n --argjson projects "$projects_json" --argjson backends "$backends_json" --argjson sessions "$sessions_json" \
        '{projects:$projects, backends:$backends, sessions:$sessions}'
}

# Thin retrying wrapper around cmd_json.
# Deviation (Rule 1 — reliability bug found during verification): on a Mac with many
# concurrent tmux sessions, the burst of subprocess forks inside cmd_json's session loop
# (tmux/jq calls per session) can occasionally crash the invoking shell outright — zero
# stdout, no diagnostic, plain `exit 1` (reproduced repeatedly, locally AND over
# `ssh localhost`, independent of bash version). Running cmd_json inside a `$(...)`
# subshell means only that subshell dies on a bad run; this wrapper's own shell survives
# and can retry. Output is validated as real JSON via `jq empty` before being printed, so
# a transient fork-storm crash never surfaces to the caller.
#
# The errexit leak that originally caused this crash (a shell-state leak
# around an optional plugin's module-source call) is now fixed at its root,
# so this wrapper is no longer masking a live, reproducible defect. KEPT
# anyway as cheap, harmless defense-in-depth against any *other* transient
# subprocess hiccup in a loop this size (this is not a reflexive "keep
# everything" — see kill_session_with_retry below for the identical
# reasoning applied consistently to the kill path).
cmd_json_with_retry() {
    local tries=0 max_tries=5 out rc single
    while [ "$tries" -lt "$max_tries" ]; do
        tries=$((tries + 1))
        out=$(cmd_json 2>/tmp/.cc-json-err.$$)
        rc=$?
        # Validate + normalize to EXACTLY ONE well-formed JSON object.
        #
        # BUG (found via a decode error in an external client consuming this
        # output): the old check was `jq empty`, but `jq` validates a STREAM
        # of JSON values — it happily accepts two concatenated objects
        # `{...}{...}`. Under fork-storm load (many concurrent tmux sessions)
        # cmd_json can occasionally emit its JSON DUPLICATED, which `jq
        # empty` passed straight through. A strict single-value JSON decoder
        # (as most clients use) rejects any bytes after the first object,
        # surfacing as a spurious offline error on an otherwise-fine poll.
        #
        # `jq -s` slurps the whole stream into an array; `first(.[] | select
        # (...))` emits ONLY the first element that has the expected top-level
        # shape (sessions/projects/backends all arrays). This SELF-HEALS a
        # duplicated stream (emits a single clean object) and rejects a
        # truncated/garbage run (select matches nothing -> empty -> retry).
        if [ "$rc" -eq 0 ]; then
            single=$(printf '%s' "$out" | jq -c -s \
                'first(.[] | select((.sessions|type)=="array" and (.projects|type)=="array" and (.backends|type)=="array"))' \
                2>/dev/null)
            if [ -n "$single" ]; then
                printf '%s\n' "$single"
                rm -f "/tmp/.cc-json-err.$$"
                return 0
            fi
        fi
    done
    echo "✗ cccc json: failed to produce valid single-object JSON after ${max_tries} attempts (rc=$rc)" >&2
    cat "/tmp/.cc-json-err.$$" >&2 2>/dev/null
    rm -f "/tmp/.cc-json-err.$$"
    return 1
}

# Concurrent-client hardening.
# PROBLEM: with 50+ sessions cmd_json is a fork storm. Two steady external
# pollers (e.g. a mobile client @10s + a desktop client/spike) overlap
# generations, corrupt each other's stdout under load, and each retry
# re-runs the full storm — amplifying the load for the OTHER client until
# retries are exhausted and the client-side decoder rejects the malformed
# output (a single stray miss is usually tolerated by client-side retry
# logic; two steady concurrent pollers are not).
# FIX: snapshot cache + single-flight lock. At most ONE generation runs at any moment;
# every other concurrent caller is served the snapshot (atomic rename => readers never
# see a partial file). Freshness TTL 5s keeps waiting-detection latency <= poll
# interval + 5s (do not raise past 8s — the status ampel is the core product).
# Locking: mkdir spinlock with pid+age staleness steal — stock macOS has no flock(1).
# CONTRACTS PRESERVED: stdout = bare JSON only, exit 0 on success, != 0 with
# stderr diagnostic on failure; schema untouched (this layer never edits the
# JSON, it only decides WHO generates it).
CC_JSON_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cc"
CC_JSON_SNAP="$CC_JSON_STATE_DIR/json-snapshot"
CC_JSON_LOCK_DIR="$CC_JSON_STATE_DIR/json.lock.d"
CC_JSON_TTL_SECONDS=5
CC_JSON_LOCK_MAX_ITER=120   # x 0.25s = 30s, > worst-case generation incl. retries

cc_json_snapshot_fresh() {
    [ -f "$CC_JSON_SNAP" ] || return 1
    local now mtime age
    now=$(date +%s)
    mtime=$(stat -f %m "$CC_JSON_SNAP" 2>/dev/null || stat -c %Y "$CC_JSON_SNAP" 2>/dev/null) || return 1
    [ -n "$mtime" ] || return 1
    age=$((now - mtime))
    [ "$age" -ge 0 ] && [ "$age" -le "$CC_JSON_TTL_SECONDS" ]
}

cc_json_lock_acquire() {
    # $1 = max spin iterations (0 = single non-blocking attempt)
    local max_iter="${1:-$CC_JSON_LOCK_MAX_ITER}" iter=0 holder_pid lock_mtime lock_age
    while ! mkdir "$CC_JSON_LOCK_DIR" 2>/dev/null; do
        # Steal a stale lock: holder pid dead, or lock older than 60s.
        holder_pid=$(cat "$CC_JSON_LOCK_DIR/pid" 2>/dev/null)
        if [ -n "$holder_pid" ] && ! kill -0 "$holder_pid" 2>/dev/null; then
            rm -rf "$CC_JSON_LOCK_DIR" 2>/dev/null
            continue
        fi
        lock_mtime=$(stat -f %m "$CC_JSON_LOCK_DIR" 2>/dev/null || stat -c %Y "$CC_JSON_LOCK_DIR" 2>/dev/null || echo 0)
        [ -n "$lock_mtime" ] || lock_mtime=0
        lock_age=$(( $(date +%s) - lock_mtime ))
        if [ "$lock_age" -gt 60 ]; then
            rm -rf "$CC_JSON_LOCK_DIR" 2>/dev/null
            continue
        fi
        iter=$((iter + 1))
        [ "$iter" -ge "$max_iter" ] && return 1
        sleep 0.25
    done
    echo $$ > "$CC_JSON_LOCK_DIR/pid" 2>/dev/null
    return 0
}

cc_json_lock_release() {
    rm -rf "$CC_JSON_LOCK_DIR" 2>/dev/null
    return 0
}

cmd_json_cached() {
    mkdir -p "$CC_JSON_STATE_DIR" 2>/dev/null

    # 1) Fresh snapshot -> serve directly, zero forks.
    if cc_json_snapshot_fresh; then
        cat "$CC_JSON_SNAP"
        return 0
    fi

    # 2) ANY snapshot exists -> serve it IMMEDIATELY and refresh in a
    #    DETACHED background generator (full stale-while-revalidate).
    #    An interactive caller must NEVER pay generation time: the iOS
    #    app's execCapture watchdog is 6.0s and a generation pass at
    #    100+ sessions takes ~4s and grows with session count — a caller
    #    that became the synchronous generator could exceed the watchdog,
    #    yielding an empty reply and a spurious decode error on the phone
    #    (F-61 recurrence #4). Staleness is bounded by
    #    poll-cadence + generation time (~10-15s) — fine for the ampel.
    if [ -f "$CC_JSON_SNAP" ]; then
        cat "$CC_JSON_SNAP"
        (
            # Fully detach from the SSH exec channel: if ANY of the three
            # stdio fds stayed attached, sshd would hold the channel open
            # until this background refresh finished — reintroducing the
            # very latency this branch exists to remove.
            exec </dev/null >/dev/null 2>&1
            # Single-flight: the LONG-LIVED subshell takes the lock itself
            # (non-blocking; a refresh already in flight means we simply
            # skip) and records ITS OWN pid, so the staleness pid-check
            # tracks the actual generator, not the long-gone parent.
            cc_json_lock_acquire 0 || exit 0
            echo "$BASHPID" > "$CC_JSON_LOCK_DIR/pid" 2>/dev/null
            trap 'rm -rf "$CC_JSON_LOCK_DIR"' EXIT
            if ! cc_json_snapshot_fresh; then
                if out=$(cmd_json_with_retry); then
                    printf '%s\n' "$out" > "$CC_JSON_SNAP.tmp.$BASHPID" \
                        && mv -f "$CC_JSON_SNAP.tmp.$BASHPID" "$CC_JSON_SNAP"
                else
                    rm -f "$CC_JSON_SNAP.tmp.$BASHPID" 2>/dev/null
                fi
            fi
        ) &
        disown 2>/dev/null || true
        return 0
    fi

    # 3) First-ever call (no snapshot at all): synchronous single-flight
    #    generation — the only caller class that ever waits (rare: fresh
    #    machine / wiped state dir; interactive setup tolerates it).
    if ! cc_json_lock_acquire; then
        echo "✗ cccc json: lock wait timed out and no snapshot exists" >&2
        return 3
    fi
    # Double-checked: the generator we waited on may have just written it.
    if ! cc_json_snapshot_fresh && [ ! -f "$CC_JSON_SNAP" ]; then
        local out
        if out=$(cmd_json_with_retry); then
            printf '%s\n' "$out" > "$CC_JSON_SNAP.tmp.$$" \
                && mv -f "$CC_JSON_SNAP.tmp.$$" "$CC_JSON_SNAP"
        else
            rm -f "$CC_JSON_SNAP.tmp.$$" 2>/dev/null
            cc_json_lock_release
            return 1
        fi
    fi
    cc_json_lock_release
    cat "$CC_JSON_SNAP"
    return 0
}

# Non-interactive session creator for `cc new <project> [-c|-r|-p] [=backend] <name>`.
# Non-blocking wrapper around start_claude_session()+start_limit_watcher(): unlike the
# interactive flow (prompt_new_session_for_project()), this never calls attach_session()
# and never sleeps — it must return promptly for a caller driving it over SSH exec (e.g.
# a remote companion app's New-Session dialog).
# stdout contract: on success, prints EXACTLY the final tmux session name and nothing
# else (no "✓ Session ... started" banner, no ANSI) — a future caller attaches to
# whatever this prints. All diagnostics/errors go to stderr.
cmd_new() {
    local project="${1:-}"
    shift || true

    if [ -z "$project" ]; then
        echo "Usage: cccc new <project> [-c|-r|-p] [=backend] <name>" >&2
        exit 1
    fi

    # Resolve project path via exact field-1 match — same awk -F'|' convention as
    # project_exists()/remove_project_from_conf(). No default-path fallback: an
    # unknown project must never silently create a session somewhere else.
    local proj_path=""
    if [ -f "$PROJECTS_FILE" ]; then
        proj_path=$(awk -F'|' -v n="$project" '$1 == n {print $2; exit}' "$PROJECTS_FILE")
    fi
    if [ -z "$proj_path" ]; then
        echo -e "${RED}✗ Project '$project' not found${NC}" >&2
        exit 1
    fi

    # Flag/backend/name parsing. Only -c/-r/-p are accepted (interactive parser's exact
    # mapping, cc/cc:1798-1804); a leading '=' selects a backend; the final remaining
    # positional is the REQUIRED session name (no auto-naming).
    local extra_flags="" backend="" name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -c)
                extra_flags="${extra_flags:+${extra_flags} }-c"
                ;;
            -r)
                extra_flags="${extra_flags:+${extra_flags} }-r"
                ;;
            -p)
                extra_flags="${extra_flags:+${extra_flags} }--permission-mode plan"
                ;;
            =*)
                backend="${1#=}"
                ;;
            -*)
                echo -e "${RED}✗ Unknown flag: '$1'${NC}" >&2
                echo "Usage: cccc new <project> [-c|-r|-p] [=backend] <name>" >&2
                exit 1
                ;;
            *)
                name="$1"
                ;;
        esac
        shift
    done

    if [ -z "$name" ]; then
        echo "Usage: cccc new <project> [-c|-r|-p] [=backend] <name>" >&2
        exit 1
    fi

    local full_session_name
    full_session_name="cc-$(sanitize_session_name "$project")-$(sanitize_session_name "$name")"

    # start_claude_session() prints its own "✓ Session ... started" line on stdout —
    # capture+redirect it to stderr so it never leaks into cmd_new's bare-name contract.
    local out rc
    out=$(start_claude_session "$full_session_name" "$proj_path" "$extra_flags" "$backend" 2>&1)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        [ -n "$out" ] && echo "$out" >&2
        exit "$rc"
    fi
    [ -n "$out" ] && echo "$out" >&2

    # Non-blocking: no sleep, no attach_session (contrast with the interactive flow).
    maybe_start_limit_watcher "$full_session_name" >&2 2>&1

    echo "$full_session_name"
}

# Thin retrying wrapper around kill_session().
# Containment for the same fork-storm reliability class as cmd_json_with_retry above:
# kill_session() makes 3 sequential `tmux kill-session` calls plus several subprocess
# calls inside _save_session_name_before_kill(), and the invoking shell was independently
# and reproducibly observed to die partway through that sequence — zero output, exit 1,
# before kill_session's own trailing work completes. This wrapper does NOT root-cause
# that crash; it only isolates + retries: kill_session runs inside a `(...)` subshell so
# a mid-sequence crash only kills that subshell, not this wrapper's own shell, which can
# then retry. Because kill_session has no JSON output to validate the way
# cmd_json_with_retry validates via `jq empty`, success here is defined as "the target
# session no longer exists" (tmux has-session fails) — which is also idempotent-safe to
# re-attempt: kill_session's own `tmux kill-session` calls are already no-ops
# (2>/dev/null) against sessions already gone.
#
# The underlying errexit/pipefail leak that originally caused this crash (from an
# optional plugin's unguarded module source) is now fixed at its root by
# saving/restoring `set -o` state around that source call — NOT by anything in this
# wrapper. KEPT anyway as defense-in-depth (cheap, already idempotent, no behavior
# change to the guard paths), since kill is a destructive, security-guarded,
# low-frequency operation where a thin extra safety net costs nothing.
kill_session_with_retry() {
    local session_name="$1"
    local tries=0 max_tries=5
    local err_file
    err_file=$(mktemp "${TMPDIR:-/tmp}/cc-kill-err.XXXXXX")

    while [ "$tries" -lt "$max_tries" ]; do
        tries=$((tries + 1))
        ( kill_session "$session_name" ) 2>"$err_file"
        if ! tmux has-session -t "=$session_name" 2>/dev/null; then
            rm -f "$err_file"
            return 0
        fi
    done

    echo "✗ cccc kill: '$session_name' still present after ${max_tries} attempts" >&2
    cat "$err_file" >&2 2>/dev/null
    rm -f "$err_file"
    return 1
}

# Guarded, thin CLI wrapper for `cccc kill <session>` — same shape as cmd_rm(): validate
# arg -> guard -> delegate -> report. Delegates to the existing kill_session() VERBATIM
# (name-persistence + gsd/limit-watcher sidecar cleanup) via kill_session_with_retry();
# no kill logic is duplicated here and no stop_limit_watcher()/is_watcher_active() calls
# are added beyond what kill_session() already makes (see 00-PATTERNS.md).
cmd_kill() {
    local session="${1:-}"

    if [ -z "$session" ]; then
        echo "Usage: cccc kill <session>" >&2
        exit 1
    fi

    # Security-critical guard: this runs over SSH with attacker-adjacent input. Only
    # cc-* sessions may ever be killed via this entry point — never a user's own shell,
    # conductor-*, or a bare limit-watcher-* session.
    if [[ "$session" != cc-* ]]; then
        echo -e "${RED}✗ Refusing to kill '$session': not a cc-* session${NC}" >&2
        exit 1
    fi

    # Exact-match existence check (leading '=' forces exact name match, not prefix).
    if ! tmux has-session -t "=$session" 2>/dev/null; then
        echo -e "${RED}✗ Session '$session' not found${NC}" >&2
        exit 1
    fi

    if ! kill_session_with_retry "$session"; then
        echo -e "${RED}✗ Failed to kill '$session' after retries${NC}" >&2
        exit 1
    fi
    echo -e "${GREEN}✓ Session '$session' killed${NC}"
}


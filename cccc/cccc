            start_claude_session "$gsd_session_name" "$proj_path" || continue
            sleep 1
            attach_session "$gsd_session_name"
            continue
        fi

        # Open first/new session in project: "a", "za", or "zza"
        if [[ "$choice" =~ ^(zz[a-z]|z[a-z]|[a-z])$ ]]; then
            local letter="${BASH_REMATCH[1]}"

            # Find project
            local project_index=-1
            for i in "${!project_letters[@]}"; do
                if [ "${project_letters[$i]}" = "$letter" ]; then
                    project_index=$i
                    break
                fi
            done

            if [ "$project_index" -eq -1 ]; then
                echo -e "${RED}✗ Invalid project: $letter${NC}"
                sleep 2

            local proj_title="${project_titles[$project_index]}"

            echo ""
            echo -e "${YELLOW}⚠️  Remove project '${proj_title}'?${NC}"
            echo -e "${GRAY}   (Active sessions will NOT be terminated)${NC}"
            read -p "   Confirm [y/N]: " confirm

            if [[ "$confirm" =~ ^[yY]$ ]]; then
                if remove_project_from_conf "$proj_title"; then
                    echo -e "${GREEN}✓ Project '${proj_title}' removed${NC}"
                else
                    echo -e "${RED}✗ Failed to remove project${NC}"
                fi
                sleep 1
            else
                echo -e "${GRAY}Cancelled${NC}"
                sleep 1
            fi
            continue
        fi

        # GSD mode in project: "ag" (requires the private GSD companion plugin and .planning/ROADMAP.md)
        if [[ "$choice" =~ ^(zz[a-z]|z[a-z]|[a-z])g$ ]]; then
            local letter="${BASH_REMATCH[1]}"

            # Check if GSD is available
            if [[ "$GSD_AVAILABLE" != "true" ]]; then
                echo -e "${RED}✗ GSD module not available (GSD companion plugin not installed)${NC}"
                sleep 2
                continue
            fi

            # Find project
            local project_index=-1
            for i in "${!project_letters[@]}"; do
                if [ "${project_letters[$i]}" = "$letter" ]; then
                    project_index=$i
                    break
                fi
            done

            if [ "$project_index" -eq -1 ]; then
                echo -e "${RED}✗ Invalid project: $letter${NC}"
                sleep 2
                continue

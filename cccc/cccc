                    if [ "$_ci" -lt 26 ]; then
                        _cletter=$(printf "\\$(printf '%03o' $((97 + _ci)))")
                        printf "  ${NEON}%s${NC}  %s\n" "$_cletter" "${_cat_names[$_ci]}"
                    else
                        printf "     %s\n" "${_cat_names[$_ci]}"
                    fi
                done
                echo -e "${GRAY}  Letter → pick · new name → create category · empty → none${NC}"
                local _cat_choice
                read -e -r -p "> " _cat_choice
                if [[ "$_cat_choice" =~ ^[a-z]$ ]]; then
                    # Single lowercase letter = pick from the list above; out of
                    # range falls through to being treated as a literal name.
                    local _cidx=$(( $(printf '%d' "'$_cat_choice") - 97 ))
                    if [ "$_cidx" -ge 0 ] && [ "$_cidx" -lt "${#_cat_names[@]}" ]; then
                        proj_group="${_cat_names[$_cidx]}"
                    else
                        proj_group="$_cat_choice"
                    fi
                else
                    proj_group="$_cat_choice"
                fi
            else
                # No categories yet — nothing to pick from, ask for a name.
                read -e -r -p "Category (optional, e.g. 'Web' or 'Dev/Web'): " proj_group
            fi

            if add_project_to_group "$proj_name" "$new_path" "$proj_group"; then
                echo -e "${GREEN}✓ Project '$proj_name' added${NC}"
                [ -n "$proj_group" ] && echo -e "${GRAY}  Group: $proj_group${NC}"

                # AUTO_TRUST on-add (TRUST-01): mirrors cmd_add()'s on-add flow
                # so the interactive "add /path" entry point is also covered,
                # not just the standalone `cc add` CLI command (CR-01).
                if [[ "$CC_SET_AUTO_TRUST" == "on-add" ]]; then
                    if [[ -t 0 ]]; then
                        local trust_answer
                        read -e -r -p "Pre-trust this folder for Claude Code? [Y/n] " trust_answer
                        if [[ -z "$trust_answer" || "$trust_answer" =~ ^[Yy] ]]; then
                            trust_path_defensively "$new_path"
                        fi
                    fi
                fi
            else
                echo -e "${RED}✗ Failed to add project${NC}"
            fi
            sleep 1
            continue
        fi

        # New free session with path: "n /path", "n-c /path", "n /path -c"
        # Supported flags: -c (continue), -r (resume), -p (plan), -v (verbose), -cf (continue+fork)
        local _n_flag="" _n_path=""
        if [[ "$choice" =~ ^[nN](-cf|-[crpv])[[:space:]]+(.+)$ ]]; then
            _n_flag="${BASH_REMATCH[1]}"
            _n_path="${BASH_REMATCH[2]}"
        elif [[ "$choice" =~ ^[nN][[:space:]]+(.+)[[:space:]](-cf|-[crpvb])$ ]]; then
            _n_path="${BASH_REMATCH[1]}"
            _n_flag="${BASH_REMATCH[2]}"
        elif [[ "$choice" =~ ^[nN][[:space:]]+(.+)$ ]]; then
            _n_path="${BASH_REMATCH[1]}"
        fi

        if [[ -n "$_n_path" ]]; then
            local _claude_flag="" _flag_label=""
            case "$_n_flag" in
                -c)  _claude_flag="-c";                    _flag_label="with --continue" ;;
                -r)  _claude_flag="-r";                    _flag_label="with --resume" ;;
                -p)  _claude_flag="--permission-mode plan"; _flag_label="in plan mode" ;;
                -v)  _claude_flag="--verbose";             _flag_label="with --verbose" ;;
                -b)  _claude_flag="--chrome";              _flag_label="with browser (--chrome + browser MCPs)" ;;
                -cf) _claude_flag="-c --fork-session";     _flag_label="with --continue --fork-session" ;;
            esac

            _n_path="${_n_path/#\~/$HOME}"

            if [ ! -d "$_n_path" ]; then
                echo -e "${RED}✗ Path does not exist: $_n_path${NC}"
                sleep 2
                continue
            fi

            local new_path
            new_path=$(cd "$_n_path" && pwd -P)
            local folder
            folder=$(basename "$new_path")

            clear
            if [[ -n "$_flag_label" ]]; then
                echo -e "${CYAN}New free session in '${folder}' ${_flag_label}${NC}"
            else
                echo -e "${CYAN}New free session in '${folder}'${NC}"
            fi
            echo -e "${GRAY}Path: ${new_path}${NC}"
            echo ""
            read -p "Session name [${folder}]: " new_name

            new_name="$(sanitize_session_name "${new_name:-$folder}")"

            start_claude_session "$new_name" "$new_path" "$_claude_flag" || continue
            maybe_start_limit_watcher "$new_name"
            sleep 1
            attach_session "$new_name"
            continue
        fi

        # New free session (interactive)
        if [[ "$choice" == "n" ]] || [[ "$choice" == "N" ]]; then
            clear
            echo -e "${CYAN}Create new free session${NC}"
            echo ""
            read -p "Session name: " new_name
            read -p "Path [$(pwd)]: " new_path

            new_path="${new_path:-$(pwd)}"

            # Expand ~ to $HOME
            new_path="${new_path/#\~/$HOME}"

            if [ -z "$new_name" ]; then
                echo -e "${RED}✗ Name required${NC}"
                sleep 2
                continue
            fi

            if [ ! -d "$new_path" ]; then
                echo -e "${RED}✗ Path does not exist: $new_path${NC}"
                sleep 2
                continue
            fi

            new_name="$(sanitize_session_name "$new_name")"
            start_claude_session "$new_name" "$new_path" || continue
            maybe_start_limit_watcher "$new_name"
            sleep 1
            attach_session "$new_name"
            continue
        fi

        # Rate limit handler
        if [[ "$choice" == "limit" ]] || [[ "$choice" == "LIMIT" ]]; then
            clear
            cmd_rate_limit
            echo ""
            echo -e "${GRAY}Press Enter to return to dashboard...${NC}"
            read -r
            continue
        fi

        # Recovery mode
        if [[ "$choice" == "recover" ]] || [[ "$choice" == "RECOVER" ]]; then
            recovery_mode
            continue
        fi

        # Settings config menu (SET-08)
        if [[ "$choice" == "config" ]] || [[ "$choice" == "CONFIG" ]]; then
            config_menu
            continue
        fi

        # Help
        if [[ "$choice" == "h" ]] || [[ "$choice" == "H" ]] || [[ "$choice" == "help" ]]; then
            clear
            local _pager
            if command -v less >/dev/null 2>&1; then
                _pager="less -R"
            else
                _pager="cat"
            fi
            $_pager << 'HELP'

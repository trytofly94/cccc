main() {
    ensure_config_dir

    # Top-level --no-logo pre-scan (BRAND-04, D-07): the SINGLE owner of this
    # flag. Detects --no-logo anywhere in "$@", sets CC_NO_LOGO=1 (the global
    # render_logo() checks), and strips it from the positional args BEFORE the
    # case dispatch below — so both `cccc --no-logo` and `cccc about
    # --no-logo` are handled from this one place; cmd_about() never has to
    # parse the flag itself. Lives here, at the top of main() alongside
    # -c/-v/-h — never in the in-session letter-command suffix grammar
    # (an-c/-cf etc.), which is a completely separate, later-stage parser.
    local _cc_arg _cc_filtered_args=()
    for _cc_arg in "$@"; do
        if [[ "$_cc_arg" == "--no-logo" ]]; then
            CC_NO_LOGO=1
        else
            _cc_filtered_args+=("$_cc_arg")
        fi
    done
    set -- ${_cc_filtered_args[@]+"${_cc_filtered_args[@]}"}

    # Parse settings.conf into CC_SET_* globals on every invocation. Both
    # CC_SET_LIMIT_WATCHER (Phase 9, Limit-Watcher Core) and CC_SET_AUTO_TRUST
    # (Phase 10, Cleanup & Pre-Trust) are consumed by real behavior, not just
    # populated here.
    load_settings

    case "${1:-}" in
        add)
            shift
            cmd_add "$@"
            ;;
        rm|remove)
            shift
            cmd_rm "$@"
            ;;
        new)
            shift
            cmd_new "$@"
            ;;
        kill)
            shift
            cmd_kill "$@"
            ;;
        list|ls)
            cmd_list
            ;;
        cleanup)
            shift
            cmd_cleanup "$@"
            ;;
        limit)
            cmd_rate_limit
            ;;
        json)
            cmd_json_cached
            ;;
        settings)
            shift
            cmd_webui settings "$@"
            ;;
        webui)
            shift
            cmd_webui webui "$@"
            ;;
        about)
            shift
            cmd_about "$@"
            ;;
        config)
            config_menu
            ;;
        -c|--continue)
            cmd_continue
            ;;
        -v|--version)
            echo "cccc version $VERSION"
            ;;
        -h|--help|help)
            cat << 'EOF'
Claude Code Control Center (cccc) - Interactive tmux + Claude Code Dashboard

USAGE:
    cccc                        Start interactive dashboard
    cccc -c                     Continue last Claude session in current directory
    cccc add <name> <path>      Add project

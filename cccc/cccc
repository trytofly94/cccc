# Best-effort primary LAN IPv4 (macOS first, Linux fallback). Empty if unknown.
get_lan_ip() {
    local ip="" iface
    if command -v ipconfig >/dev/null 2>&1; then
        # macOS: resolve the default-route interface, then its IPv4.
        if command -v route >/dev/null 2>&1; then
            iface=$(route -n get default 2>/dev/null | awk '/interface:/{print $2; exit}')
            [ -n "$iface" ] && ip=$(ipconfig getifaddr "$iface" 2>/dev/null)
        fi
        [ -z "$ip" ] && ip=$(ipconfig getifaddr en0 2>/dev/null)
        [ -z "$ip" ] && ip=$(ipconfig getifaddr en1 2>/dev/null)
    fi
    # Linux fallback.
    if [ -z "$ip" ] && command -v hostname >/dev/null 2>&1; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi
    printf '%s' "$ip"
}

# If a `cc-webui.py` server (started via `cccc settings` or `cccc webui`) is
# running, print the URL it is ACTUALLY reachable at. Returns 1 (no output)
# when no server is detected. Zero cost when not running: pgrep short-
# circuits before the (slower) lsof call.
#
# NOTE (T-15-info, known limitation): if a local `cccc settings` server and a
# LAN `cccc webui` server are both running at once, pgrep's pid ordering is
# not guaranteed, so this loop reports whichever one it finds first — the
# single status line below cannot disambiguate the two. Acceptable for now;
# revisit only if it becomes a real complaint.
get_webui_url() {
    local pids pid port="" addr="" name_field ip
    pids=$(pgrep -f "cc-webui\.py" 2>/dev/null) || return 1
    [ -z "$pids" ] && return 1
    for pid in $pids; do
        # -a is REQUIRED: without it lsof ORs -p and -i and returns every
        # listening socket on the box. With -a the filters are ANDed to this
        # pid's listening TCP sockets only. The NAME column ($9) carries the
        # bind ADDRESS as well as the port (e.g. "127.0.0.1:8787" for a
        # local-only bind vs "*:8787"/"0.0.0.0:8787"/"[::]:8787" for
        # all-interfaces) — capture both, not just the port.
        name_field=$(lsof -nP -a -p "$pid" -iTCP -sTCP:LISTEN 2>/dev/null \
            | awk 'NR>1 {print $9; exit}')
        [ -z "$name_field" ] && continue
        port="${name_field##*:}"
        addr="${name_field%:*}"
        [ -n "$port" ] && break
    done
    [ -z "$port" ] && return 1
    case "$addr" in
        '*'|0.0.0.0|::|'[::]')
            # All-interfaces bind (the `cccc webui` / `--lan` case) — mirrors
            # cc-webui.py's own reachable_urls() logic: resolve a
            # LAN-reachable display host.
            ip=$(get_lan_ip)
            [ -z "$ip" ] && ip="127.0.0.1"
            ;;
        *)
            # Local-only bind (the `cccc settings` default) — the server is
            # not listening on any LAN interface, so show the literal bound
            # address instead of substituting a LAN IP it can't reach.
            ip="$addr"
            ;;
    esac
    printf 'http://%s:%s' "$ip" "$port"
}

# Show dashboard
# Resolve a CATEGORY's color into _PFG (title/name foreground escape) and _PCHIP
# (reverse-video chip escape), via bash dynamic scope. Auto-assigns a hue by
# 1-based category order, unless $_group_color_map (groupname|colorname lines,
# loaded once by show_dashboard from group-colors.conf) overrides it. Fork-free.
resolve_group_color() {
    local name="$1" counter="$2" idx="" cn="" i
    if [ -n "${_group_color_map:-}" ]; then
        while IFS='|' read -r _k _v; do
            [ "$_k" = "$name" ] && { cn="$_v"; break; }
        done <<< "$_group_color_map"
    fi
    if [ -n "$cn" ]; then
        for i in "${!PROJ_COLOR_NAMES[@]}"; do
            [ "${PROJ_COLOR_NAMES[$i]}" = "$cn" ] && { idx="$i"; break; }
        done
    fi
    [ -z "$idx" ] && idx=$(( (counter - 1) % ${#PROJ_COLOR_NAMES[@]} ))
    _PFG="${PROJ_FG[$idx]}"
    _PCHIP="${PROJ_CHIP[$idx]}"
}

# Compose a full-terminal-width section divider "──[ Name ]──…──" into _DIV so
# every section rule ends at the same right edge regardless of name length.
# Width from $_cols (tput cols, set by show_dashboard; 80 fallback). Only the
# visible glyph count is used to size the trailing rule — ANSI never counts.
dc_divider() {
    local indent="$1" name="$2" namecolor="${3:-$DC_TEXT}"
    # visible cols before the trailing rule: indent + "──[" + " " + name + " " + "]"
    local used=$(( ${#indent} + 3 + 1 + ${#name} + 1 + 1 ))
    local fill=$(( ${_cols:-80} - used ))
    (( fill < 3 )) && fill=3
    local dashes="" i
    for (( i = 0; i < fill; i++ )); do dashes+="─"; done
    # \033[4m underlines the category name only (the NC after it clears the
    # underline before the trailing "]" and rule).
    printf -v _DIV '%s%b──[%b %b\033[4m%s%b %b]%s%b' \
        "$indent" "$DC_MUTE" "$NC" "$namecolor" "$name" "$NC" "$DC_MUTE" "$dashes" "$NC"
}

# Compose ONE session row and print it directly to stdout (progressive render).
# Bumps $waiting_count (a caller local, reached via bash dynamic scope) for any
# row that needs the user's attention. This is the single seam shared
# by the grouped project sessions and the Free section so both render
# identically (DASH-03/04).
#
# Args: <indent> <connector> <number> <display_name> <attached> <windows>
#       <session_name> <session_path> [<extra>]
# <extra> is appended verbatim (already carrying real ANSI) — used by Free rows
# to show the path + (C) marker.
render_session_row() {
    local indent="$1" connector="$2" num="$3" dname="$4" ppid="$5" pcmd="$6" windows="$7" sname="$8" spath="$9" extra="${10:-}"
    local status glyph label scolor

    # Asleep detection from the row's BATCH pane data (pid + foreground command
    # already fetched by get_tmux_sessions_meta) — no per-row tmux fork. Uses
    # the same _pane_data_is_asleep test that detect_session_status's Layer 0
    # uses for cc json, so the dashboard and cc json classify identically. When
    # not asleep, delegate to the full status detector (which re-checks asleep
    # cheaply, but we already know it isn't, so we pass no extra work).
    if _pane_data_is_asleep "$ppid" "$pcmd"; then
        status="asleep"
    else
        status=$(detect_session_status "$sname" awake)
    fi

    case "$status" in
        working)  glyph="▸";  label="working"; scolor="$DC_CYAN" ;;
        waiting)  glyph="●";  label="waiting"; scolor="$DC_YELLOW" ;;
        asleep)   glyph="💤"; label="asleep";  scolor="$DC_DETACH" ;;
        *)        glyph="○";  label="idle";    scolor="$DC_MUTE" ;;
    esac

    # Yellow ► attention gutter + yellow name for waiting rows; two blanks
    # otherwise (keeps the tree connectors aligned).
    local gutter="  " gcolor="$NC" ncolor="$DC_TEXT"
    if [ "$status" = "waiting" ]; then
        gutter="► "; gcolor="$DC_YELLOW"; ncolor="$DC_YELLOW"
        waiting_count=$((waiting_count + 1))
    fi

    # Badges (each already carries real ANSI from its printf-based helper).
    local watcher_marker=""
    echo "$_active_watchers" | grep -qxF "limit-watcher-${sname}" && watcher_marker=" ${ICON_WATCHING}"
    local backend_badge trust_marker="" gsd_status=""
    backend_badge=$(get_backend_badge "$sname")
    # An asleep session has no claude process, so it cannot be sitting at a
    # trust dialog — skip that capture-pane entirely (big win when many
    # sessions are asleep, and it keeps those rows painting instantly).
    [ "$status" != "asleep" ] && trust_marker=$(get_trust_dialog_marker "$sname")
    if [[ "$sname" =~ -gsd$ ]] && declare -f cccc_hook_status_badge >/dev/null 2>&1; then
        gsd_status=$(cccc_hook_status_badge "$spath")
    fi

    local _row
    printf -v _row '%s%b%s%b%b%s%b %b%2d%b  %b%-18s%b %b%s %-9s%b %b[%s win]%b%s%s%s%s%s' \
        "$indent" \
        "$gcolor" "$gutter" "$NC" \
        "$DC_MUTE" "$connector" "$NC" \
        "$DC_MUTE" "$num" "$NC" \
        "$ncolor" "$dname" "$NC" \
        "$scolor" "$glyph" "$label" "$NC" \
        "$DC_DIM" "$windows" "$NC" \
        "$watcher_marker" "$backend_badge" "$gsd_status" "$trust_marker" "$extra"
    printf '%s\n' "$_row"
}

show_dashboard() {
    clear

    # CLEANUP-03/04: sweep any orphaned limit-watcher-* sessions once per
    # dashboard render — replaces the retired watcher-cleanup launchd daemon.
    sweep_orphaned_watchers

    # Resolve the Settings web-UI URL once — it is rendered in the header row,
    # which is printed AFTER the body is buffered so it can carry the live
    # "N waiting" badge (DASH-02). Nothing prints here.
    local _webui_url
    _webui_url=$(get_webui_url)

    # Collect active limit-watcher session names ONCE as a newline-separated string.
    # bash 3.2 compatible (no declare -A needed). Lookup via grep -qF.
    local _active_watchers
    _active_watchers=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^limit-watcher-" || true)

    # Arrays for mapping
    declare -a project_letters
    declare -a project_paths
    declare -a project_titles

    declare -a session_numbers
    declare -a session_names
    declare -a session_paths
    declare -a session_project_letters

    local project_counter=1
    local session_counter=1
    local has_projects=false

    # Progressive render: every dashboard line is printed the moment it is
    # computed (fast first paint, builds up row by row). waiting_count is
    # tallied along the way and shown in the "N waiting" summary at the BOTTOM,
    # where the count is known — the top header prints immediately, before the
    # per-session status scans, so it can't carry the count.
    local waiting_count=0
    local g_proj_indent="" g_sess_indent=""

    # Terminal width for full-width section dividers; per-category color overrides.
    local _cols; _cols=$(tput cols 2>/dev/null); [[ "$_cols" =~ ^[0-9]+$ ]] || _cols=80
    local _group_color_map=""
    [ -f "$GROUP_COLORS_FILE" ] && _group_color_map=$(grep -vE '^[[:space:]]*(#|$)' "$GROUP_COLORS_FILE" 2>/dev/null)
    local _DIV _PFG _PCHIP
    local group_counter=0
    # Category color applied to every project under the current [Group] header.
    # Projects before any header (rare) stay neutral: cyan chip + white title.
    local g_pfg="$DC_TEXT" g_pchip="$DC_CHIP"

    # Header row — printed immediately so the dashboard has an instant first paint.
    if [ -n "$_webui_url" ]; then
        printf '%bcccc %s%b    %b⚙ settings%b %b%s%b\n' \
            "$DC_MUTE" "$VERSION" "$NC" "$DC_GREEN" "$NC" "$DC_MUTE" "$_webui_url" "$NC"
    else
        printf '%bcccc %s%b    %b⚙ settings — type '\''cccc settings'\''%b\n' \
            "$DC_MUTE" "$VERSION" "$NC" "$DC_DIM" "$NC"
    fi

    # === PROJECTS (grouped by [Section] headers) ===
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip empty lines and comments
        [ -z "$line" ] && continue
        [[ "$line" =~ ^# ]] && continue

        # Group header: [GroupName] or [Group/SubGroup] → ──[ Name ]── divider.
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            local group_path="${BASH_REMATCH[1]}"
            local group_depth=$(( $(printf '%s' "$group_path" | tr -cd '/' | wc -c) ))
            local group_name="${group_path##*/}"
            local header_indent=""
            local _gi
            for ((_gi=0; _gi<group_depth; _gi++)); do header_indent+="  "; done
            g_proj_indent="$header_indent"
            g_sess_indent="$header_indent"
            group_counter=$((group_counter + 1))
            resolve_group_color "$group_path" "$group_counter"
            g_pfg="$_PFG"; g_pchip="$_PCHIP"
            echo
            dc_divider "$header_indent" "$group_name" "$g_pfg"
            printf '%s\n' "$_DIV"
            continue
        fi

        # Project line
        local title path
        IFS='|' read -r title path <<< "$line"
        [ -z "$title" ] || [ -z "$path" ] && continue
        has_projects=true

        local letter
        letter=$(num_to_letter $project_counter)
        project_letters+=("$letter")
        project_paths+=("$path")
        project_titles+=("$title")

        local short_path
        short_path=$(shorten_path "$path" 1)

        # Project header row: the CATEGORY's reverse-video letter chip + same-hue
        # title + muted path. Every project under a category shares its color;
        # the neutral session names nested below read distinctly against it.
        local _pr
        printf -v _pr '%s%b %s %b %b%-26s%b %b%s%b' \
            "$g_proj_indent" "$g_pchip" "$letter" "$NC" "$g_pfg" "$title" "$NC" "$DC_MUTE" "$short_path" "$NC"
        printf '%s\n' "$_pr"

        # Collect this project's user-facing sessions FIRST so the tree
        # connectors (├─ / └─) know which row is last. The meta query carries
        # the active pane pid + foreground command so render_session_row can
        # tell a live claude apart from a dormant (reclaimed/quit) session.
        local -a p_snames=() p_spids=() p_spcmd=() p_swindows=()
        while IFS='|' read -r sess_name sess_path sess_attached sess_windows sess_pid sess_pcmd; do
            if [ "$sess_path" = "$path" ]; then
                # Skip daemon sessions — not user-facing.
                [[ "$sess_name" =~ -gsd-[0-9]+$ ]] && continue
                [[ "$sess_name" =~ ^limit-watcher- ]] && continue
                [[ "$sess_name" =~ ^conductor- ]] && continue
                p_snames+=("$sess_name")
                p_spids+=("$sess_pid")
                p_spcmd+=("$sess_pcmd")
                p_swindows+=("$sess_windows")
            fi
        done < <(get_tmux_sessions_meta)

        if [ "${#p_snames[@]}" -eq 0 ]; then
            local _ns
            printf -v _ns '%s  %b└─ ⚫ no sessions%b' "$g_sess_indent" "$DC_DIM" "$NC"
            printf '%s\n' "$_ns"
        else
            local _si sess_name sess_pid sess_pcmd sess_windows connector display_name
            for _si in "${!p_snames[@]}"; do
                sess_name="${p_snames[$_si]}"
                sess_pid="${p_spids[$_si]}"
                sess_pcmd="${p_spcmd[$_si]}"
                sess_windows="${p_swindows[$_si]}"

                connector="├─"
                [ "$_si" -eq $(( ${#p_snames[@]} - 1 )) ] && connector="└─"

                # Strip cc- prefix, then the project-title prefix if present.
                display_name="$sess_name"
                if [[ "$sess_name" =~ ^cc- ]]; then
                    display_name="${sess_name#cc-}"
                    [[ "$display_name" == "${title}-"* ]] && display_name="${display_name#${title}-}"
                fi

                # Store session mapping (consumed by the input handler).
                session_numbers+=("$session_counter")
                session_names+=("$sess_name")
                session_paths+=("$path")
                session_project_letters+=("$letter")

                render_session_row "$g_sess_indent" "$connector" "$session_counter" \
                    "$display_name" "$sess_pid" "$sess_pcmd" "$sess_windows" "$sess_name" "$path"

                ((session_counter++))

                # GSD worker sub-rows under a conductor (sessions ending in -gsd
                # but NOT -gsd-N). Both helpers are declare -f-gated so this is a
                # clean no-op without the private GSD companion plugin (PLUG-03).
                if [[ "$sess_name" =~ -gsd$ ]] && [[ ! "$sess_name" =~ -gsd-[0-9]+$ ]] && declare -f cccc_hook_status_badge >/dev/null 2>&1 && declare -f get_gsd_workers >/dev/null 2>&1; then
                    local workers_output
                    workers_output=$(get_gsd_workers "$sess_name")
                    if [[ -n "$workers_output" ]]; then
                        while IFS='|' read -r w_name _w_path w_attached w_windows; do
                            [[ -z "$w_name" ]] && continue
                            # From "cc-myproject-gsd-1" derive "gsd-1".
                            local w_short_name="${w_name##*cc-}"
                            w_short_name="${w_short_name##*-gsd-}"
                            w_short_name="gsd-${w_short_name}"
                            local w_glyph="▸" w_label="working" w_color="$DC_CYAN"
                            if [ "$w_attached" != "1" ]; then w_glyph="⏸"; w_label="detached"; w_color="$DC_DETACH"; fi
                            local _wr
                            printf -v _wr '%s      %b└─%b %b%-12s%b %b%s %-9s%b %b[%s win]%b' \
                                "$g_sess_indent" "$DC_MUTE" "$NC" "$DC_DETACH" "$w_short_name" "$NC" \
                                "$w_color" "$w_glyph" "$w_label" "$NC" "$DC_DIM" "$w_windows" "$NC"
                            printf '%s\n' "$_wr"
                        done <<< "$workers_output"
                    fi
                fi
            done
        fi

        ((project_counter++))
    done < <(cat "$PROJECTS_FILE" 2>/dev/null)

    # No projects configured
    if [ "$has_projects" = false ]; then
        local _np1 _np2
        printf -v _np1 '  %bNo projects configured.%b' "$DC_MUTE" "$NC"
        printf -v _np2 '  %bAdd with:%b %bcccc add <name> <path>%b' "$DC_MUTE" "$NC" "$DC_YELLOW" "$NC"
        printf '%s\n' "$_np1" "$_np2"
    fi

    # === FREE SESSIONS ===
    local configured_paths=("${project_paths[@]}")

    # Collect all tmux sessions not belonging to projects
    local free_sessions=()
    while IFS='|' read -r sess_name sess_path sess_attached sess_windows sess_pid sess_pcmd; do
        # Skip daemon sessions — not user-facing
        [[ "$sess_name" =~ -gsd-[0-9]+$ ]] && continue
        [[ "$sess_name" =~ ^limit-watcher- ]] && continue
        [[ "$sess_name" =~ ^conductor- ]] && continue

        local is_project=false
        for ppath in "${configured_paths[@]}"; do
            if [ "$sess_path" = "$ppath" ]; then
                is_project=true
                break
            fi
        done

        if [ "$is_project" = false ]; then
            free_sessions+=("$sess_name|$sess_path|$sess_attached|$sess_windows|$sess_pid|$sess_pcmd")
        fi
    done < <(get_tmux_sessions_meta)

    # Show free sessions under a ──[ Free ]── divider, rendered by the shared
    # row helper so status/badges match the grouped project sessions exactly.
    if [ "${#free_sessions[@]}" -gt 0 ]; then
        echo
        dc_divider "" "Free"
        printf '%s\n' "$_DIV"

        local _fi free_sess sess_name sess_path sess_attached sess_windows sess_pid sess_pcmd connector short_path extra
        for _fi in "${!free_sessions[@]}"; do
            free_sess="${free_sessions[$_fi]}"
            IFS='|' read -r sess_name sess_path sess_attached sess_windows sess_pid sess_pcmd <<< "$free_sess"

            connector="├─"
            [ "$_fi" -eq $(( ${#free_sessions[@]} - 1 )) ] && connector="└─"

            # Free rows show the working dir + a (C) marker for Claude projects.
            short_path=$(shorten_path "$sess_path" 1)
            printf -v extra ' %b%s%b' "$DC_DIM" "$short_path" "$NC"
            if is_claude_project "$sess_path"; then
                local _c
                printf -v _c ' %b(C)%b' "$DC_BLUE" "$NC"
                extra+="$_c"
            fi

            # Store session mapping
            session_numbers+=("$session_counter")
            session_names+=("$sess_name")
            session_paths+=("$sess_path")
            session_project_letters+=("")

            render_session_row "" "$connector" "$session_counter" \
                "$sess_name" "$sess_pid" "$sess_pcmd" "$sess_windows" "$sess_name" "$sess_path" "$extra"

            ((session_counter++))
        done
    fi

    # ---- legend (with the "N waiting" summary, now that the count is known),
    #      hints + prompt ------------------------------------------------------
    echo
    local _wsum=""
    [ "$waiting_count" -gt 0 ] && printf -v _wsum '%b %d waiting %b · ' "$DC_BADGE" "$waiting_count" "$NC"
    printf '%s%b▸ working%b · %b● waiting%b (needs you) · %b○ idle%b · %b💤 asleep%b (resumable) · %b⚫ stopped%b · %b🔍 watcher%b\n' \
        "$_wsum" "$DC_CYAN" "$NC" "$DC_YELLOW" "$NC" "$DC_MUTE" "$NC" "$DC_DETACH" "$NC" "$DC_DIM" "$NC" "$DC_MUTE" "$NC"
    printf '%bNumber%b → open session · +k kill      %bLetter%b → open project · +n new session%b\n' \
        "$DC_TEXT" "$DC_DIM" "$DC_TEXT" "$DC_DIM" "$NC"
    printf '%bCommands: help · q · limit · recover · config%b\n' "$DC_MUTE" "$NC"
    printf '%b❯%b ' "$DC_CYAN" "$NC"

    # Export arrays for later access (with newlines as separator for paths with spaces)
    local _cc_project_letters _cc_project_paths _cc_project_titles _cc_session_numbers _cc_session_names _cc_session_paths _cc_session_project_letters
    _cc_project_letters="$(printf '%s\n' "${project_letters[@]}")"
    _cc_project_paths="$(printf '%s\n' "${project_paths[@]}")"
    _cc_project_titles="$(printf '%s\n' "${project_titles[@]}")"
    _cc_session_numbers="$(printf '%s\n' "${session_numbers[@]}")"
    _cc_session_names="$(printf '%s\n' "${session_names[@]}")"
    _cc_session_paths="$(printf '%s\n' "${session_paths[@]}")"
    _cc_session_project_letters="$(printf '%s\n' "${session_project_letters[@]}")"
    export CC_PROJECT_LETTERS="$_cc_project_letters"
    export CC_PROJECT_PATHS="$_cc_project_paths"
    export CC_PROJECT_TITLES="$_cc_project_titles"
    export CC_SESSION_NUMBERS="$_cc_session_numbers"
    export CC_SESSION_NAMES="$_cc_session_names"
    export CC_SESSION_PATHS="$_cc_session_paths"
    export CC_SESSION_PROJECT_LETTERS="$_cc_session_project_letters"
}

# ============================================================================
# RECOVERY MODE
# ============================================================================

# recovery_mode() — full-screen view listing closed Claude Code sessions.
# Called on-demand from interactive_mode when user types "recover".
# Renders header + two-line per-entry list, handles empty state (D-08),
# and resumes a chosen session via start_claude_session + --resume (REC-03).
recovery_mode() {
    # WR-02: declare all rec_* arrays as local to avoid polluting global scope.
    local rec_ids=() rec_paths=() rec_names=() rec_summaries=() rec_mtimes=() rec_fpaths=()

    # D-09: loading indicator — show before the O(N×jq) scan.
    clear
    echo -e "${GRAY}Scanning sessions...${NC}"
    load_recoverable_sessions

    # Parse all CC_RECOVERABLE_* exports into local arrays.
    # CONCERN-3: each export ends with a trailing '\n' (printf '%s\n' in cc/cc:311-315).
    # The non-empty guard [ -n "$line" ] prevents the trailing newline from appending
    # a spurious empty element to each array.
    while IFS= read -r line; do [ -n "$line" ] && rec_ids+=("$line"); done <<< "$CC_RECOVERABLE_IDS"
    while IFS= read -r line; do [ -n "$line" ] && rec_paths+=("$line"); done <<< "$CC_RECOVERABLE_PATHS"
    while IFS= read -r line; do [ -n "$line" ] && rec_names+=("$line"); done <<< "$CC_RECOVERABLE_NAMES"
    while IFS= read -r line; do [ -n "$line" ] && rec_summaries+=("$line"); done <<< "$CC_RECOVERABLE_SUMMARIES"
    while IFS= read -r line; do [ -n "$line" ] && rec_mtimes+=("$line"); done <<< "$CC_RECOVERABLE_MTIMES"
    while IFS= read -r line; do [ -n "$line" ] && rec_fpaths+=("$line"); done <<< "$CC_RECOVERABLE_FPATHS"

    # CONCERN-1: multi-line summaries break index alignment.
    # If the parsed summary count doesn't match the session count, fall back to
    # "(no summary)" for all rows — this guarantees session_id↔name↔mtime alignment
    # is never broken by summary content (T-06-07 mitigation).
    if [[ ${#rec_summaries[@]} -ne ${#rec_ids[@]} ]]; then
        rec_summaries=()
        local _fallback_i
        for _fallback_i in "${!rec_ids[@]}"; do
            rec_summaries+=("(no summary)")
        done
    fi

    # CR-02: guard rec_paths, rec_names, rec_mtimes against misalignment.
    # Unlike summaries (display-only), wrong paths would cause silent wrong-session
    # resume — so we abort rather than provide a best-effort fallback.
    if [[ ${#rec_paths[@]}  -ne ${#rec_ids[@]} ]] || \
       [[ ${#rec_names[@]}  -ne ${#rec_ids[@]} ]] || \
       [[ ${#rec_mtimes[@]} -ne ${#rec_ids[@]} ]]; then
        echo -e "${RED}✗ Session data corrupted (array length mismatch). Try again.${NC}"
        sleep 3
        return
    fi

    # D-08: empty state — nothing to show, return to dashboard after sleep 2.
    if [[ ${#rec_ids[@]} -eq 0 ]]; then
        echo -e "${GRAY}No recoverable sessions found.${NC}"
        sleep 2
        return
    fi

    # Render + input loop (mirrors interactive_mode structure: render → read → handle).
    while true; do
        clear
        echo -e "${WHITE}  🔄 RECOVERABLE SESSIONS${NC}"
        echo -e "${GRAY}  ──────────────────────────${NC}"

        # Collect active session paths once for live-session indicator.
        local _live_paths
        _live_paths=$(tmux list-sessions -F "#{session_path}" 2>/dev/null || true)

        # Iterate by INDEX over rec_ids (canonical row count) — rec_summaries count
        # is guaranteed to match after the CONCERN-1 guard above.
        local i
        for i in "${!rec_ids[@]}"; do
            local n=$(( i + 1 ))
            local time_ago
            time_ago=$(format_time_ago "${rec_mtimes[$i]}")

            # D-07: first-line extract + 60-char truncation.
            local summary_line="${rec_summaries[$i]%%$'\n'*}"
            if [[ -z "$summary_line" ]]; then
                summary_line="(no summary)"
            fi
            if [[ ${#summary_line} -gt 60 ]]; then
                summary_line="${summary_line:0:60}..."
            fi

            # Active-session indicator: [live] badge when project has running tmux session.
            local live_badge=""
            printf '%s\n' "$_live_paths" | grep -qxF "${rec_paths[$i]}" && live_badge=" ${YELLOW}[live]${NC}"

            # Short session ID suffix (last 8 chars) for distinguishing same-project sessions.
            local sid_short="${rec_ids[$i]}"
            sid_short="${sid_short: -8}"

            # Two-line per-entry format (D-05).
            printf "  ${CYAN}%2d  %-20s${NC}${live_badge}  ${GRAY}…%s  (%s)${NC}\n" "$n" "${rec_names[$i]}" "$sid_short" "$time_ago"
            printf "     ${GRAY}%s${NC}\n" "$summary_line"
        done

        echo ""
        echo -e "${GRAY}  q  Return to dashboard  │  <number>  Resume session${NC}"

        # EOF (closed stdin) must exit the loop, not spin re-rendering forever.
        read -e -r choice || return

        # Filter ANSI cursor-key escape sequences (same as interactive_mode).
        choice=$(printf '%s' "$choice" | sed $'s/\033\\[[ABCD]//g' | tr -d '\033')

        # q / Q — return to main dashboard.
        if [[ "$choice" == "q" ]] || [[ "$choice" == "Q" ]]; then
            return
        fi

        # T-06-04 / CONCERN-3: bounds check — validate numeric and within 1..${#rec_ids[@]}.
        # ${#rec_ids[@]} is the true count (trailing-newline empty element excluded above).
        if [[ "$choice" =~ ^[0-9]+$ ]] && \
           [[ "$choice" -ge 1 ]] && \
           [[ "$choice" -le ${#rec_ids[@]} ]]; then

            local idx=$(( choice - 1 ))
            local session_id="${rec_ids[$idx]}"
            local proj_path="${rec_paths[$idx]}"
            local proj_name="${rec_names[$idx]}"
            local rec_fpath="${rec_fpaths[$idx]:-}"

            # CR-01: whitelist-validate session_id before embedding in tmux send-keys.
            # Session IDs must be UUID-like (hex digits + hyphens only). Any other
            # character (especially shell metacharacters) is rejected to prevent injection.
            if [[ ! "$session_id" =~ ^[0-9a-fA-F-]+$ ]]; then
                echo -e "${RED}✗ Invalid session ID format — cannot recover${NC}"
                sleep 2
                continue
            fi

            # D-03 dedup — CONCERN-2: sanitize BEFORE the loop so candidate matches
            # the actual tmux name that start_claude_session creates internally (cc/cc:619).
            local base_name
            base_name="cc-$(sanitize_session_name "$proj_name")"
            # WR-03: guard against empty sanitized name (project names consisting entirely
            # of stripped characters would produce "cc-", causing potential tmux prefix
            # matching issues and a loop that never exits).
            if [[ "$base_name" == "cc-" ]]; then
                base_name="cc-recovered"
            fi
            local candidate="$base_name"
            local suffix=2
            while tmux has-session -t "=$candidate" 2>/dev/null; do
                candidate="${base_name}-${suffix}"
                (( suffix++ ))
            done

            # REC-04: detect backend from JSONL model field (for alternative-backend sessions).
            # Gated: detect_session_backend is a backends.sh plugin-internal helper; with
            # no backends plugin present, detected_backend stays empty (plain recover).
            local detected_backend=""
            if [[ -n "$rec_fpath" ]] && declare -f detect_session_backend >/dev/null 2>&1; then
                detected_backend=$(detect_session_backend "$rec_fpath")
            fi
            local backend_note=""
            [[ -n "$detected_backend" ]] && backend_note=" [=${detected_backend}]"

            # REC-03 / D-04: resume session.
            echo -e "${CYAN}⚡ Recovering session in '${proj_name}'${backend_note}...${NC}"
            start_claude_session "$candidate" "$proj_path" "--resume ${session_id}" "$detected_backend" || return
            sleep 1
            attach_session "$candidate"
            return
        fi

        # Invalid input — show error, re-render on next loop iteration.
        echo -e "${RED}✗ Invalid input: '$choice'${NC}"
        sleep 2
    done
}

# ============================================================================
# IDLE WATCHDOG SYNC (opt-in, default-off — v4.0 final feature step)
# ============================================================================
# The idle-watchdog (system/bin/claude-idle-watchdog, macOS-only) reclaims RAM
# from idle/detached `cc-*` tmux sessions via `kill -TERM` of the claude
# process — never kill-session, never key-injection, tmux pane/scrollback
# survive, and `claude --resume <session-id>` (NOT --continue) picks the
# session back up. It is an ENTIRELY SEPARATE artifact from cccc itself
# (installed to ~/.local/bin + ~/Library/LaunchAgents by system/restore.sh
# today; a future public installer step, per .planning/cccc-public-release-brief.md
# #8, vendors it but — like this function — NEVER auto-loads it). cccc's own
# job is limited to ONE thing: keeping the launchd job's loaded/unloaded state
# in sync with the CC_SET_IDLE_WATCHDOG value, and ONLY when a human explicitly
# triggers it (config_menu option 10, or once at interactive dashboard
# startup) — never from `cccc list`/`cccc json`/`cccc new`/any scripted path,
# so an automation polling those commands can never cause a launchd load.
#
# Every real launchctl call is routed through _idle_watchdog_launchctl() so
# tests can redefine that one function and assert on intended bootstrap/
# bootout calls without ever touching the real gui/<uid>/... launchd
# namespace (bash allows redefining a function after it's been sourced).
# IDLE_WATCHDOG_LABEL/IDLE_WATCHDOG_PLIST are defined near CONFIG_DIR at the
# top of this file.

_idle_watchdog_launchctl() {
    launchctl "$@"
}

# sync_idle_watchdog — reconcile the idle-watchdog launchd job with
# CC_SET_IDLE_WATCHDOG. Deliberately conservative: a no-op (silent, exit 0)
# unless BOTH of the following hold, so this can never be the thing that
# starts reclaiming sessions on a machine that never asked for it:
#   1. Platform is macOS (`uname -s` == Darwin) — the daemon itself uses
#      macOS-only APIs (memory_pressure, kern.memorystatus_vm_pressure_level).
#   2. The plist is ALREADY installed at IDLE_WATCHDOG_PLIST — sync_idle_watchdog()
#      never creates/vendors it; that is system/restore.sh's (or a future
#      installer's) job. If nothing installed the daemon, this setting stays
#      purely declarative until something does.
# When both hold: "on" -> bootout (ignore already-not-loaded error) + bootstrap
# (idempotent reload, same pattern as system/restore.sh); "off" -> bootout
# (ignore already-not-loaded error). Never called automatically by sourcing
# cccc/cccc (CC_TEST=1 never runs main(), so interactive_mode()'s one call
# site never fires under test) — the ONLY call sites are config_menu option 10
# and interactive_mode() startup, both exclusively human-interactive. A
# dedicated test therefore calls this function directly with
# CC_LAUNCH_AGENTS_DIR pointed at a temp dir (so gate 2 is test-controlled)
# and _idle_watchdog_launchctl redefined to a recording stub (so gate-passing
# calls never reach a real launchctl).
sync_idle_watchdog() {
    [[ "$(uname -s 2>/dev/null)" == "Darwin" ]] || return 0
    [[ -f "$IDLE_WATCHDOG_PLIST" ]] || return 0

    local uid_num
    uid_num="$(id -u)"

    if [[ "${CC_SET_IDLE_WATCHDOG:-off}" == "on" ]]; then
        _idle_watchdog_launchctl bootout "gui/$uid_num/$IDLE_WATCHDOG_LABEL" 2>/dev/null || true
        _idle_watchdog_launchctl bootstrap "gui/$uid_num" "$IDLE_WATCHDOG_PLIST" 2>/dev/null
    else
        _idle_watchdog_launchctl bootout "gui/$uid_num/$IDLE_WATCHDOG_LABEL" 2>/dev/null || true
    fi
}

# ============================================================================
# SETTINGS CONFIG MENU (SET-08)
# ============================================================================
# config_menu — dashboard-styled viewer/editor for every settings.conf key.
# Reachable via typing "config" in interactive_mode and as `cc config`.
# LIMIT_WATCHER (Phase 9) and AUTO_TRUST (Phase 10) are both fully wired —
# changing either here takes effect on the next relevant action (dashboard
# start / cc add / next session spawn respectively).

# Print a code-aware result message for a config_menu edit.
# Args: <write_setting exit code> <setting key name>
_config_menu_report_result() {
    local rc="$1" key="$2"
    case "$rc" in
        0) echo -e "${GREEN}✓ ${key} updated${NC}" ;;
        1) echo -e "${RED}✗ Invalid value for ${key} — not saved${NC}" ;;
        2) echo -e "${RED}✗ Could not write settings file${NC}" ;;
        *) echo -e "${RED}✗ Unexpected error saving ${key}${NC}" ;;
    esac
    sleep 1
}

config_menu() {
    while true; do
        load_settings
        clear
        echo -e "${WHITE}  ⚙ SETTINGS${NC}"
        echo -e "${GRAY}  ──────────────────────────${NC}"
        echo ""

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 1 "PERMISSION_MODE" "$CC_SET_PERMISSION_MODE"
        printf "     ${GRAY}%s${NC}\n" "(default|acceptEdits|plan|auto|bypassPermissions)"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 9 "PERMISSION_MODE_FALLBACK" "$CC_SET_PERMISSION_MODE_FALLBACK"
        printf "     ${GRAY}%s${NC}\n" "(default|acceptEdits|plan|bypassPermissions — target when auto is unavailable)"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 2 "MODEL" "${CC_SET_MODEL:-(account default)}"
        printf "     ${GRAY}%s${NC}\n" "(free text — e.g. opus, sonnet; empty = account default)"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 3 "MEMORY_LIMIT_MB" "$CC_SET_MEMORY_LIMIT_MB"
        printf "     ${GRAY}%s${NC}\n" "(numeric — Node --max-old-space-size in MB)"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 4 "CLAUDE_BIN" "$CC_SET_CLAUDE_BIN"
        printf "     ${GRAY}%s${NC}\n" "(free text — path or command name; empty = 'claude')"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 5 "EXTRA_FLAGS" "${CC_SET_EXTRA_FLAGS:-(none)}"
        printf "     ${GRAY}%s${NC}\n" "(free text — extra flags appended to every launch)"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 6 "LIMIT_WATCHER" "$CC_SET_LIMIT_WATCHER"
        printf "     ${GRAY}%s${NC}\n" "(auto = every session, manual = on request, off = disabled)"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 7 "AUTO_TRUST" "$CC_SET_AUTO_TRUST"
        printf "     ${GRAY}%s${NC}\n" "(on-add|always|off)"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 8 "SHOW_LOGO" "$CC_SET_SHOW_LOGO"
        printf "     ${GRAY}%s${NC}\n" "(true|false — first-run wizard + 'cccc about' logo)"

        printf "  ${CYAN}%d  %-18s${NC} %s\n" 10 "IDLE_WATCHDOG" "$CC_SET_IDLE_WATCHDOG"
        printf "     ${GRAY}%s${NC}\n" "(off = disabled/default, on = opt-in RAM reclaim of idle sessions; macOS-only)"

        echo ""
        echo -e "${GRAY}  q  Return to dashboard  │  <number>  Change setting${NC}"

        local choice new_value
        read -e -r choice
        choice=$(printf '%s' "$choice" | sed $'s/\033\\[[ABCD]//g' | tr -d '\033')

        if [[ "$choice" == "q" ]] || [[ "$choice" == "Q" ]] || [[ -z "$choice" ]]; then
            return
        fi

        case "$choice" in
            1)
                echo ""
                echo -e "${GRAY}Allowed: default|acceptEdits|plan|auto|bypassPermissions${NC}"
                read -e -r -p "PERMISSION_MODE: " new_value
                write_setting PERMISSION_MODE "$new_value"
                _config_menu_report_result $? PERMISSION_MODE
                ;;
            2)
                read -e -r -p "MODEL (empty = account default): " new_value
                write_setting MODEL "$new_value"
                _config_menu_report_result $? MODEL
                ;;
            3)
                read -e -r -p "MEMORY_LIMIT_MB (numeric): " new_value
                write_setting MEMORY_LIMIT_MB "$new_value"
                _config_menu_report_result $? MEMORY_LIMIT_MB
                ;;
            4)
                read -e -r -p "CLAUDE_BIN (empty = 'claude'): " new_value
                # Non-blocking existence/executable check — a typo shouldn't hard-block
                # since a valid binary may be installed later, and CLAUDE_BIN is free
                # text by design. Empty (clearing to default) skips the check.
                if [[ -n "$new_value" ]] && ! { command -v "$new_value" >/dev/null 2>&1 || [[ -x "$new_value" ]]; }; then
                    echo -e "${YELLOW}warning: \"$new_value\" not found on PATH and not an executable file — saving anyway; sessions will fail to launch if this path is wrong${NC}"
                fi
                write_setting CLAUDE_BIN "$new_value"
                _config_menu_report_result $? CLAUDE_BIN
                ;;
            5)
                read -e -r -p "EXTRA_FLAGS (empty = none): " new_value
                write_setting EXTRA_FLAGS "$new_value"
                _config_menu_report_result $? EXTRA_FLAGS
                ;;
            6)
                echo ""
                echo -e "${GRAY}Allowed: auto (every session) | manual (on request) | off (disabled)${NC}"
                read -e -r -p "LIMIT_WATCHER: " new_value
                write_setting LIMIT_WATCHER "$new_value"
                _config_menu_report_result $? LIMIT_WATCHER
                ;;
            7)
                echo ""
                echo -e "${GRAY}Allowed: on-add|always|off${NC}"
                read -e -r -p "AUTO_TRUST: " new_value
                write_setting AUTO_TRUST "$new_value"
                _config_menu_report_result $? AUTO_TRUST
                ;;
            8)
                echo ""
                echo -e "${GRAY}Allowed: true|false${NC}"
                read -e -r -p "SHOW_LOGO: " new_value
                write_setting SHOW_LOGO "$new_value"
                _config_menu_report_result $? SHOW_LOGO
                ;;
            9)
                echo ""
                echo -e "${GRAY}Allowed: default|acceptEdits|plan|bypassPermissions${NC}"
                read -e -r -p "PERMISSION_MODE_FALLBACK: " new_value
                write_setting PERMISSION_MODE_FALLBACK "$new_value"
                _config_menu_report_result $? PERMISSION_MODE_FALLBACK
                ;;
            10)
                echo ""
                echo -e "${GRAY}Allowed: off (disabled/default) | on (enabled) — reclaims RAM from idle/detached sessions via SIGTERM${NC}"
                echo -e "${GRAY}(never kill-session); resume with 'claude --resume <session-id>', NOT${NC}"
                echo -e "${GRAY}--continue. macOS-only. Default off — never enable without reading${NC}"
                echo -e "${GRAY}system/README.md's Sharp Edges section first.${NC}"
                read -e -r -p "IDLE_WATCHDOG: " new_value
                local _idle_watchdog_write_rc
                write_setting IDLE_WATCHDOG "$new_value"
                _idle_watchdog_write_rc=$?
                _config_menu_report_result "$_idle_watchdog_write_rc" IDLE_WATCHDOG
                # Reconcile the (already-installed, if any) launchd job with the
                # new value right away, so "toggling the setting" is not a lie —
                # see sync_idle_watchdog()'s own comment for every safety gate.
                [[ "$_idle_watchdog_write_rc" -eq 0 ]] && sync_idle_watchdog
                ;;
            *)
                echo -e "${RED}✗ Invalid choice: '$choice'${NC}"
                sleep 2
                ;;
        esac
    done
}

# ============================================================================
# INTERACTIVE LOOP
# ============================================================================

# First-start wizard (PUB-05, D-08): when interactive_mode() starts and
# $PROJECTS_FILE is missing or has zero REAL project entries (e.g. it's the
# all-commented example file install.sh ships), offer to add one now before
# falling through to the normal (empty) dashboard. Called exactly ONCE, before
# the while-loop below — never inside it, so it does not re-prompt on every
# refresh. TTY-guarded FIRST, before any prompt, so non-interactive callers
# (SSH/redirected stdin, per this ecosystem's own tooling) fall straight
# through to the unchanged dashboard — same discipline as cmd_add()'s
# AUTO_TRUST on-add consent flow. Only cccc's interactive dashboard calls
# this; `cccc list`/`cccc json`/other subcommands never call
# interactive_mode() so they are unaffected.
first_start_wizard() {
    [[ -t 0 ]] || return 0

    # Count real entries using the SAME parse contract as the projects.conf
    # loop above (Analog B): skip blank lines, skip comments, skip group
    # headers, count only well-formed title|path lines.
    local real_entries=0
    if [ -f "$PROJECTS_FILE" ]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [ -z "$line" ] && continue
            [[ "$line" =~ ^# ]] && continue
            [[ "$line" =~ ^\[(.+)\]$ ]] && continue
            local wizard_title wizard_path_check
            IFS='|' read -r wizard_title wizard_path_check <<< "$line"
            { [ -z "$wizard_title" ] || [ -z "$wizard_path_check" ]; } && continue
            real_entries=$((real_entries + 1))
        done < "$PROJECTS_FILE"
    fi

    [ "$real_entries" -gt 0 ] && return 0

    clear
    # First-run logo (BRAND-02, D-05): only ever printed here and by
    # cmd_about() — never inside show_dashboard() or interactive_mode()'s
    # main loop (D-06). render_logo() self-suppresses on non-TTY stdout,
    # --no-logo, or SHOW_LOGO=false.
    render_logo
    echo -e "${CYAN}Welcome to cccc!${NC}"
    echo -e "${GRAY}No projects configured yet.${NC}"
    echo ""
    local wizard_answer
    read -e -r -p "Add a project now? [Y/n] " wizard_answer
    if [[ -n "$wizard_answer" && ! "$wizard_answer" =~ ^[Yy] ]]; then
        return 0
    fi

    local wizard_input_path
    read -e -r -p "Project path: " wizard_input_path
    wizard_input_path="${wizard_input_path/#\~/$HOME}"
    if [ -z "$wizard_input_path" ] || [ ! -d "$wizard_input_path" ]; then
        echo -e "${RED}✗ Path does not exist: $wizard_input_path${NC}"
        sleep 2
        return 0
    fi
    local wizard_abspath
    wizard_abspath=$(cd "$wizard_input_path" && pwd -P)
    local wizard_folder
    wizard_folder=$(basename "$wizard_abspath")

    local wizard_name
    read -e -r -p "Project name [${wizard_folder}]: " wizard_name
    wizard_name="${wizard_name:-$wizard_folder}"
    wizard_name="${wizard_name//|/}"  # strip | to prevent projects.conf corruption

    if project_exists "$wizard_name"; then
        echo -e "${RED}✗ Project '$wizard_name' already exists${NC}"
        sleep 2
        return 0
    fi

    ensure_config_dir
    if add_project_to_group "$wizard_name" "$wizard_abspath" ""; then
        echo -e "${GREEN}✓ Project '$wizard_name' added${NC}"
        sleep 1
    else
        echo -e "${RED}✗ Failed to add project${NC}"
        sleep 2
    fi
    return 0
}

interactive_mode() {
    first_start_wizard
    # One-time reconciliation of the idle-watchdog launchd job against
    # CC_SET_IDLE_WATCHDOG (e.g. picking up a change made via the web
    # Settings UI since the last time the terminal dashboard was opened) —
    # never inside the loop below, so it runs once per dashboard session,
    # not on every refresh. See sync_idle_watchdog()'s own comment for the
    # full set of safety gates (macOS-only, plist-must-already-exist, etc).
    sync_idle_watchdog
    while true; do
        show_dashboard

        # Use readline for line editing (arrows, backspace work)
        # Ctrl+U clears line, Ctrl+C cancels
        # EOF (closed stdin: `cccc </dev/null`, ssh-exec) MUST exit — otherwise
        # read returns empty + nonzero forever and the loop re-renders at full
        # speed, forking tmux per session (runaway CPU / fork storm).
        read -e -r choice || exit 0

        # Filter ANSI cursor-key escape sequences (ESC [ A/B/C/D) without stripping A-D from paths
        choice=$(printf '%s' "$choice" | sed $'s/\033\\[[ABCD]//g' | tr -d '\033')

        # Parse arrays (newline-separated values - supports paths with spaces, bash 3.2 compatible)
        project_letters=()
        while IFS= read -r line; do [ -n "$line" ] && project_letters+=("$line"); done <<< "$CC_PROJECT_LETTERS"
        project_paths=()
        while IFS= read -r line; do [ -n "$line" ] && project_paths+=("$line"); done <<< "$CC_PROJECT_PATHS"
        project_titles=()
        while IFS= read -r line; do [ -n "$line" ] && project_titles+=("$line"); done <<< "$CC_PROJECT_TITLES"
        session_numbers=()
        while IFS= read -r line; do [ -n "$line" ] && session_numbers+=("$line"); done <<< "$CC_SESSION_NUMBERS"
        session_names=()
        while IFS= read -r line; do [ -n "$line" ] && session_names+=("$line"); done <<< "$CC_SESSION_NAMES"
        session_paths=()
        while IFS= read -r line; do [ -n "$line" ] && session_paths+=("$line"); done <<< "$CC_SESSION_PATHS"
        session_project_letters=()
        while IFS= read -r line; do [ -n "$line" ] && session_project_letters+=("$line"); done <<< "$CC_SESSION_PROJECT_LETTERS"

        # Quit (only explicit q/Q)
        if [[ "$choice" == "q" ]] || [[ "$choice" == "Q" ]]; then
            clear
            echo -e "${GRAY}Goodbye!${NC}"
            exit 0
        fi

        # Refresh (r/R, Enter, or Escape clears and refreshes)
        if [[ "$choice" == "r" ]] || [[ "$choice" == "R" ]] || [[ -z "$choice" ]]; then
            continue
        fi

        # Add project: "add /path" or "add ~/path"
        if [[ "$choice" =~ ^add[[:space:]]+(.+)$ ]]; then
            local input_path="${BASH_REMATCH[1]}"

            # Expand ~ to $HOME
            input_path="${input_path/#\~/$HOME}"

            # Check if path exists
            if [ ! -d "$input_path" ]; then
                echo -e "${RED}✗ Path does not exist: $input_path${NC}"
                sleep 2
                continue
            fi

            # Get absolute path
            local new_path
            new_path=$(cd "$input_path" && pwd -P)
            local folder
            folder=$(basename "$new_path")

            clear
            echo -e "${CYAN}Add Project${NC}"
            echo -e "${GRAY}Path: ${new_path}${NC}"
            echo ""
            read -p "Project name [${folder}]: " proj_name

            proj_name="${proj_name:-$folder}"
            proj_name="${proj_name//|/}"  # strip | to prevent projects.conf corruption

            # Check if project already exists
            if project_exists "$proj_name"; then
                echo -e "${RED}✗ Project '$proj_name' already exists${NC}"
                sleep 2
                continue
            fi

            # Category picker: list the existing categories ([Section] headers)
            # each with a letter so you can pick one by letter instead of
            # retyping its name from memory. Type a new name to create a new
            # category, or leave empty for none.
            local proj_group=""
            local -a _cat_names=()
            if [ -f "$PROJECTS_FILE" ]; then
                local _cl
                while IFS= read -r _cl || [[ -n "$_cl" ]]; do
                    [[ "$_cl" =~ ^\[(.+)\]$ ]] && _cat_names+=("${BASH_REMATCH[1]}")
                done < "$PROJECTS_FILE"
            fi

            echo ""
            if [ "${#_cat_names[@]}" -gt 0 ]; then
                echo -e "${CYAN}Category:${NC}"
                local _ci _cletter
                for _ci in "${!_cat_names[@]}"; do

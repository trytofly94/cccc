# CC_TEST guard: when sourced for testing (CC_TEST=1 source cc/cc), every
# function above is defined but main() is NOT invoked — so no interactive
# dashboard is launched. Normal invocation (bash cc/cc) has CC_TEST unset and
# falls through to main "$@" unchanged. `return` only works when this script
# is sourced; when CC_TEST=1 is combined with direct execution (bash cc/cc,
# e.g. a plugin-loader smoke test), `return` fails ("can only return from a
# function or sourced script") — fall back to `exit 0` so the process still
# terminates cleanly without falling through to main() in either case.
if [[ -n "${CC_TEST:-}" ]]; then
    return 0 2>/dev/null || exit 0
fi
main "$@"

            local proj_path="${project_paths[$project_index]}"
            local proj_title="${project_titles[$project_index]}"

            # Find first session in this project
            local first_session=""
            for i in "${!session_project_letters[@]}"; do
                if [ "${session_project_letters[$i]}" = "$letter" ]; then
                    first_session="${session_names[$i]}"
                    break
                fi
            done

            # No session → Create new
            if [ -z "$first_session" ]; then
                local new_session_name
                new_session_name="cc-$(sanitize_session_name "${proj_title}")"
                echo ""
                echo -e "${YELLOW}⚡ Starting new session '${new_session_name}'...${NC}"
                start_claude_session "$new_session_name" "$proj_path" || continue
                maybe_start_limit_watcher "$new_session_name"
                sleep 1
                first_session="$new_session_name"
            fi

            clear
            attach_session "$first_session"
            continue
        fi

        # === NUMBER COMMANDS (Sessions) ===

        # Kill multiple sessions: "1,2,3k"
        if [[ "$choice" =~ ^([0-9]+(,[0-9]+)+)k$ ]]; then
            local nums_str="${BASH_REMATCH[1]}"
            local -a _mk_indices _mk_names
            _mk_indices=()
            _mk_names=()
            local _mk_invalid=false

            IFS=',' read -ra _mk_nums <<< "$nums_str"
            for _mk_num in "${_mk_nums[@]}"; do
                local _mk_idx=-1
                for i in "${!session_numbers[@]}"; do
                    if [ "${session_numbers[$i]}" = "$_mk_num" ]; then
                        _mk_idx=$i
                        break
                    fi
                done
                if [ "$_mk_idx" -eq -1 ]; then
                    echo -e "${RED}✗ Invalid session number: $_mk_num${NC}"
                    _mk_invalid=true
                    break
                fi
                _mk_indices+=("$_mk_idx")
                _mk_names+=("${session_names[$_mk_idx]}")
            done

            if ! $_mk_invalid; then
                echo ""
                echo -e "${YELLOW}⚠️  Kill ${#_mk_names[@]} sessions?${NC}"
                for _mk_n in "${_mk_names[@]}"; do
                    echo -e "   ${GRAY}• $_mk_n${NC}"
                done
                read -p "   Press 'k' to confirm: " confirm

                if [[ "$confirm" == "k" ]]; then
                    for _mk_n in "${_mk_names[@]}"; do
                        kill_session "$_mk_n"
